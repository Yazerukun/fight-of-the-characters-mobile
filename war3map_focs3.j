            call CreateTextTagLocBJ("TRIGSTR_10767", udg_AaBanPickTextL[GetForLoopIndexA()], 0, 10, 0.00, 0.00, 100, 0)
            set udg_AaBanPickText[GetForLoopIndexA()]=GetLastCreatedTextTag()
            call RemoveLocation(udg_AaBanPickTextL[GetForLoopIndexA()])
        else
            if ( Trig_text2_Func001Func001Func005C() ) then
                call DestroyTextTagBJ(udg_AaBanPickText[GetForLoopIndexA()])
                call CreateTextTagLocBJ("TRIGSTR_10768", udg_AaBanPickTextL[GetForLoopIndexA()], 0, 10, 100.00, 0.00, 0.00, 0)
                set udg_AaBanPickText[GetForLoopIndexA()]=GetLastCreatedTextTag()
                call RemoveLocation(udg_AaBanPickTextL[GetForLoopIndexA()])
            else
                call DestroyTextTagBJ(udg_AaBanPickText[GetForLoopIndexA()])
                call DestroyTextTagBJ(udg_AaBanPickTextBlue[GetForLoopIndexA()])
                call DestroyTextTagBJ(udg_AaBanPickTextRed[GetForLoopIndexA()])
                call RemoveLocation(udg_AaBanPickTextL[GetForLoopIndexA()])
            endif
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveLocation(udg_AaBanPickTextL[33])
    call DestroyTextTagBJ(udg_AaBanPickText[33])
endfunction

