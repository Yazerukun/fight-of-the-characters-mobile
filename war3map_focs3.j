        return false
    endif
    return true
endfunction

function Trig_BoomCC_____________________u_Actions takes nothing returns nothing
    call IssueImmediateOrderBJ(udg_DeiSKu2, "stomp")
    call StopSoundBJ(gg_snd_DeiC3, false)
    call PlaySoundBJ(gg_snd_DeiC4)
    call ShowUnitHide(udg_DeiSKu)
    call CreateNUnitsAtLoc(1, 'e01H', GetOwningPlayer(udg_DeiSKu), udg_DeiSKl, 270.00)
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 10.00)
    call RemoveLocation(udg_DeiSKl)
