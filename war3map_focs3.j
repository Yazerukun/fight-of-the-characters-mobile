// 넉백

function KnockBackS takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit MoveUnit= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Unit"))
local real distance= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Distance"))
local real SumDistance= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Sum Distance"))
local real Angle=LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Angle"))
local location UnitLoc= GetUnitLoc(MoveUnit)
local location SMoveLocation= PolarProjectionBJ(UnitLoc, SumDistance, Angle)
if ( distance <= 0 ) then
call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
call DestroyTimer(t)
else
call SetUnitPositionLoc(MoveUnit, SMoveLocation)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Distance"), distance - SumDistance)
endif
call RemoveLocation(UnitLoc)
call RemoveLocation(SMoveLocation)
set t=null
set MoveUnit=null
set UnitLoc=null
set SMoveLocation=null
endfunction

function KnockBack takes unit a,location c,real d,real e returns nothing
local timer t= CreateTimer()
local location UnitLoc= GetUnitLoc(a)
local real angle= AngleBetweenPoints(UnitLoc, c)
local real distance= DistanceBetweenPoints(UnitLoc, c)
local real frequency= distance / ( d / e )
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Angle"), angle)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Distance"), distance)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Unit"), a)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Sum Distance"), frequency)
call TimerStart(t, e, true, function KnockBackS)
call RemoveLocation(UnitLoc)
set t=null
set UnitLoc=null
endfunction

//유닛 크기 자동 증가

function Expand1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit expand= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("expand"))
local real BaseSize= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Size"))
local real MaxSize= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("EndSize"))
local real SumSize= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("ExpandPoint"))
  if ( BaseSize >= MaxSize ) then
  call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
  call RemoveUnit(expand)
  call DestroyTimer(t)
  else
  set BaseSize=BaseSize + SumSize
  call SetUnitScalePercent(expand, BaseSize, BaseSize, BaseSize)
  call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Size"), BaseSize)
  endif
set expand=null
set t=null
endfunction

function Expand takes unit a,real b,real c,real d,real e returns nothing
local unit expand= a
local real BaseSize= b
local real MaxSize= c
local timer t= CreateTimer()
local real allowed_Time= ( MaxSize - BaseSize ) / ( e / d )
if ( MaxSize <= BaseSize ) then
else
set BaseSize=BaseSize + allowed_Time
call SetUnitScalePercent(expand, BaseSize, BaseSize, BaseSize)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("expand"), expand)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Size"), BaseSize)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("ExpandPoint"), allowed_Time)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("EndSize"), MaxSize)
call TimerStart(t, d, true, function Expand1)
endif
set expand=null
set t=null
endfunction 

// 자동 크기 축소 

function compress1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit expand= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("expand"))
local real BaseSize= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Size"))
local real MaxSize= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("EndSize"))
local real SumSize= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("ExpandPoint"))
if ( BaseSize <= MaxSize ) then
call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
call RemoveUnit(expand)
call DestroyTimer(t)
else
set BaseSize=BaseSize - SumSize
call SetUnitScalePercent(expand, BaseSize, BaseSize, BaseSize)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Size"), BaseSize)
endif
set expand=null
set t=null
endfunction

function compress takes unit a,real b,real c,real d,real e returns nothing
local unit expand= a
local real BaseSize= b
local real MinSize= c
local timer t= CreateTimer()
local real allowed_Time= ( BaseSize - MinSize ) / ( e / d )
if ( MinSize >= BaseSize ) then
else
set BaseSize=BaseSize - allowed_Time
call SetUnitScalePercent(expand, BaseSize, BaseSize, BaseSize)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("expand"), expand)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Size"), BaseSize)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("ExpandPoint"), allowed_Time)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("EndSize"), MinSize)
call TimerStart(t, d, true, function compress1)
endif
set expand=null
set t=null
endfunction

// 플레이어 진동 

function vibration1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local player p= LoadPlayerHandle(udg_Hashtable, GetHandleId(t), StringHash("cease"))
call CameraClearNoiseForPlayer(p)
call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
call FlushChildHashtable(udg_Hashtable, StringHash("Timer" + I2S(GetConvertedPlayerId(p))))
call DestroyTimer(t)
set p=null
set t=null
endfunction

function vibration takes player a,real b,real c returns nothing
local timer t= CreateTimer()
local player p= a
local real vibrationN= b
local real CeaseTime= c
if ( LoadTimerHandle(udg_Hashtable, StringHash("Timer" + I2S(GetConvertedPlayerId(p))), 0) == null ) then
else
call CameraClearNoiseForPlayer(p)
call DestroyTimer(LoadTimerHandle(udg_Hashtable, StringHash("Timer" + I2S(GetConvertedPlayerId(p))), 0))
call FlushChildHashtable(udg_Hashtable, StringHash("Timer" + I2S(GetConvertedPlayerId(p))))
endif
call CameraSetEQNoiseForPlayer(p, vibrationN)
call SavePlayerHandle(udg_Hashtable, GetHandleId(t), StringHash("cease"), p)
call SaveTimerHandle(udg_Hashtable, StringHash("Timer" + I2S(GetConvertedPlayerId(p))), 0, t)
call TimerStart(t, CeaseTime, false, function vibration1)
set p=null
set t=null
endfunction


//지점 중심 유닛 원 그리기

function Circle1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit CircleUnit= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Circle"))
local real LocX= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("LocX"))
local real LocY= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("LocY"))
local real Cease= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Cease"))
local real CeaseNumber= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("CeaseNumber"))
local real Distance= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Distance"))
local real Angle= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Angle"))
local real OriginalAngle
local location CircleLoc= Location(LocX, LocY)
local location CircleMove= GetUnitLoc(CircleUnit)
set OriginalAngle=AngleBetweenPoints(CircleLoc, CircleMove)
call RemoveLocation(CircleMove)
set CircleMove=PolarProjectionBJ(CircleLoc, Distance, OriginalAngle + Angle)
  if ( CeaseNumber >= Cease ) then
  call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
  call DestroyTimer(t)
  call RemoveUnit(CircleUnit)
  else
  set CeaseNumber=CeaseNumber + 1
  call SetUnitX(CircleUnit, GetLocationX(CircleMove))
  call SetUnitY(CircleUnit, GetLocationY(CircleMove))
  call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("CeaseNumber"), CeaseNumber)
  endif
call RemoveLocation(CircleMove)
call RemoveLocation(CircleLoc)
set CircleUnit=null
set t=null
set CircleMove=null
set CircleLoc=null
endfunction

function Circle takes unit a,real f,location b,real c,real d,real e,boolean g returns nothing
local unit CircleUnit= a
local real Distance= c
local real Cease= d
local real Timerfrequency= e
local boolean direction= g
local real size= f
local real LocX= GetLocationX(b)
local real LocY= GetLocationY(b)
local timer t= CreateTimer()
local real OriginalAngle
local real number= Cease / Timerfrequency
local real A= 360 / ( Distance / size )
local location CircleLoc= Location(LocX, LocY)
local location CricleMove= GetUnitLoc(CircleUnit)
set OriginalAngle=AngleBetweenPoints(CircleLoc, CricleMove)
call RemoveLocation(CricleMove)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Circle"), CircleUnit)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Distance"), Distance)
if ( direction == true ) then
else
set A=- ( A )
endif
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Angle"), A)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("LocX"), LocX)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("LocY"), LocY)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Cease"), number)
set CricleMove=PolarProjectionBJ(CircleLoc, Distance, OriginalAngle + A)
call SetUnitX(CircleUnit, GetLocationX(CricleMove))
call SetUnitY(CircleUnit, GetLocationY(CricleMove))
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("CeaseNumber"), 1)
call TimerStart(t, Timerfrequency, true, function Circle1)
call RemoveLocation(CricleMove)
call RemoveLocation(CircleLoc)
set CircleUnit=null
set t=null
set CricleMove=null
set CircleLoc=null
endfunction

// 점프 함수

function jump1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit a= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("unit"))
local real multiple= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("multiple"))
local real max= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("max"))
local real speed= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("speed"))
local real distance= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("distance"))
local real min= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("min"))
local real height= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("height"))
local real end= 0
if ( min * 2 >= distance ) then
call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
call DestroyTimer(t)
call SetUnitFlyHeightBJ(a, height, 0)
else
set min=min + speed
     if ( ( height + - ( Pow(min, 2.00) / distance ) * multiple ) + max <= height ) then
     call SetUnitFlyHeightBJ(a, height, 0)
     else
     call SetUnitFlyHeightBJ(a, height + - ( ( Pow(min, 2.00) / distance ) * multiple ) + max, 0)
     endif
call SaveReal(udg_Hashtable, GetHandleIdBJ(t), StringHash("min"), min)
endif
set a=null
set t=null
endfunction

function jump takes unit u,real d,real m,real g returns nothing
local timer t= CreateTimer()
local real max= m
local unit a= u
local real speed= d
local real distance= 300
local real cycle= g
local real height= GetUnitFlyHeight(a)
local real min= ( distance / 2 ) * - 1
local real r= ( min * min ) / distance
local real multiple= ( max ) / r
local real w
set w=speed / cycle
set w=distance / w
set speed=w
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("unit"), a)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("height"), height)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("max"), max)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("multiple"), multiple)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("distance"), distance)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("speed"), speed)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("min"), min)
call TimerStart(t, cycle, true, function jump1)
set a=null
set t=null
endfunction

// 이차함수 


function Graph1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit a= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("unit"))
local real multiple= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("multiple"))
local real max= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("max"))
local real speed= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("speed"))
local real distance= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("distance"))
local real min= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("min"))
local real height= LoadReal(udg_Hashtable, GetHandleId(t), StringHashBJ("height"))
local location b= GetUnitLoc(a)
local location loc= PolarProjectionBJ(b, speed, GetUnitFacing(a))
local real end= 0
if ( min * 2 >= distance ) then
call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
call DestroyTimer(t)
call SetUnitFlyHeightBJ(a, height, 0)
else
set min=min + speed
     if ( ( height + - ( Pow(min, 2.00) / distance ) * multiple ) + max <= height ) then
     call SetUnitFlyHeightBJ(a, height, 0)
     else
     call SetUnitFlyHeightBJ(a, height + - ( ( Pow(min, 2.00) / distance ) * multiple ) + max, 0)
     endif
call SetUnitX(a, GetLocationX(loc))
call SetUnitY(a, GetLocationY(loc))
call SaveReal(udg_Hashtable, GetHandleIdBJ(t), StringHash("min"), min)
endif
set a=null
set t=null
call RemoveLocation(b)
call RemoveLocation(loc)
set b=null
set loc=null
endfunction

function Graph takes unit u,real d,real b,real m,real g returns nothing
local timer t= CreateTimer()
local real max= m
local unit a= u
local real speed= d
local real distance= b
local real cycle= g
local real height= GetUnitFlyHeight(a)
local real min= ( distance / 2 ) * - 1
local real r= ( min * min ) / distance
local real multiple= ( max ) / r
local real w
set w=speed / cycle
set w=distance / w
set speed=w
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("unit"), a)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("height"), height)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("max"), max)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("multiple"), multiple)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("distance"), distance)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("speed"), speed)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("min"), min)
call TimerStart(t, cycle, true, function Graph1)
set a=null
set t=null
endfunction

// 이펙트 자동 파괴

function ED takes nothing returns nothing
