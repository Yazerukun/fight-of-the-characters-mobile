            call UnitDamageTargetBJ(udg_NapalmU, GetEnumUnit(), ( 200.00 * I2R(GetUnitAbilityLevelSwapped('A0JW', udg_NapalmU)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
