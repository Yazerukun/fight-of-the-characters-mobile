        return false
    endif
    return true
endfunction

function Trig_gomugomustorm_Actions takes nothing returns nothing
    call PlaySoundBJ(udg_sound78)
    set udg_GomuSu=GetTriggerUnit()
    set udg_GomuSg=0
    set udg_GomuSz=GetSpellTargetLoc()
    set udg_GomuSs=AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_GomuSu), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call SetUnitInvulnerable(udg_GomuSu, true)
    call PauseUnitBJ(true, udg_GomuSu)
    call SetUnitPositionLoc(udg_GomuSu, udg_GomuSz)
    call ShowUnitHide(udg_GomuSu)
    call CreateNUnitsAtLoc(1, 'e05W', GetOwningPlayer(GetTriggerUnit()), udg_GomuSz, bj_UNIT_FACING)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'B025', 2)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "taunt")
    call TriggerSleepAction(0.50)
    if ( Trig_gomugomustorm_Func016C() ) then
        call EnableTrigger(gg_trg_gomugomustorm_______u)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call vibration(ConvertedPlayer(GetForLoopIndexA()) , 2.00 , 5.00)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    else
        if ( Trig_gomugomustorm_Func016Func001C() ) then
            call EnableTrigger(gg_trg_gomugomustorm______________u)
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=8
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call vibration(ConvertedPlayer(GetForLoopIndexA()) , 2.00 , 5.00)
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
        else
            if ( Trig_gomugomustorm_Func016Func001Func003C() ) then
                call EnableTrigger(gg_trg_gomugomustorm_______________2)
                set bj_forLoopAIndex=1
                set bj_forLoopAIndexEnd=8
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    call vibration(ConvertedPlayer(GetForLoopIndexA()) , 2.00 , 5.00)
                    set bj_forLoopAIndex=bj_forLoopAIndex + 1
                endloop
            else
            endif
        endif
    endif
endfunction

