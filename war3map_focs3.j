    set gg_trg_lee2=CreateTrigger()
    call DisableTrigger(gg_trg_lee2)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_lee2, udg_Aaa[12])
    call TriggerAddAction(gg_trg_lee2, function Trig_lee2_Actions)
endfunction

//===========================================================================
// Trigger: lee3
//
// 모든 플레이어의 기본 멜리 게임 초기화
//===========================================================================
function Trig_lee3_Func010Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0EG', udg_REEca) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_lee3_Func010C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0EG', udg_REEca) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_lee3_Actions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ("left hand", udg_REEca, "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")
    set udg_REEeff[4]=GetLastCreatedEffectBJ()
    call SetUnitAnimation(udg_REEca, "attack")
    call SetUnitTimeScalePercent(udg_REEca, 10.00)
    call TriggerSleepAction(2)
    call SetUnitInvulnerable(udg_REEca, false)
    call SetUnitInvulnerable(udg_REEta, false)
    call SetUnitFlyHeightBJ(udg_REEca, 0.00, 2500.00)
    call SetUnitFlyHeightBJ(udg_REEta, 0.00, 0.00)
    if ( Trig_lee3_Func010C() ) then
        call CreateNUnitsAtLoc(1, 'e043', GetOwningPlayer(udg_REEca), GetUnitLoc(udg_REEta), bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_REEta)
    else
        if ( Trig_lee3_Func010Func001C() ) then
            call CreateNUnitsAtLoc(1, 'e043', GetOwningPlayer(udg_REEca), GetUnitLoc(udg_REEta), bj_UNIT_FACING)
            call IncUnitAbilityLevelSwapped('A05F', GetLastCreatedUnit())
            call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_REEta)
        else
            call CreateNUnitsAtLoc(1, 'e043', GetOwningPlayer(udg_REEca), GetUnitLoc(udg_REEta), bj_UNIT_FACING)
            call IncUnitAbilityLevelSwapped('A05F', GetLastCreatedUnit())
            call IncUnitAbilityLevelSwapped('A05F', GetLastCreatedUnit())
            call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_REEta)
        endif
    endif
    call CreateNUnitsAtLocFacingLocBJ(1, 'h00X', GetOwningPlayer(udg_REEca), GetUnitLoc(udg_REEta), GetUnitLoc(udg_REEta))
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'Boar', 1)
    call SetUnitFlyHeightBJ(GetLastCreatedUnit(), GetUnitFlyHeight(udg_REEta), 0.00)
    call SetUnitAnimation(udg_REEta, "death")
    call TerrainDeformationWaveBJ(0.10, GetUnitLoc(udg_REEta), PolarProjectionBJ(GetUnitLoc(udg_REEta), 100.00, 0), 256, 96, 1.00)
    call PauseUnitBJ(false, udg_REEca)
    call PauseUnitBJ(false, udg_REEta)
    call CreateNUnitsAtLoc(1, 'e02X', GetOwningPlayer(udg_REEca), GetUnitLoc(udg_REEta), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
    call SetUnitTimeScalePercent(udg_REEca, 100.00)
    call SetUnitVertexColorBJ(udg_REEca, 100, 100.00, 100.00, 0)
    call DestroyEffectBJ(udg_REEeff[4])
    call TriggerSleepAction(1.00)
    call UnitRemoveAbilityBJ('A08T', udg_REEca)
    call UnitRemoveAbilityBJ('A08T', udg_REEta)
endfunction

