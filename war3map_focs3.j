function Trig_SumeKung2_1_Actions takes nothing returns nothing
    call ForGroupBJ(udg_KenR3uu1, function Trig_SumeKung2_1_Func001A)
    call ForGroupBJ(udg_KenR3uu, function Trig_SumeKung2_1_Func002A)
    call CreateNUnitsAtLoc(1, 'n01A', GetOwningPlayer(udg_KenR7u), udg_KenR7uu, 270.00)
    set udg_KenR3uu0=GetLastCreatedUnit()
    call SetUnitPathing(GetLastCreatedUnit(), false)
    call SetUnitPositionLoc(GetLastCreatedUnit(), udg_KenR7uu)
    call CreateNUnitsAtLoc(1, 'n01B', GetOwningPlayer(udg_KenR7u), udg_KenR7uu, 270.00)
    set udg_KenR3uu00=GetLastCreatedUnit()
    call SetUnitPathing(GetLastCreatedUnit(), false)
    call SetUnitPositionLoc(GetLastCreatedUnit(), udg_KenR7uu)
    call CreateNUnitsAtLoc(1, 'n01C', GetOwningPlayer(udg_KenR7u), udg_KenR7uu, 270.00)
    set udg_KenR3uu000=GetLastCreatedUnit()
    call SetUnitPathing(GetLastCreatedUnit(), false)
    call SetUnitPositionLoc(GetLastCreatedUnit(), udg_KenR7uu)
    call CreateNUnitsAtLoc(1, 'e00Y', GetOwningPlayer(udg_KenR7u), GetUnitLoc(udg_KenR7u), bj_UNIT_FACING)
    call ShowUnitHide(udg_KenR7u)
    call EnableTrigger(gg_trg_SumeKung3)
    call StartTimerBJ(udg_Aaa[30], false, 0.15)
    call EnableTrigger(gg_trg_SumeKung3_3)
    call StartTimerBJ(udg_Aaa[31], false, 0.01)
    call TriggerSleepAction(8.00)
    call ShowUnitShow(udg_KenR7u)
    call CreateNUnitsAtLoc(1, 'e00Y', GetOwningPlayer(udg_KenR7u), GetUnitLoc(udg_KenR7u), bj_UNIT_FACING)
    call PauseUnitBJ(false, udg_KenR7u)
    call SelectUnitForPlayerSingle(udg_KenR7u, GetOwningPlayer(udg_KenR7u))
    call DisableTrigger(gg_trg_SumeKung3)
    call DisableTrigger(gg_trg_SumeKung3_3)
    call KillUnit(udg_KenR3uu0)
    call KillUnit(udg_KenR3uu00)
    call KillUnit(udg_KenR3uu000)
    call ForGroupBJ(udg_KenR3copyu, function Trig_SumeKung2_1_Func031A)
    call ForGroupBJ(udg_KenR3u, function Trig_SumeKung2_1_Func032A)
    call ForGroupBJ(udg_KenR3uu, function Trig_SumeKung2_1_Func033A)
    call ForGroupBJ(udg_KenR3uu1, function Trig_SumeKung2_1_Func034A)
    call ForGroupBJ(udg_KenR3uu2, function Trig_SumeKung2_1_Func035A)
    call ForGroupBJ(udg_KenR3uu3, function Trig_SumeKung2_1_Func036A)
    call ForGroupBJ(udg_SumKyung1u, function Trig_SumeKung2_1_Func037A)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=36
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'e01Y', GetOwningPlayer(udg_KenR7u), PolarProjectionBJ(udg_KenR7uu, 400.00, ( 10.00 * I2R(GetForLoopIndexA()) )), bj_UNIT_FACING)
        call SetUnitPathing(GetLastCreatedUnit(), false)
        call SetUnitPositionLoc(GetLastCreatedUnit(), PolarProjectionBJ(udg_KenR7uu, 400.00, ( 10.00 * I2R(GetForLoopIndexA()) )))
        call CreateNUnitsAtLoc(1, 'e01Z', GetOwningPlayer(udg_KenR7u), PolarProjectionBJ(udg_KenR7uu, 400.00, ( 10.00 * I2R(GetForLoopIndexA()) )), bj_UNIT_FACING)
        call SetUnitPathing(GetLastCreatedUnit(), false)
        call SetUnitPositionLoc(GetLastCreatedUnit(), PolarProjectionBJ(udg_KenR7uu, 400.00, ( 10.00 * I2R(GetForLoopIndexA()) )))
        call CreateNUnitsAtLoc(1, 'e020', GetOwningPlayer(udg_KenR7u), PolarProjectionBJ(udg_KenR7uu, 400.00, ( 10.00 * I2R(GetForLoopIndexA()) )), bj_UNIT_FACING)
        call SetUnitPathing(GetLastCreatedUnit(), false)
        call SetUnitPositionLoc(GetLastCreatedUnit(), PolarProjectionBJ(udg_KenR7uu, 400.00, ( 10.00 * I2R(GetForLoopIndexA()) )))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set udg_KenR7u=null
    call RemoveLocation(udg_KenR7uu)
endfunction

