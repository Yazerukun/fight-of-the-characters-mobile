//===========================================================================
function Trig_sair_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0MZ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_sair_Func018Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0MZ', GetTriggerUnit()) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_sair_Func018Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0MZ', GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    return true
endfunction

