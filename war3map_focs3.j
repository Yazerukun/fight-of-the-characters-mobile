    set gg_trg_color1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_color1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_color1, Condition(function Trig_color1_Conditions))
    call TriggerAddAction(gg_trg_color1, function Trig_color1_Actions)
endfunction

//===========================================================================
// Trigger: iGv1a
//===========================================================================
function Trig_iGv1a_Func002Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B00X') == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(udg_SAPOK, 'I01L') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_iGv1a_Func002A takes nothing returns nothing
    if ( Trig_iGv1a_Func002Func001C() ) then
        call UnitDamageTargetBJ(udg_SAPOK, GetEnumUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_SAPOK, true)) / 2.00 ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
    else
    endif
