endfunction

//===========================================================================
// Trigger: junkuk2
//===========================================================================
function Trig_junkuk2_Func003Func001C takes nothing returns boolean
    if ( not ( udg_JunKuk_Integer >= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_junkuk2_Func003Func014C takes nothing returns boolean
    if ( not ( GetUnitX(udg_JunKuk) >= GetUnitX(udg_JunKuk2) ) ) then
        return false
    endif
    return true
endfunction

function Trig_junkuk2_Func003Func015C takes nothing returns boolean
    if ( not ( GetUnitY(udg_JunKuk) >= GetUnitY(udg_JunKuk2) ) ) then
        return false
    endif
    return true
endfunction

function Trig_junkuk2_Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_JunKukL, udg_JunKukL2) > 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_junkuk2_Actions takes nothing returns nothing
    set udg_JunKukL=GetUnitLoc(udg_JunKuk)
    set udg_JunKukL2=GetUnitLoc(udg_JunKuk2)
    if ( Trig_junkuk2_Func003C() ) then
        if ( Trig_junkuk2_Func003Func001C() ) then
            call AddSpecialEffectLocBJ(Location(GetUnitX(udg_JunKuk), GetUnitY(udg_JunKuk)), "Abilities\\Weapons\\Bolt\\BoltImpact.mdl")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            set udg_JunKuk_Integer=0
        else
            set udg_JunKuk_Integer=( udg_JunKuk_Integer + 1 )
        endif
        if ( Trig_junkuk2_Func003Func014C() ) then
            call SetUnitX(udg_JunKuk, ( GetUnitX(udg_JunKuk) - 10.00 ))
        else
            call SetUnitX(udg_JunKuk, ( GetUnitX(udg_JunKuk) + 10.00 ))
        endif
        if ( Trig_junkuk2_Func003Func015C() ) then
            call SetUnitY(udg_JunKuk, ( GetUnitY(udg_JunKuk) - 10.00 ))
        else
            call SetUnitY(udg_JunKuk, ( GetUnitY(udg_JunKuk) + 10.00 ))
        endif
    else
        call PauseTimerBJ(true, udg_JunKukT)
        call CreateNUnitsAtLoc(1, 'e06L', GetOwningPlayer(udg_JunKuk), udg_JunKukL2, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_JunKuk2)
        call UnitDamageTargetBJ(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(udg_JunKuk))], udg_JunKuk2, ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(udg_JunKuk))], true)) * 1.00 ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
        call KillUnit(udg_JunKuk)
        call AddSpecialEffectLocBJ(udg_JunKukL2, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(udg_JunKukL2, "Abilities\\Spells\\Items\\AIlb\\AIlbSpecialArt.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(udg_JunKukL2, "Abilities\\Spells\\Orc\\LightningShield\\LightningShieldTarget.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    endif
    call RemoveLocation(udg_JunKukL)
    call RemoveLocation(udg_JunKukL2)
endfunction

