    call UnitDamageTargetBJ(udg_Ar_Ru, GetEnumUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_Ar_Ru, true)) * 0.50 ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
