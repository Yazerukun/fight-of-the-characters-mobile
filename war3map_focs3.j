function Trig_dig3______________u_Actions takes nothing returns nothing
    call DestroyTrigger(udg_trigger98)
    call DestroyTrigger(udg_trigger99)
    call DestroyTrigger(udg_trigger100)
    call DestroyTrigger(udg_trigger101)
    call DestroyTrigger(udg_trigger102)
    call DestroyTrigger(udg_trigger103)
    call DestroyTrigger(udg_trigger104)
    call DestroyTrigger(gg_trg_rule)
    call DestroyTrigger(gg_trg_rule1)
    call DestroyTrigger(gg_trg_rule2)
    call DestroyTrigger(gg_trg_rule4)
    call DestroyTrigger(gg_trg_rule5)
    if ( (GetPlayerSlotState(Player(0)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnR=( udg_BanPickTurnR + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(1)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnR=( udg_BanPickTurnR + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(2)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnR=( udg_BanPickTurnR + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(3)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnR=( udg_BanPickTurnR + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(4)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnB=( udg_BanPickTurnB + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(5)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnB=( udg_BanPickTurnB + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(6)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnB=( udg_BanPickTurnB + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(7)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnB=( udg_BanPickTurnB + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(0)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnR=( udg_BanPickTurnR + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(1)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnR=( udg_BanPickTurnR + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(2)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnR=( udg_BanPickTurnR + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(3)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnR=( udg_BanPickTurnR + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(4)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnB=( udg_BanPickTurnB + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(5)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnB=( udg_BanPickTurnB + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(6)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnB=( udg_BanPickTurnB + 1 )
    else
        call DoNothing()
    endif
    if ( (GetPlayerSlotState(Player(7)) == PLAYER_SLOT_STATE_PLAYING) ) then // INLINED!!
        set udg_BanPickTurnB=( udg_BanPickTurnB + 1 )
    else
        call DoNothing()
    endif
    if ( Trig_dig3______________u_Func029C() ) then
        set udg_BanPickTurnR=udg_BanPickTurnB
    else
        if ( Trig_dig3______________u_Func029Func001C() ) then
            set udg_BanPickTurnB=udg_BanPickTurnR
        else
        endif
    endif
    if ( Trig_dig3______________u_Func030C() ) then
        call TriggerExecute(gg_trg_text)
        call SetPlayerAbilityAvailableBJ(false, 'A03G', Player(0))
        call SetPlayerAbilityAvailableBJ(false, 'A03G', Player(1))
        call SetPlayerAbilityAvailableBJ(false, 'A03G', Player(2))
        call SetPlayerAbilityAvailableBJ(false, 'A03G', Player(3))
        call SetPlayerAbilityAvailableBJ(false, 'A03G', Player(4))
        call SetPlayerAbilityAvailableBJ(false, 'A03G', Player(5))
        call SetPlayerAbilityAvailableBJ(false, 'A03G', Player(6))
        call SetPlayerAbilityAvailableBJ(false, 'A03G', Player(7))
        call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_10177")
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call MultiboardSetItemStyleBJ(GetLastCreatedMultiboard(), 4, GetForLoopIndexA(), false, false)
            call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(), 4, GetForLoopIndexA(), 0.01)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call PauseGameOn()
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=4
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set bj_forLoopBIndex=1
            set bj_forLoopBIndexEnd=32
            loop
                exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
                call TriggerRegisterPlayerChatEvent(gg_trg_RedBan, ConvertedPlayer(GetForLoopIndexA()), ( "--" + I2S(GetForLoopIndexB()) ), true)
                call TriggerRegisterPlayerChatEvent(gg_trg_RedSel, ConvertedPlayer(GetForLoopIndexA()), ( "++" + I2S(GetForLoopIndexB()) ), true)
                set bj_forLoopBIndex=bj_forLoopBIndex + 1
            endloop
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        set bj_forLoopAIndex=5
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set bj_forLoopBIndex=1
            set bj_forLoopBIndexEnd=32
            loop
                exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
                call TriggerRegisterPlayerChatEvent(gg_trg_BlueBan, ConvertedPlayer(GetForLoopIndexA()), ( "--" + I2S(GetForLoopIndexB()) ), true)
                call TriggerRegisterPlayerChatEvent(gg_trg_BlueBan2, ConvertedPlayer(GetForLoopIndexA()), ( "--" + I2S(GetForLoopIndexB()) ), true)
                call TriggerRegisterPlayerChatEvent(gg_trg_BlueSel, ConvertedPlayer(GetForLoopIndexA()), ( "++" + I2S(GetForLoopIndexB()) ), true)
                set bj_forLoopBIndex=bj_forLoopBIndex + 1
            endloop
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call EnableTrigger(gg_trg_BlueBan2)
        call DestroyTextTagBJ(udg_AaBanPickText[33])
        call CreateTextTagLocBJ("TRIGSTR_11228", udg_AaBanPickTextL[33], 0, 10, GetRandomReal(25.00, 100.00), GetRandomReal(25.00, 100.00), GetRandomReal(25.00, 100.00), 0)
        set udg_AaBanPickText[33]=GetLastCreatedTextTag()
    else
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=32
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_AaBLUE_SEL[GetForLoopIndexA()]=true
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=32
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_AaRED_SEL[GetForLoopIndexA()]=true
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_10142")
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call MultiboardSetItemStyleBJ(GetLastCreatedMultiboard(), 4, GetForLoopIndexA(), false, false)
            call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(), 4, GetForLoopIndexA(), 0.01)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    endif
endfunction

