    call TriggerAddAction(gg_trg_ColdA________3, function Trig_ColdA________3_Actions)
endfunction

//===========================================================================
// Trigger: ColdA loof 복사 2
//===========================================================================
function Trig_ColdA_loof________2_Func001Func003C takes nothing returns boolean
    if ( not ( udg_ColdIc == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ColdA_loof________2_Func001C takes nothing returns boolean
    if ( not ( R2I(DistanceBetweenPoints(Location(GetUnitX(udg_ColdUc), GetUnitY(udg_ColdUc)), udg_ColdLCc)) > 50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ColdA_loof________2_Actions takes nothing returns nothing
    if ( Trig_ColdA_loof________2_Func001C() ) then
        set udg_ColdIc=( udg_ColdIc + 1 )
        set udg_ColdIcC=( udg_ColdIcC + 15.00 )
        if ( Trig_ColdA_loof________2_Func001Func003C() ) then
            set udg_ColdIc=0
            set udg_ColdLCc2=GetUnitLoc(udg_ColdUc)
            call CreateNUnitsAtLoc(1, 'e09S', GetOwningPlayer(udg_ColdUc), udg_ColdLCc2, udg_ColdREc)
            call SetUnitTimeScalePercent(GetLastCreatedUnit(), ( 400.00 - udg_ColdIcC ))
            call RemoveLocation(udg_ColdLCc2)
        else
        endif
        call SetUnitPositionLocFacingLocBJ(udg_ColdUc, PolarProjectionBJ(Location(GetUnitX(udg_ColdUc), GetUnitY(udg_ColdUc)), 40.00, udg_ColdREc), udg_ColdLCc)
    else
        call PauseTimerBJ(true, udg_ColdTc)
        call SetUnitPositionLocFacingLocBJ(udg_ColdUc, udg_ColdLCc, udg_ColdLCc)
        call SetUnitVertexColorBJ(udg_ColdUc, 100, 100, 100, 100.00)
        call TriggerExecute(gg_trg_ColdA_End_______u)
    endif
endfunction

