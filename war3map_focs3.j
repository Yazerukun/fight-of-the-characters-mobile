//===========================================================================
// Trigger: junkuk2 복사
//===========================================================================
function Trig_junkuk2_______u_Func003Func013C takes nothing returns boolean
    if ( not ( GetUnitX(udg_JunKuk_______u) >= GetUnitX(udg_JunKuk2_______u) ) ) then
        return false
    endif
    return true
endfunction

function Trig_junkuk2_______u_Func003Func014C takes nothing returns boolean
    if ( not ( GetUnitY(udg_JunKuk_______u) >= GetUnitY(udg_JunKuk2_______u) ) ) then
        return false
    endif
    return true
endfunction

function Trig_junkuk2_______u_Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_JunKukL_______u, udg_JunKukL2_______u) > 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_junkuk2_______u_Actions takes nothing returns nothing
    set udg_JunKukL_______u=GetUnitLoc(udg_JunKuk_______u)
    set udg_JunKukL2_______u=GetUnitLoc(udg_JunKuk2_______u)
    if ( Trig_junkuk2_______u_Func003C() ) then
        if ( Trig_junkuk2_______u_Func003Func013C() ) then
            call SetUnitX(udg_JunKuk_______u, ( GetUnitX(udg_JunKuk_______u) - 10.00 ))
        else
            call SetUnitX(udg_JunKuk_______u, ( GetUnitX(udg_JunKuk_______u) + 10.00 ))
        endif
        if ( Trig_junkuk2_______u_Func003Func014C() ) then
            call SetUnitY(udg_JunKuk_______u, ( GetUnitY(udg_JunKuk_______u) - 10.00 ))
        else
            call SetUnitY(udg_JunKuk_______u, ( GetUnitY(udg_JunKuk_______u) + 10.00 ))
        endif
    else
        call PauseTimerBJ(true, udg_JunKukT_______u)
        call CreateNUnitsAtLoc(1, 'e06L', GetOwningPlayer(udg_JunKuk_______u), udg_JunKukL2_______u, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_JunKuk2_______u)
        call UnitDamageTargetBJ(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(udg_JunKuk_______u))], udg_JunKuk2_______u, ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(udg_JunKuk_______u))], true)) * 2.00 ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
        call KillUnit(udg_JunKuk_______u)
        call AddSpecialEffectLocBJ(udg_JunKukL2_______u, "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(udg_JunKukL2_______u, "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(udg_JunKukL2_______u, "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    endif
    call RemoveLocation(udg_JunKukL_______u)
    call RemoveLocation(udg_JunKukL2_______u)
endfunction

