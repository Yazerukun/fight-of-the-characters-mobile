//===========================================================================
// Trigger: ruleskill
//===========================================================================
function Trig_ruleskill_Func002C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0S5' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0S3' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0S4' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0S1' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0S2' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0SI' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0TF' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ruleskill_Conditions takes nothing returns boolean
    if ( not Trig_ruleskill_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_ruleskill_Func001Func005Func003Func003Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0TF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleskill_Func001Func005Func003Func003Func001Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0SI' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleskill_Func001Func005Func003Func003Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0S1' ) ) then
        return false
    endif
    if ( not ( udg_RandomMode2 == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleskill_Func001Func005Func003Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0S2' ) ) then
        return false
    endif
    if ( not ( udg_RandomMode3 == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleskill_Func001Func005Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0S4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleskill_Func001Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0S3' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleskill_Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0S5' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleskill_Actions takes nothing returns nothing
    if ( Trig_ruleskill_Func001C() ) then
        call DestroyTimerDialogBJ(udg_GameDuelTimer4)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=10
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call TimerDialogDisplayForPlayerBJ(false, udg_GameDuelTimer4, ConvertedPlayer(GetForLoopIndexA()))
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call SetPlayerAbilityAvailableBJ(false, 'A0S5', Player(0))
        call TriggerExecute(gg_trg_rule1)
    else
        if ( Trig_ruleskill_Func001Func005C() ) then
            call SetPlayerAbilityAvailableBJ(false, 'A0S3', Player(0))
            call TriggerExecute(gg_trg_rule4)
        else
            if ( Trig_ruleskill_Func001Func005Func003C() ) then
                call SetPlayerAbilityAvailableBJ(false, 'A0S4', Player(0))
                call TriggerExecute(gg_trg_rule5)
            else
                if ( Trig_ruleskill_Func001Func005Func003Func003C() ) then
                    call SetPlayerAbilityAvailableBJ(false, 'A0S2', Player(0))
                    call SetPlayerAbilityAvailableBJ(false, 'A0S1', Player(0))
                    call TriggerExecute(gg_trg_rule2)
                else
                    if ( Trig_ruleskill_Func001Func005Func003Func003Func001C() ) then
                        call SetPlayerAbilityAvailableBJ(false, 'A0S2', Player(0))
                        call SetPlayerAbilityAvailableBJ(false, 'A0S1', Player(0))
                        call TriggerExecute(gg_trg_rule)
                    else
                        if ( Trig_ruleskill_Func001Func005Func003Func003Func001Func001C() ) then
                            call SetPlayerAbilityAvailableBJ(false, 'A0SI', Player(0))
                            call StartTimerBJ(udg_GameDuelTimer2, false, 300.00)
                            call CreateTimerDialogBJ(GetLastCreatedTimerBJ(), "TRIGSTR_12575")
                            set udg_GameDuelTimer4=GetLastCreatedTimerDialogBJ()
                            set bj_forLoopAIndex=1
                            set bj_forLoopAIndexEnd=10
                            loop
                                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                                call TimerDialogDisplayForPlayerBJ(true, udg_GameDuelTimer4, ConvertedPlayer(GetForLoopIndexA()))
                                set bj_forLoopAIndex=bj_forLoopAIndex + 1
                            endloop
                        else
                            if ( Trig_ruleskill_Func001Func005Func003Func003Func001Func001Func001C() ) then
                                call SetPlayerAbilityAvailableBJ(false, 'A0TF', Player(0))
                                call TriggerExecute(gg_trg_rule________2)
                            else
                            endif
                        endif
                    endif
                endif
            endif
        endif
    endif
endfunction

