function yj takes real Yj returns nothing
 local real zj
 local real st=TimerGetElapsed(udg_timer205)
	if st <= 0 then
		set udg_timer205=CreateTimer()
		call TimerStart(udg_timer205, 0xF4240, false, null)
	endif
	if ( Yj > 0 ) then
		loop
			set zj=Yj - TimerGetElapsed(udg_timer205) + st
			exitwhen zj <= 0
			if ( zj > bj_POLLED_WAIT_SKIP_THRESHOLD ) then
				call TriggerSleepAction(.1 * zj)
			else
				call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
			endif
		endloop
	endif
endfunction

