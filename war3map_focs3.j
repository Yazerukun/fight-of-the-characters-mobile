		set udg_integers05[( 1 + GetPlayerId(GetTriggerPlayer()) )]=30
		call AddSpecialEffectLocBJ(GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
		call DisplayTimedTextToForce(bJ(GetTriggerPlayer()), 5., "|c0000ffff저장된 위치로 소환되었습니다.")
		call SetUnitPositionLoc(GetEnumUnit(), udg_locations03[( 1 + GetPlayerId(GetTriggerPlayer()) )])
		call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetEnumUnit()), GetUnitLoc(GetEnumUnit()), 0)
		call StartTimerBJ(udg_timer121, true, 1.)
		call StartTimerBJ(udg_TimerT[8], false, I2R(udg_integers05[8]))
		call PauseTimerBJ(true, udg_TimerT[8])
		call TimerDialogDisplayForPlayerBJ(true, udg_TimerTT[8], ConvertedPlayer(8))
	else
		call DisplayTextToForce(bJ(GetTriggerPlayer()), "(|c00ff0000!|r)|c00ffff00사용할 수 없습니다.")
	endif
endfunction

function Cs takes nothing returns boolean
	return ( udg_integers05[( 1 + GetPlayerId(GetTriggerPlayer()) )] == 0 )
endfunction

function ds takes nothing returns nothing
	if ( (udg_integers05[( 1 + GetPlayerId(GetTriggerPlayer()) )] == 0) ) then // INLINED!!
		set bj_wantDestroyGroup=true
		call ForGroupBJ(RJ(GetTriggerPlayer() , Condition(function bs)), function cs)
	else
		call DisplayTextToForce(bJ(GetTriggerPlayer()), ( "(|c00ff0000!|r)|c00ffff00아직 쿨타임이 채워지지 않았습니다.(" + ( I2S(R2I(I2R(udg_integers05[( 1 + GetPlayerId(GetTriggerPlayer()) )]))) + "초.)|r" ) ))
	endif
endfunction

