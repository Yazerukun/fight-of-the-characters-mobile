//===========================================================================
// Trigger: he 복사 2
//===========================================================================
function Trig_he________2_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_he________2_Func001Func005C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0FR', GetTriggerUnit()) >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_he________2_Func001C takes nothing returns boolean
    if ( not ( udg_Bankai == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_he________2_Actions takes nothing returns nothing
    if ( Trig_he________2_Func001C() ) then
        set udg_Bankai=true
        call SetPlayerAbilityAvailableBJ(false, 'A0DX', GetOwningPlayer(GetTriggerUnit()))
        if ( Trig_he________2_Func001Func005C() ) then
            call PlaySoundBJ(udg_sound10)
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=8
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call CameraSetEQNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()), 2.00)
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
            call CreateNUnitsAtLoc(1, 'e041', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), 270.00)
            call SetUnitTimeScalePercent(GetLastCreatedUnit(), 15.00)
            call CreateNUnitsAtLoc(1, 'e041', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), 270.00)
            call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
            call TriggerSleepAction(7.00)
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=8
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call CameraClearNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()))
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
        else
            call PlaySoundBJ(udg_sound10)
            call CreateNUnitsAtLoc(1, 'e03Z', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), 270.00)
            call CreateNUnitsAtLoc(1, 'e040', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), 270.00)
        endif
    else
        set udg_Bankai=false
        call SetPlayerAbilityAvailableBJ(true, 'A0DX', GetOwningPlayer(GetTriggerUnit()))
    endif
endfunction

