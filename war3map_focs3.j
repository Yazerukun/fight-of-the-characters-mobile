    call TriggerSleepAction(0.20)
    call ShowUnitShow(udg_DeiSKu)
    call SetUnitVertexColorBJ(udg_DeiSKu, 100, 100, 100, 0.00)
    call KillUnit(udg_DeiSKu)
    call TriggerSleepAction(0.20)
    call ExplodeUnitBJ(udg_DeiSKu2)
    call RemoveUnit(udg_DeiSKu2)
    set udg_DeiSKu2=null
endfunction

