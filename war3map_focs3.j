//===========================================================================
function Trig_Kaido_Q_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0IT' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kaido_Q_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_Kaido_Q)
    set udg_Kaido_U=GetTriggerUnit()
    set udg_Kaido_L[1]=GetUnitLoc(udg_Kaido_U)
    set udg_Kaido_L[2]=GetSpellTargetLoc()
    set udg_Kaido_I[3]=0
    set udg_Kaido_I[4]=0
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[1], AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]))
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Effect Mythic_Conflagrate Blue.mdx")
    call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 100.00, 1000000000.00)
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[1], AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]))
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "WarStompCaster.mdx")
    call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 100.00, 1000000000.00)
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 0)
    call SetUnitScalePercent(GetLastCreatedUnit(), 300.00, 300.00, 300.00)
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[1], ( AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]) - 180.00 ))
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
    call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 100.00, 1000000000.00)
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 0)
    call SetUnitScalePercent(GetLastCreatedUnit(), 200.00, 200.00, 200.00)
    call StartTimerBJ(udg_Kaido_Timer[3], true, 0.05)
endfunction

