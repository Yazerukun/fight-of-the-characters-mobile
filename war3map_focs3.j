//===========================================================================
// Trigger: SaMak
//===========================================================================
function Trig_SaMak_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E7' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SaMak_Func001Func004001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h00W' )
endfunction

function Trig_SaMak_Func001Func004A takes nothing returns nothing
    set udg_MOL=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_MOL, "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_MOL)
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_SaMak_Func001C takes nothing returns boolean
    if ( not ( udg_Aak2 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SaMak_Actions takes nothing returns nothing
    if ( Trig_SaMak_Func001C() ) then
        call TerrainDeformationCraterBJ(0.5, true, udg_MuljiokC, 400.00, - 200.00)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(GetEntireMapRect(), Condition(function Trig_SaMak_Func001Func004001002)), function Trig_SaMak_Func001Func004A)
    else
        set udg_Aak2=true
    endif
    set udg_MuljiokC=GetSpellTargetLoc()
    set udg_MuljiokCreal[1]=GetLocationX(udg_MuljiokC)
    set udg_MuljiokCreal[2]=GetLocationY(udg_MuljiokC)
    set udg_MuljiokCreal[3]=0.00
    set udg_Muljiok_uC=GetTriggerUnit()
    call UnitAddItemByIdSwapped('I049', udg_Muljiok_uC)
    call CreateNUnitsAtLocFacingLocBJ(1, 'n026', GetOwningPlayer(udg_Muljiok_uC), udg_MuljiokC, udg_MuljiokC)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'B025', 7)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'h00W', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(udg_MuljiokC, 400.00, ( 20.00 * I2R(GetForLoopIndexA()) )), udg_MuljiokC)
        call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100, 58.80, 0.00, 25.00)
        call SetUnitPathing(GetLastCreatedUnit(), false)
        call SetUnitPositionLocFacingLocBJ(GetLastCreatedUnit(), PolarProjectionBJ(udg_MuljiokC, 400.00, ( 20.00 * I2R(GetForLoopIndexA()) )), udg_MuljiokC)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TerrainDeformationCraterBJ(0.5, true, udg_MuljiokC, 400.00, 200.00)
    call EnableTrigger(gg_trg_SaMak2)
    call StartTimerBJ(udg_Aaa[19], true, 0.10)
    call StartTimerBJ(udg_Muljiok_uu2, false, 10.50)
endfunction

