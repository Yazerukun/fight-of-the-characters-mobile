        call UnitDamageTargetBJ(udg_Ao_2y_U, udg_Ao_2y_Target[0], I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_Ao_2y_U, true)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
