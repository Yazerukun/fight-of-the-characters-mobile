function Trig_sabert2______________u_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e00D', GetOwningPlayer(udg_saberA), udg_saberC, ( udg_saberB - 180.00 ))
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
    set udg_saberC=GetUnitLoc(GetLastCreatedUnit())
    call SetUnitInvulnerable(udg_saberA, true)
    call UnitDamagePointLoc(udg_saberA, 0, 225.00, udg_saberC, ( I2R(udg_SaberTu3) + 5000.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_ENHANCED)
    call SetUnitInvulnerable(udg_saberA, false)
    call CreateNUnitsAtLoc(1, 'e00D', GetOwningPlayer(udg_saberA), udg_saberC, ( udg_saberB - 180.00 ))
    call SetUnitPositionLocFacingBJ(GetLastCreatedUnit(), PolarProjectionBJ(udg_saberC, 300.00, udg_saberB), ( udg_saberB - 180.00 ))
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
    set udg_saberC=GetUnitLoc(GetLastCreatedUnit())
    call SetUnitInvulnerable(udg_saberA, true)
    call UnitDamagePointLoc(udg_saberA, 0, 225.00, udg_saberC, ( I2R(udg_SaberTu3) + 5000.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_ENHANCED)
    call SetUnitInvulnerable(udg_saberA, false)
    call CreateNUnitsAtLoc(1, 'e00D', GetOwningPlayer(udg_saberA), udg_saberC, ( udg_saberB - 180.00 ))
    call SetUnitPositionLocFacingBJ(GetLastCreatedUnit(), PolarProjectionBJ(udg_saberC, 300.00, udg_saberB), ( udg_saberB - 180.00 ))
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
    set udg_saberC=GetUnitLoc(GetLastCreatedUnit())
    call SetUnitInvulnerable(udg_saberA, true)
    call UnitDamagePointLoc(udg_saberA, 0, 225.00, udg_saberC, ( I2R(udg_SaberTu3) + 5000.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_ENHANCED)
    call SetUnitInvulnerable(udg_saberA, false)
