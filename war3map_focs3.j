function Trig_scoremob_Actions takes nothing returns nothing
    if ( Trig_scoremob_Func001C() ) then
        if ( Trig_scoremob_Func001Func002C() ) then
            set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 10000 )
        else
            set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( 600 + ( GetUnitLevel(GetDyingUnit()) * 2 ) ) )
        endif
    else
        if ( Trig_scoremob_Func001Func001C() ) then
            if ( Trig_scoremob_Func001Func001Func001C() ) then
                set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 3 )
            else
                set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 14 )
            endif
        else
            if ( Trig_scoremob_Func001Func001Func002C() ) then
                set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( 20 + ( GetUnitLevel(GetDyingUnit()) * 2 ) ) )
            else
                if ( Trig_scoremob_Func001Func001Func002Func001C() ) then
                    set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( 17 + ( GetUnitLevel(GetDyingUnit()) * 2 ) ) )
                else
                    if ( Trig_scoremob_Func001Func001Func002Func001Func001C() ) then
                        if ( Trig_scoremob_Func001Func001Func002Func001Func001Func001C() ) then
                            set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 4 )
                        else
                            set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 16 )
                        endif
                    else
                        set udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]=( udg_Score[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + ( 1 + ( GetUnitLevel(GetDyingUnit()) * 1 ) ) )
                    endif
                endif
            endif
        endif
    endif
endfunction

