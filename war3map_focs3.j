    endif
    return true
endfunction

function Trig_Sigi_______u_Actions takes nothing returns nothing
    call PauseUnitBJ(false, udg_SigiUnit2)
    set udg_SigiUnit2=null
    set udg_SigiUnit1=null
    set udg_siginon=false
endfunction

