    call TriggerAddAction(gg_trg_nidoru3, function Trig_nidoru3_Actions)
endfunction

//===========================================================================
// Trigger: JoongBok
//===========================================================================
function Trig_JoongBok_Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerName(ConvertedPlayer(GetForLoopIndexA())) == GetPlayerName(ConvertedPlayer(GetForLoopIndexB())) ) ) then
        return false
    endif
    if ( not ( GetPlayerController(ConvertedPlayer(GetForLoopIndexA())) != GetPlayerController(ConvertedPlayer(GetForLoopIndexB())) ) ) then
        return false
    endif
    return true
endfunction

function Trig_JoongBok_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set bj_forLoopBIndex=1
        set bj_forLoopBIndexEnd=8
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            if ( Trig_JoongBok_Func001Func001Func001C() ) then
                call CustomDefeatBJ(ConvertedPlayer(GetForLoopIndexA()), "TRIGSTR_9801")
                call CustomDefeatBJ(ConvertedPlayer(GetForLoopIndexB()), "TRIGSTR_9802")
            else
            endif
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_JoongBok takes nothing returns nothing
    set gg_trg_JoongBok=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_JoongBok, 1.00)
    call TriggerAddAction(gg_trg_JoongBok, function Trig_JoongBok_Actions)
endfunction

