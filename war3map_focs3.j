//===========================================================================
// Trigger: Muljiok
//===========================================================================
function Trig_Muljiok_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E6' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Muljiok_Func001Func004001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h00S' )
endfunction

function Trig_Muljiok_Func001Func004A takes nothing returns nothing
    set udg_MOL=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_MOL, "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_MOL)
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_Muljiok_Func001C takes nothing returns boolean
    if ( not ( udg_Aak1 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Muljiok_Func004Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0E6', udg_Muljiok_u) == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Muljiok_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0E6', udg_Muljiok_u) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Muljiok_Func004Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0E6', udg_Muljiok_u) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Muljiok_Func004C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0E6', udg_Muljiok_u) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Muljiok_Actions takes nothing returns nothing
    if ( Trig_Muljiok_Func001C() ) then
        call TerrainDeformationCraterBJ(0.5, true, udg_Muljiok, 400.00, - 200.00)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(GetEntireMapRect(), Condition(function Trig_Muljiok_Func001Func004001002)), function Trig_Muljiok_Func001Func004A)
    else
        set udg_Aak1=true
    endif
    set udg_Muljiok=GetSpellTargetLoc()
    set udg_Muljiok_u=GetTriggerUnit()
    if ( Trig_Muljiok_Func004C() ) then
        call UnitAddItemByIdSwapped('I049', udg_Muljiok_u)
    else
        if ( Trig_Muljiok_Func004Func001C() ) then
            call UnitAddItemByIdSwapped('I04A', udg_Muljiok_u)
        else
            if ( Trig_Muljiok_Func004Func001Func001C() ) then
                call UnitAddItemByIdSwapped('I04B', udg_Muljiok_u)
            else
                if ( Trig_Muljiok_Func004Func001Func001Func001C() ) then
                    call UnitAddItemByIdSwapped('I04B', udg_Muljiok_u)
                else
                endif
            endif
        endif
    endif
    set udg_MuljiokCreal[4]=GetLocationX(udg_Muljiok)
    set udg_MuljiokCreal[5]=GetLocationY(udg_Muljiok)
    call CreateNUnitsAtLocFacingLocBJ(1, 'n01F', GetOwningPlayer(udg_Muljiok_u), udg_Muljiok, udg_Muljiok)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'B025', ( 4 + ( 3 * GetUnitAbilityLevelSwapped('A0E6', udg_Muljiok_u) ) ))
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'h00S', Player(bj_PLAYER_NEUTRAL_EXTRA), PolarProjectionBJ(udg_Muljiok, 400.00, ( 20.00 * I2R(GetForLoopIndexA()) )), udg_Muljiok)
        call SetUnitPathing(GetLastCreatedUnit(), false)
        call SetUnitPositionLocFacingLocBJ(GetLastCreatedUnit(), PolarProjectionBJ(udg_Muljiok, 400.00, ( 20.00 * I2R(GetForLoopIndexA()) )), udg_Muljiok)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TerrainDeformationCraterBJ(0.5, true, udg_Muljiok, 400.00, 200.00)
    call EnableTrigger(gg_trg_Muljiok2)
    call StartTimerBJ(udg_Aaa[16], true, 0.10)
    call StartTimerBJ(udg_Muljiok_uu, false, ( 7.55 + ( 2.50 * I2R(GetUnitAbilityLevelSwapped('A0E6', udg_Muljiok_u)) ) ))
endfunction

