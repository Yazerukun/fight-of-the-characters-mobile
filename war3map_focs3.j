    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_DuelEndSet1_Func032A)
    call RemoveLocation(udg_DftCamera[11])
    call RemoveLocation(udg_DftCamera[12])
    call RemoveLocation(udg_DftCamera[13])
    call RemoveLocation(udg_DftCamera[14])
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_DuelEndSet1_Func038A)
