function Trig_SimpanT1_Func001Func007C takes nothing returns boolean
    if ( not ( udg_SimpanNC[1] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SimpanT1_Func001C takes nothing returns boolean
    if ( not ( udg_GameDuelOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SimpanT1_Func002C takes nothing returns boolean
    if ( not ( udg_SimpanN[1] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SimpanT1_Actions takes nothing returns nothing
    if ( Trig_SimpanT1_Func001C() ) then
        if ( Trig_SimpanT1_Func001Func007C() ) then
            set udg_DftCamera[1]=GetUnitLoc(udg_WichiUnit[udg_SimpanPC[1]])
            call PanCameraToTimedLocForPlayer(Player(0), udg_DftCamera[1], 0.06)
            call RemoveLocation(udg_DftCamera[1])
            call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_ANGLE_OF_ATTACK, - 56.00, 0.00)
            call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_ZOFFSET, 0.00, 0.00)
            call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_ROTATION, 90.00, 0.50)
        else
        endif
    else
        set udg_DftCamera[1]=GetUnitLoc(udg_WichiUnit[udg_SimpanPC[1]])
        call PanCameraToTimedLocForPlayer(Player(0), udg_DftCamera[1], 0.06)
        call RemoveLocation(udg_DftCamera[1])
        call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_ANGLE_OF_ATTACK, - 56.00, 0.00)
        call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_ZOFFSET, 0.00, 0.00)
        call SetCameraFieldForPlayer(Player(0), CAMERA_FIELD_ROTATION, 90.00, 0.50)
    endif
    if ( Trig_SimpanT1_Func002C() ) then
        call SetPlayerStateBJ(Player(0), PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(udg_SimpanP[GetConvertedPlayerId(Player(0))], PLAYER_STATE_RESOURCE_GOLD))
        call SetPlayerStateBJ(Player(0), PLAYER_STATE_RESOURCE_LUMBER, GetPlayerState(udg_SimpanP[GetConvertedPlayerId(Player(0))], PLAYER_STATE_RESOURCE_LUMBER))
    else
    endif
endfunction

