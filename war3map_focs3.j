    set udg_C3Rskillu=GetLastCreatedUnit()
    call PolledWait(4.00)
    if ( Trig_C1_Bombing2________2_Func005C() ) then
        call SetUnitVertexColorBJ(udg_C3Rskillu, 100, 100, 100, 0.00)
        if ( Trig_C1_Bombing2________2_Func005Func003C() ) then
            call IssueImmediateOrderBJ(udg_C3Rskillu, "stomp")
        else
            if ( Trig_C1_Bombing2________2_Func005Func003Func002C() ) then
                call IncUnitAbilityLevelSwapped('A0C4', udg_C3Rskillu)
                call IssueImmediateOrderBJ(udg_C3Rskillu, "stomp")
            else
                if ( Trig_C1_Bombing2________2_Func005Func003Func002Func004C() ) then
                    call IncUnitAbilityLevelSwapped('A0C4', udg_C3Rskillu)
                    call IncUnitAbilityLevelSwapped('A0C4', udg_C3Rskillu)
                    call IssueImmediateOrderBJ(udg_C3Rskillu, "stomp")
                else
                endif
            endif
        endif
    else
        call SetUnitVertexColorBJ(udg_C3Rskillu, 100, 100, 100, 100.00)
    endif
