function Trig_killbonus_Func002C takes nothing returns boolean
    if ( ( GetDyingUnit() == udg_WichiUnit[1] ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_WichiUnit[2] ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_WichiUnit[3] ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_WichiUnit[4] ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_WichiUnit[5] ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_WichiUnit[6] ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_WichiUnit[7] ) ) then
        return true
    endif
    if ( ( GetDyingUnit() == udg_WichiUnit[8] ) ) then
        return true
    endif
    return false
endfunction

function Trig_killbonus_Conditions takes nothing returns boolean
    if ( not Trig_killbonus_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_killbonus_Func001Func001C takes nothing returns boolean
    if ( not ( GetHeroLevel(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]) > GetHeroLevel(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) ) ) then
        return false
    endif
    if ( not ( ( GetHeroLevel(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]) - GetHeroLevel(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) ) >= 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_killbonus_Func001Func005C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(0) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(1) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(2) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(3) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(4) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(5) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(6) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(7) ) ) then
        return true
    endif
    return false
endfunction

function Trig_killbonus_Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetDyingUnit(), GetOwningPlayer(GetKillingUnitBJ())) == true ) ) then
        return false
    endif
    if ( not ( RectContainsUnit(gg_rct________199, GetDyingUnit()) == false ) ) then
        return false
    endif
    if ( not ( RectContainsUnit(gg_rct________187, GetDyingUnit()) == false ) ) then
        return false
    endif
    if ( not Trig_killbonus_Func001Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_killbonus_Actions takes nothing returns nothing
    if ( Trig_killbonus_Func001C() ) then
        if ( Trig_killbonus_Func001Func001C() ) then
            call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(GetOwningPlayer(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))])) + ( "의 역전 킬! " + ( "(추가 금 : " + ( I2S(( 150 * ( GetHeroLevel(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]) - GetHeroLevel(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) ) )) + " )" ) ) ) ))
            call AdjustPlayerStateBJ(( 150 * ( GetHeroLevel(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]) - GetHeroLevel(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) ) ), GetOwningPlayer(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]), PLAYER_STATE_RESOURCE_GOLD)
            call DisableTrigger(GetTriggeringTrigger())
        else
        endif
    else
    endif
endfunction

