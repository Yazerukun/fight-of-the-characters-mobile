function Trig_Neji_T_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Neji_T_Func003Func002001003001 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) != true )
endfunction

function Trig_Neji_T_Func003Func002001003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Neji_U)) == true )
endfunction

function Trig_Neji_T_Func003Func002001003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitDeadBJ(GetFilterUnit()) != true), (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Neji_U)) == true)) // INLINED!!
endfunction

function Trig_Neji_T_Func003Func002A takes nothing returns nothing
    set udg_Neji_L[6]=GetUnitLoc(GetEnumUnit())
    set udg_Neji_L[7]=PolarProjectionBJ(udg_Neji_L[6], 200.00, AngleBetweenPoints(udg_Neji_L[6], udg_Neji_L[3]))
    call KnockBack(GetEnumUnit() , udg_Neji_L[7] , 1.00 , 0.02)
    call RemoveLocation(udg_Neji_L[6])
    call RemoveLocation(udg_Neji_L[7])
endfunction

function Trig_Neji_T_Func003C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(udg_Neji_U, 'I01A') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Neji_T_Actions takes nothing returns nothing
    set udg_Neji_U=GetTriggerUnit()
    set udg_Neji_L[3]=GetUnitLoc(udg_Neji_U)
    if ( Trig_Neji_T_Func003C() ) then
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(500.00, udg_Neji_L[3], Condition(function Trig_Neji_T_Func003Func002001003)), function Trig_Neji_T_Func003Func002A)
    else
    endif
    call StartTimerBJ(udg_Neji_T[0], true, 0.05)
endfunction

