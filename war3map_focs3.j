function Trig_MadaraE_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundBJ(gg_snd_MadaraE)
    set udg_MadaraE1=GetSpellAbilityUnit()
    set udg_MadaraE2=GetSpellTargetUnit()
    call TriggerSleepAction(1.00)
    if ( Trig_MadaraE_Func006C() ) then
        call AddSpecialEffectTargetUnitBJ("origin", udg_MadaraE2, "RikudoMadara_Gudotan1.mdx")
        set udg_MadaraEE=GetLastCreatedEffectBJ()
        set udg_MadaraEL2=GetUnitLoc(udg_MadaraE2)
