                call IssuePointOrderLocBJ(GetLastCreatedUnit(), "dreadlordinferno", udg_iceUnit2C)
                call SetUnitAnimation(GetLastCreatedUnit(), "birth")
            else
            endif
        endif
    endif
    set bj_forLoopAIndex=1
