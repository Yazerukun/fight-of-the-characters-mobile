        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "WarStompCaster.mdx")
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
        call RemoveLocation(udg_Kaido_L[10])
        // -------------------------------
        set udg_Kaido_I[0]=22
        set udg_Kaido_I[0]=( udg_Kaido_I[0] * udg_Kaido_I[3] )
        set udg_Kaido_L[11]=PolarProjectionBJ(udg_Kaido_L[1], ( 140.00 * I2R(udg_Kaido_I[3]) ), ( AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]) - 338.00 ))
