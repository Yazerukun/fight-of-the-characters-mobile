//===========================================================================
// Trigger: Loop
//===========================================================================
function Trig_Loop_Func002C takes nothing returns boolean
    if ( not ( IsUnitType(udg_RSkillClare, UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B00X') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B029') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B00V') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B00T') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B00H') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B01A') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'BSTN') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'BPSE') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B032') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B02O') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'Bmlt') != true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_RSkillClarec, udg_RSkillClare2) >= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Loop_Actions takes nothing returns nothing
    set udg_RSkillClarec=GetUnitLoc(udg_RSkillClare)
    if ( Trig_Loop_Func002C() ) then
        call SetUnitPositionLocFacingBJ(udg_RSkillClare, PolarProjectionBJ(udg_RSkillClarec, 20.00, ( udg_Angle + 180.00 )), ( udg_Angle + 180.00 ))
        call StartTimerBJ(udg_Aaa[41], false, 0.02)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call SetUnitPathing(udg_RSkillClare, true)
        call DisableTrigger(gg_trg_Loop1)
        call ResetUnitAnimation(udg_RSkillClare)
        call RemoveLocation(udg_RSkillClare2)
    endif
    call RemoveLocation(udg_RSkillClarec)
endfunction

