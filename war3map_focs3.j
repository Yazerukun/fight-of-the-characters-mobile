    return ( GetUnitTypeId(GetFilterUnit()) == 'h029' )
endfunction

function Trig_MSDteachE2_Func007A takes nothing returns nothing
    set udg_MSDteachEml=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_MSDteachEml, "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_MSDteachEml)
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_MSDteachE2_Actions takes nothing returns nothing
    call PauseTimerBJ(true, udg_MSDteachEt2)
    set udg_MSDteachEb=false
    call DisableTrigger(gg_trg_MSDteachE3)
    call TerrainDeformationCraterBJ(0.5, true, udg_MSDteachEl, 400.00, - 200.00)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetEntireMapRect(), Condition(function Trig_MSDteachE2_Func007001002)), function Trig_MSDteachE2_Func007A)
    call GroupClear(udg_MSDteachEug)
    call GroupClear(udg_MSDteachEug2)
    call RemoveLocation(udg_MSDteachEl)
