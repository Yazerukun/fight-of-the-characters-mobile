//===========================================================================
function Trig_ColdA________3_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0Q4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ColdA________3_Actions takes nothing returns nothing
    set udg_ColdIc=0
    set udg_ColdIcC=0.00
    set udg_ColdU2c=GetSpellAbilityUnit()
    set udg_ColdLCc=GetSpellTargetLoc()
    set udg_ColdREc=AngleBetweenPoints(Location(GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit())), udg_ColdLCc)
    call CreateNUnitsAtLoc(1, 'e09T', GetOwningPlayer(GetSpellAbilityUnit()), Location(GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit())), udg_ColdREc)
    set udg_ColdUc=GetLastCreatedUnit()
    set udg_ColdLCc2=GetUnitLoc(udg_ColdUc)
    call CreateNUnitsAtLoc(1, 'e09S', GetOwningPlayer(udg_ColdUc), udg_ColdLCc2, udg_ColdREc)
    call RemoveLocation(udg_ColdLCc2)
    call StartTimerBJ(udg_ColdTc, true, 0.02)
endfunction

//===========================================================================
