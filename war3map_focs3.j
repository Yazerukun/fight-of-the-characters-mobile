// Trigger: Loopc3 2
//===========================================================================
function Trig_Loopc3_2_Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_C2Qskillu2cc, udg_C2Qskill2_u) >= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Loopc3_2_Actions takes nothing returns nothing
    set udg_C2Qskill2u2ccc=GetUnitLoc(udg_C2Qskill2u2)
    set udg_C2Qskillu2cc=GetUnitLoc(udg_C2Qskillu2)
    if ( Trig_Loopc3_2_Func003C() ) then
        call SetUnitPathing(udg_C2Qskillu2, false)
        call SetUnitPathing(udg_C2Qskill2u2, false)
        call SetUnitPositionLocFacingBJ(udg_C2Qskillu2, PolarProjectionBJ(udg_C2Qskill2u2ccc, 25.00, ( AngleBetweenPoints(udg_C2Qskill2u2ccc, udg_C2Qskillu2cc) - 1.00 )), 0.00)
        set udg_Angle2u2=AngleBetweenPoints(udg_C2Qskill2u2ccc, udg_C2Qskill2_u)
        call SetUnitPositionLocFacingBJ(udg_C2Qskill2u2, PolarProjectionBJ(udg_C2Qskill2u2ccc, 7.50, ( udg_Angle2u2 + 0.00 )), ( udg_Angle2u2 + 0.00 ))
    else
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_Loopc3_2_______u)
        call SetUnitPathing(udg_C2Qskill2u2, true)
        call RemoveLocation(udg_C2Qskill2_u)
        set udg_C2Qskill2u2=null
    endif
    call RemoveLocation(udg_C2Qskill2u2ccc)
    call RemoveLocation(udg_C2Qskillu2cc)
    call StartTimerBJ(udg_Aaa[33], false, 0.01)
endfunction

