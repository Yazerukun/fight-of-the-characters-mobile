function Trig_sair2_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_SaiR3)
    set udg_SaiR2=GetUnitLoc(GetTriggerUnit())
    call AddSpecialEffectLocBJ(udg_SaiR2, "war3mapImported\\DarkLightningNova.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'e08C', GetOwningPlayer(GetTriggerUnit()), udg_SaiR2, bj_UNIT_FACING)
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 200.00)
    call CreateNUnitsAtLoc(1, 'e08C', GetOwningPlayer(GetTriggerUnit()), udg_SaiR2, bj_UNIT_FACING)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call vibration(ConvertedPlayer(GetForLoopIndexA()) , 12.00 , 2.50)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction(0.20)
    call RemoveUnit(GetTriggerUnit())
    call RemoveLocation(udg_SaiR2)
    call RemoveUnit(udg_SaiR3[1])
    call RemoveUnit(udg_SaiR3[2])
    call RemoveUnit(udg_SaiR3[3])
    set udg_SaiR3[1]=null
    set udg_SaiR3[2]=null
    set udg_SaiR3[3]=null
endfunction

