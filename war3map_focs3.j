    call DisableTrigger(gg_trg_chunneon14)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_chunneon14, udg_Aaa[28])
    call TriggerAddAction(gg_trg_chunneon14, function Trig_chunneon14_Actions)
endfunction

