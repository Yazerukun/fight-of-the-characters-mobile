function cK takes nothing returns nothing
//킬수가 채워져 끝나는 경우
	call TriggerExecute(gg_trg_gameendmap)
	call DestroyTrigger(udg_trigger08)
	call DisableTrigger(udg_trigger07)
	call DisableTrigger(gg_trg_gob2)
	call DestroyTrigger(gg_trg_gob2)
	call StopSoundBJ(udg_sound36, false)
	call PlaySoundAtPointBJ(udg_sound35, 'd', GetRectCenter(udg_rect09), 0)
	call PauseAllUnitsBJ(true)
	call DestroyTrigger(udg_trigger26)
	set bj_wantDestroyGroup=true
	call ForGroupBJ(aJ(bj_mapInitialPlayableArea), function Jk)
	if ( (udg_integer93 >= udg_integer118) ) then // INLINED!!
		call TriggerExecute(gg_trg_RW)
		call TriggerSleepAction(5)
		call CreateTextTagLocBJ("승리 !!", GetRectCenter(udg_rect09), 0, 25., .0, 'd', 'd', 75.)
		call CreateTextTagLocBJ("패배 !!", GetRectCenter(udg_rect10), 0, 25., 'd', .0, .0, 75.)
		call ForForce(BJ(Player(0)), function rK)
		call ForForce(BJ(Player(4)), function OK)
		call TriggerSleepAction(2)
		call ForForce(BJ(Player(4)), function AK)
		call TriggerSleepAction(3)
		call ForForce(BJ(Player(0)), function NK)
		call ForForce(BJ(Player(4)), function bK)
	else
		if ( (udg_integer94 >= udg_integer118) ) then // INLINED!!
			call TriggerExecute(gg_trg_BW)
			call TriggerSleepAction(5)
			call CreateTextTagLocBJ("승리 !!", GetRectCenter(udg_rect10), 0, 25., .0, 'd', 'd', 75.)
			call CreateTextTagLocBJ("패배 !!", GetRectCenter(udg_rect09), 0, 25., 'd', .0, .0, 75.)
			call ForForce(BJ(Player(0)), function pk)
			call ForForce(BJ(Player(4)), function Tk)
			call TriggerSleepAction(2)
			call ForForce(BJ(Player(0)), function wk)
			call TriggerSleepAction(3)
			call ForForce(BJ(Player(0)), function Wk)
			call ForForce(BJ(Player(4)), function yk)
		endif
	endif
endfunction

