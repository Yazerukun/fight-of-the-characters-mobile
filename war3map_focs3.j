        return false
    endif
    return true
endfunction

function Trig_getsuga01_Actions takes nothing returns nothing
    if ( Trig_getsuga01_Func001C() ) then
        set udg_Angle5u=( udg_Angle5u + 5.25 )
        call SetUnitScalePercent(udg_Getsuga2, ( udg_Angle5u + 0.00 ), ( udg_Angle5u + 0.00 ), ( udg_Angle5u + 0.00 ))
        call SetUnitPathing(udg_Getsuga2, false)
        call SetUnitPositionLocFacingBJ(udg_Getsuga2, PolarProjectionBJ(GetUnitLoc(udg_Getsuga2), 30.00, ( udg_Angle5 + 180.00 )), ( udg_Angle5 + 180.00 ))
        call StartTimerBJ(udg_Aaa[25], false, 0.03)
    else
        call RemoveUnit(udg_Getsuga2)
        call DisableTrigger(GetTriggeringTrigger())
    endif
endfunction

