function Trig_brouto_R_1_Actions takes nothing returns nothing
    set udg_broutointger[2]=( udg_broutointger[2] + 1 )
    set udg_broutointger[1]=( udg_broutointger[1] + 1 )
    set udg_broutoreal[3]=( udg_broutoreal[3] + 20.00 )
    set udg_broutoloc[41]=PolarProjectionBJ(GetUnitLoc(udg_brouto[90]), 30.00, GetUnitFacing(udg_brouto[90]))
    call SetUnitPositionLoc(udg_brouto[90], udg_broutoloc[41])
    call RemoveLocation(udg_broutoloc[41])
    set udg_broutoloc[41]=GetUnitLoc(udg_brouto[90])
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(450.00, udg_broutoloc[41], Condition(function Trig_brouto_R_1_Func008001003)), function Trig_brouto_R_1_Func008A)
