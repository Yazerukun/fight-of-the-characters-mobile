function Trig_bugfix11_______u_Func005C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetLevelingUnit()) >= 25 ) ) then
        return false
    endif
    return true
endfunction

function Trig_bugfix11_______u_Actions takes nothing returns nothing
    if ( Trig_bugfix11_______u_Func002C() ) then
        call SetPlayerAbilityAvailableBJ(true, 'A0OF', GetOwningPlayer(GetLevelingUnit()))
    else
    endif
    if ( Trig_bugfix11_______u_Func003C() ) then
        call SetPlayerAbilityAvailableBJ(true, 'A0OS', GetOwningPlayer(GetLevelingUnit()))
    else
    endif
    if ( Trig_bugfix11_______u_Func004C() ) then
        call SetPlayerAbilityAvailableBJ(true, 'A0OO', GetOwningPlayer(GetLevelingUnit()))
    else
    endif
    if ( Trig_bugfix11_______u_Func005C() ) then
        call SetPlayerAbilityAvailableBJ(true, 'A0OP', GetOwningPlayer(GetLevelingUnit()))
        call DestroyTrigger(GetTriggeringTrigger())
    else
    endif
