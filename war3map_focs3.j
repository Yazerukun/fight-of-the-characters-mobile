    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(udg_KenR9, GetUnitLoc(udg_KenR1)), function Trig_kenRskil2_Func004A)
    if ( Trig_kenRskil2_Func005C() ) then
        set bj_wantDestroyGroup=true
