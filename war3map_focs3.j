            call CreateNUnitsAtLoc(1, 'e00Y', GetOwningPlayer(udg_AasaaUnit1), PolarProjectionBJ(udg_AasaaUnit2copy, 50.00, ( I2R(GetForLoopIndexA()) * 45.00 )), bj_UNIT_FACING)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        if ( Trig_chidori5_Func001Func012C() ) then
            call CreateNUnitsAtLoc(1, 'e03X', GetOwningPlayer(udg_AasaaUnit1), udg_AasaaUnit2copy, bj_UNIT_FACING)
            call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_AasaaUnit2)
