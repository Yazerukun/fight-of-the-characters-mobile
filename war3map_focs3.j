    return ( IsUnitEnemy(udg_Muljiok_uC_______u, GetOwningPlayer(GetFilterUnit())) == true )
endfunction

function Trig_SaMak2________3_Func004Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B000') == false ) ) then
        return false
    endif
    if ( not ( SubStringBJ(GetUnitName(GetEnumUnit()), 1, 6) != "거미" ) ) then
        return false
    endif
    if ( not ( SubStringBJ(GetUnitName(GetEnumUnit()), 1, 6) != "백조" ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'n012' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O003' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'H01G' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O00C' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O00D' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O00E' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'e058' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'e08A' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'nspb' ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B03F') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B02Y') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B03E') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B02Q') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'BPSE') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SaMak2________3_Func004A takes nothing returns nothing
    if ( Trig_SaMak2________3_Func004Func001C() ) then
        call IssueImmediateOrderBJ(GetEnumUnit(), "stop")
        set udg_MuljiokC2_______u=GetUnitLoc(GetEnumUnit())
        call SetUnitPositionLoc(GetEnumUnit(), PolarProjectionBJ(udg_MuljiokC2_______u, 8.00, ( AngleBetweenPoints(udg_MuljiokC_______u, udg_MuljiokC2_______u) - 180.00 )))
        call RemoveLocation(udg_MuljiokC2_______u)
    else
    endif
endfunction

function Trig_SaMak2________3_Actions takes nothing returns nothing
    call AddSpecialEffectLocBJ(PolarProjectionBJ(udg_MuljiokC_______u, GetRandomReal(0, 300.00), GetRandomReal(0, 360.00)), "BloodFiendBurst.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_MuljiokC_______u, Condition(function Trig_SaMak2________3_Func004001003)), function Trig_SaMak2________3_Func004A)
