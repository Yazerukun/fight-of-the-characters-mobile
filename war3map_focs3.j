function Trig_Loop_______u_Func002C takes nothing returns boolean
    if ( not ( IsUnitType(udg_RSkillDei, UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillDei, 'B00X') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillDei, 'B029') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillDei, 'B00V') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillDei, 'B00T') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillDei, 'B00H') != true ) ) then
