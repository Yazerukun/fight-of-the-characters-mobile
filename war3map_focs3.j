//===========================================================================
// Trigger: izenD
//===========================================================================
function Trig_izenD_Conditions takes nothing returns boolean
    if ( not ( GetEventDamage() != 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_izenD_Actions takes nothing returns nothing
    set udg_IZEND[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))]=( udg_IZEND[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))] + ( GetEventDamage() * 0.10 ) )
endfunction

//===========================================================================
function InitTrig_izenD takes nothing returns nothing
    set gg_trg_izenD=CreateTrigger()
    call TriggerAddCondition(gg_trg_izenD, Condition(function Trig_izenD_Conditions))
    call TriggerAddAction(gg_trg_izenD, function Trig_izenD_Actions)
endfunction

//===========================================================================
// Trigger: dig3 복사
//===========================================================================
function Trig_dig3_______u_Func008Func019001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'Osam' )
endfunction

function Trig_dig3_______u_Func008Func019A takes nothing returns nothing
    call TriggerRegisterUnitEvent(gg_trg_izenD, GetEnumUnit(), EVENT_UNIT_DAMAGED)
endfunction

function Trig_dig3_______u_Func008C takes nothing returns boolean
    if ( not ( udg_Duel[1] >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_dig3_______u_Actions takes nothing returns nothing
    call DestroyTrigger(udg_trigger98)
    call DestroyTrigger(udg_trigger99)
    call DestroyTrigger(udg_trigger100)
    call DestroyTrigger(udg_trigger101)
    call DestroyTrigger(udg_trigger102)
    call DestroyTrigger(udg_trigger103)
    call DestroyTrigger(udg_trigger104)
    if ( Trig_dig3_______u_Func008C() ) then
        call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_8660")
        set udg_unit192=null
        call StartTimerBJ(udg_ScoreEnd, false, 1440.00)
        call StartTimerBJ(udg_ScoreEnd2, true, 300.00)
        call CreateTimerDialogBJ(udg_ScoreEnd, "TRIGSTR_8661")
        call TimerDialogDisplayBJ(true, GetLastCreatedTimerDialogBJ())
        call EnableTrigger(gg_trg_killsound)
        call EnableTrigger(gg_trg_killsound2)
        call EnableTrigger(gg_trg_deathsound)
        call EnableTrigger(gg_trg_winsound)
        call EnableTrigger(gg_trg_losssound)
        call EnableTrigger(gg_trg_scoremob)
        call EnableTrigger(gg_trg_scorekillb)
        call EnableTrigger(gg_trg_scorekillr)
        call TriggerExecute(gg_trg_multiboard2_____________________u)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_dig3_______u_Func008Func019001002)), function Trig_dig3_______u_Func008Func019A)
        call DestroyTrigger(udg_trigger08)
    else
        call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_8619")
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call MultiboardSetItemStyleBJ(GetLastCreatedMultiboard(), 4, GetForLoopIndexA(), false, false)
            call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(), 4, GetForLoopIndexA(), 0.01)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    endif
endfunction

//===========================================================================
function InitTrig_dig3_______u takes nothing returns nothing
    set gg_trg_dig3_______u=CreateTrigger()
