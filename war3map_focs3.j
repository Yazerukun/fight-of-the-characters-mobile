function Trig_Zombiebear_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttacker()) == 'N01Y' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zombiebear_Func003Func007C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0MO', udg_BladU_______u) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zombiebear_Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0MO', udg_BladU_______u) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Zombiebear_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call vibration(ConvertedPlayer(GetForLoopIndexA()) , 3.00 , 0.25)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    if ( Trig_Zombiebear_Func003C() ) then
        set udg_ZoroV_8=GetUnitLoc(GetAttacker())
        call CreateNUnitsAtLoc(1, 'e087', GetOwningPlayer(udg_BladU_______u), udg_ZoroV_8, 0.00)
        call RemoveLocation(udg_ZoroV_8)
        set udg_ZoroV_8=GetUnitLoc(GetAttackedUnitBJ())
        call IncUnitAbilityLevelSwapped('A0MN', GetLastCreatedUnit())
        call IncUnitAbilityLevelSwapped('A0MN', GetLastCreatedUnit())
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "stampede", udg_ZoroV_8)
        call RemoveLocation(udg_ZoroV_8)
    else
        if ( Trig_Zombiebear_Func003Func007C() ) then
            set udg_ZoroV_8=GetUnitLoc(GetAttacker())
            call CreateNUnitsAtLoc(1, 'e087', GetOwningPlayer(udg_BladU_______u), udg_ZoroV_8, 0.00)
            call RemoveLocation(udg_ZoroV_8)
            set udg_ZoroV_8=GetUnitLoc(GetAttackedUnitBJ())
            call IncUnitAbilityLevelSwapped('A0MN', GetLastCreatedUnit())
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "stampede", udg_ZoroV_8)
            call RemoveLocation(udg_ZoroV_8)
        else
            set udg_ZoroV_8=GetUnitLoc(GetAttacker())
            call CreateNUnitsAtLoc(1, 'e087', GetOwningPlayer(udg_BladU_______u), udg_ZoroV_8, 0.00)
            call RemoveLocation(udg_ZoroV_8)
            set udg_ZoroV_8=GetUnitLoc(GetAttackedUnitBJ())
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "stampede", udg_ZoroV_8)
            call RemoveLocation(udg_ZoroV_8)
        endif
    endif
    call TriggerSleepAction(0.25)
    call EnableTrigger(GetTriggeringTrigger())
endfunction

