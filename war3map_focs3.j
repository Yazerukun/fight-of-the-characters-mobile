function Trig_DuelStartSet1_Actions takes nothing returns nothing
    call DestroyTimerDialogBJ(udg_GameDuelTimer4)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_DuelStartSet1_Func003A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_DuelStartSet1_Func006A)
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_12553")
    call TriggerSleepAction(10.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_DuelStartSet1_Func009Func001C() ) then
            call ReviveHeroLoc(udg_WichiUnit[GetForLoopIndexA()], GetPlayerStartLocationLoc(GetOwningPlayer(udg_WichiUnit[GetForLoopIndexA()])), true)
        else
        endif
        call SetUnitLifePercentBJ(udg_WichiUnit[GetForLoopIndexA()], 100)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_DuelStartSet1_Func010Func001C() ) then
            set udg_GameDuelTeamRed=( udg_GameDuelTeamRed + 1 )
        else
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=5
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_DuelStartSet1_Func011Func001C() ) then
            set udg_GameDuelTeamBlue=( udg_GameDuelTeamBlue + 1 )
        else
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call StartTimerBJ(udg_GameDuelTimer, false, 60.00)
    call CreateTimerDialogBJ(udg_GameDuelTimer, "TRIGSTR_12560")
    set udg_GameDuelTimer3=GetLastCreatedTimerDialogBJ()
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call TimerDialogDisplayForPlayerBJ(true, udg_GameDuelTimer3, ConvertedPlayer(GetForLoopIndexA()))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call DisplayTextToForce(GetPlayersAll(), ( "|cffff4500(!)레드팀 생명 : " + I2S(udg_GameDuelTeamRed) ))
    call DisplayTextToForce(GetPlayersAll(), ( "|cff1e90ff(!)블루팀 생명 : " + I2S(udg_GameDuelTeamBlue) ))
    set udg_GameDuelNalsee=GetRandomInt(1, 2)
    if ( Trig_DuelStartSet1_Func019C() ) then
        call AddWeatherEffectSaveLast(gg_rct_DuelZone, 'RAlr')
        call EnableWeatherEffect(GetLastCreatedWeatherEffect(), true)
        call SetTerrainTypeBJ(GetRectCenter(gg_rct_DuelMap1), 'Lgrs', - 1, 10, 1)
        call SetTerrainTypeBJ(GetRectCenter(gg_rct_DuelMap2), 'Lgrs', - 1, 10, 1)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=30
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_DuelZonNamoo1[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
            set udg_DuelZonNamoo2[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
            set udg_DuelZonNamoo3[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
            call CreateDestructableLoc('LTlt', udg_DuelZonNamoo1[GetForLoopIndexA()], GetRandomDirectionDeg(), GetRandomReal(0.80, 1.60), GetRandomInt(1, 10))
            call CreateDestructableLoc('ZTtw', udg_DuelZonNamoo2[GetForLoopIndexA()], GetRandomDirectionDeg(), GetRandomReal(0.80, 1.60), GetRandomInt(1, 10))
            call CreateDestructableLoc('YTct', udg_DuelZonNamoo3[GetForLoopIndexA()], GetRandomDirectionDeg(), GetRandomReal(0.80, 1.60), GetRandomInt(1, 10))
            call RemoveLocation(udg_DuelZonNamoo1[GetForLoopIndexA()])
            call RemoveLocation(udg_DuelZonNamoo2[GetForLoopIndexA()])
            call RemoveLocation(udg_DuelZonNamoo3[GetForLoopIndexA()])
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    else
        call AddWeatherEffectSaveLast(gg_rct_DuelZone, 'SNls')
        call EnableWeatherEffect(GetLastCreatedWeatherEffect(), true)
        call SetTerrainTypeBJ(GetRectCenter(gg_rct_DuelMap1), 'Isnw', - 1, 10, 1)
        call SetTerrainTypeBJ(GetRectCenter(gg_rct_DuelMap2), 'Isnw', - 1, 10, 1)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=30
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_DuelZonNamoo1[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
            set udg_DuelZonNamoo2[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
            set udg_DuelZonNamoo3[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
            call CreateDestructableLoc('ITtw', udg_DuelZonNamoo1[GetForLoopIndexA()], GetRandomDirectionDeg(), GetRandomReal(0.80, 1.60), GetRandomInt(1, 10))
            call CreateDestructableLoc('WTtw', udg_DuelZonNamoo2[GetForLoopIndexA()], GetRandomDirectionDeg(), GetRandomReal(0.80, 1.60), GetRandomInt(1, 10))
            call CreateDestructableLoc('WTst', udg_DuelZonNamoo3[GetForLoopIndexA()], GetRandomDirectionDeg(), GetRandomReal(0.80, 1.60), GetRandomInt(1, 10))
            call RemoveLocation(udg_DuelZonNamoo1[GetForLoopIndexA()])
            call RemoveLocation(udg_DuelZonNamoo2[GetForLoopIndexA()])
            call RemoveLocation(udg_DuelZonNamoo3[GetForLoopIndexA()])
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    endif
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_12554")
    call DisableTrigger(gg_trg_DuelZoneSkill)
    call DisableTrigger(gg_trg_DuelZoneDontMove1)
    call DisableTrigger(gg_trg_DuelZoneDontMove2)
    call DisableTrigger(gg_trg_DuelZoneDontMove3)
    call EnableTrigger(gg_trg_DuelZoneDontMove4)
    call EnableTrigger(gg_trg_DuelZoneDontMove5)
    call EnableTrigger(gg_trg_DuelZoneDontMove6)
    call EnableTrigger(gg_trg_DuelTaget1)
    call EnableTrigger(gg_trg_DuelTaget2)
    set udg_GameDuelOn=true
    set udg_SimpanPC2=1
    set udg_DftCamera[0]=GetRectCenter(gg_rct_SelZoneCenter)
    set udg_DftCamera[11]=GetRectCenter(gg_rct_DuelZoneLeft)
    set udg_DftCamera[12]=GetRectCenter(gg_rct_DuelZoneRight)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call RemoveLocation(udg_DftCamera2[GetForLoopIndexA()])
        set udg_DftCamera2[GetForLoopIndexA()]=GetRectCenter(gg_rct_SelZoneCenter)
        call StartTimerBJ(udg_SimpanT[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))], true, 0.05)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_DuelStartSet1_Func036Func001C() ) then
            set udg_SimpanPC2=GetForLoopIndexA()
            set udg_SimpanPC[GetForLoopIndexA()]=GetForLoopIndexA()
        else
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_DuelStartSet1_Func037Func001C() ) then
            set udg_SimpanNC[GetConvertedPlayerId(GetTriggerPlayer())]=true
            set udg_SimpanPC[GetForLoopIndexA()]=udg_SimpanPC2
        else
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_DuelStartSet1_Func039A)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_DuelStartSet1_Func041A)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=2
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_DuelZonNamoo1[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
        set udg_DuelZonNamoo2[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
        set udg_DuelZonNamoo3[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
        set udg_DuelZonNamoo4[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
        set udg_DuelZonNamoo5[GetForLoopIndexA()]=GetRandomLocInRect(gg_rct_DuelZone)
        call CreateItemLoc('I01X', udg_DuelZonNamoo1[GetForLoopIndexA()])
        call CreateItemLoc('I01Z', udg_DuelZonNamoo2[GetForLoopIndexA()])
        call CreateItemLoc('I022', udg_DuelZonNamoo3[GetForLoopIndexA()])
        call CreateItemLoc('I023', udg_DuelZonNamoo4[GetForLoopIndexA()])
        call CreateItemLoc('I021', udg_DuelZonNamoo4[GetForLoopIndexA()])
        call RemoveLocation(udg_DuelZonNamoo1[GetForLoopIndexA()])
        call RemoveLocation(udg_DuelZonNamoo2[GetForLoopIndexA()])
        call RemoveLocation(udg_DuelZonNamoo3[GetForLoopIndexA()])
        call RemoveLocation(udg_DuelZonNamoo4[GetForLoopIndexA()])
        call RemoveLocation(udg_DuelZonNamoo5[GetForLoopIndexA()])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

