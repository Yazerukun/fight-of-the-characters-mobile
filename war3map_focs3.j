//===========================================================================
function Trig_Loopc3_Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_C2Qskill2u2ccc, udg_C2Qskillu2cc) >= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Loopc3_Actions takes nothing returns nothing
    set udg_C2Qskill2u2ccc=GetUnitLoc(udg_C2Qskill2u2)
    set udg_C2Qskillu2cc=GetUnitLoc(udg_C2Qskillu2)
    if ( Trig_Loopc3_Func003C() ) then
        set udg_Angle2u2=AngleBetweenPoints(udg_C2Qskill2u2ccc, udg_C2Qskillu2cc)
        call SetUnitPathing(udg_C2Qskillu2, false)
        call SetUnitPositionLocFacingBJ(udg_C2Qskillu2, PolarProjectionBJ(udg_C2Qskillu2cc, 10.00, ( udg_Angle2u2 + 180.00 )), ( udg_Angle2u2 + 180.00 ))
    else
        call DisableTrigger(GetTriggeringTrigger())
        call EnableTrigger(gg_trg_Loopc3_2)
        call StartTimerBJ(udg_Aaa[33], false, 0.01)
        call EnableTrigger(gg_trg_Loopc3_2_______u)
        call StartTimerBJ(udg_Aaa[34], false, 0.25)
        call TriggerExecute(gg_trg_skillhoghk)
    endif
    call RemoveLocation(udg_C2Qskill2u2ccc)
    call RemoveLocation(udg_C2Qskillu2cc)
    call StartTimerBJ(udg_Aaa[32], false, 0.01)
endfunction

