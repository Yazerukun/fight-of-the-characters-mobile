    call MultiboardSetItemIconBJ(GetLastCreatedMultiboard(), 2, 6, "ReplaceableTextures\\CommandButtons\\BTNTransmute.blp")
    call MultiboardSetItemIconBJ(GetLastCreatedMultiboard(), 1, 6, "ReplaceableTextures\\CommandButtons\\BTNMoonStone.blp")
    call MultiboardSetItemIconBJ(GetLastCreatedMultiboard(), 4, 1, "ReplaceableTextures\\CommandButtons\\BTNOrcCaptureFlag.blp")
    call MultiboardSetItemIconBJ(GetLastCreatedMultiboard(), 4, 6, "ReplaceableTextures\\CommandButtons\\BTNHumanCaptureFlag.blp")
    call StartTimerBJ(udg_ScoreTimer, true, 2.00)
endfunction

