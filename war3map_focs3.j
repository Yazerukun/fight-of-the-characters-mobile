        return false
    endif
    return true
endfunction

function Trig_Toshiro_Mone_01_Func002Func004C takes nothing returns boolean
    if ( not Trig_Toshiro_Mone_01_Func002Func004Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Toshiro_Mone_01_Func002Func010C takes nothing returns boolean
    if ( ( DistanceBetweenPoints(udg_Toshiro_Move_L[0], udg_Toshiro_Move_L[1]) <= 60.00 ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B00X') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B029') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B00V') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B00T') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B00H') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B01A') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'BSTN') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'BPSE') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B032') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B02O') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'Bmlt') == true ) ) then
        return true
    endif
