        return false
    endif
    return true
endfunction

function Trig_brouto_R_1_Func008A takes nothing returns nothing
    if ( Trig_brouto_R_1_Func008Func001C() ) then
        call UnitDamageTargetBJ(udg_brouto[4], GetEnumUnit(), ( 3000.00 + ( 1000.00 * I2R(GetUnitAbilityLevelSwapped('A0TP', udg_brouto[4])) ) ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
        call GroupAddUnitSimple(GetEnumUnit(), udg_broutOGROUP[2])
    else
    endif
