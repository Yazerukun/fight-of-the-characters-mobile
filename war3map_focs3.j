function InitTrig_Narak2 takes nothing returns nothing
    set gg_trg_Narak2=CreateTrigger()
    call DisableTrigger(gg_trg_Narak2)
    call TriggerRegisterEnterRectSimple(gg_trg_Narak2, gg_rct_BS60)
    call TriggerAddCondition(gg_trg_Narak2, Condition(function Trig_Narak2_Conditions))
    call TriggerAddAction(gg_trg_Narak2, function Trig_Narak2_Actions)
endfunction

