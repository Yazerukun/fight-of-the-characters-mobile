// 나루토
//===========================================================================
function Trig_VerSel_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'ewsp' ) ) then
        return false
    endif
    return true
endfunction

function Trig_VerSel_Actions takes nothing returns nothing
    call DestroyTrigger(GetTriggeringTrigger())
    call RemoveUnit(GetEnteringUnit())
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetEnteringUnit()), GetRectCenter(gg_rct_Sel), 0)
    call SetUnitPositionLoc(gg_unit_U004_0050, GetRectCenter(gg_rct_Sel))
    call SetUnitOwner(gg_unit_U004_0050, GetOwningPlayer(GetEnteringUnit()), true)
    call SetUnitOwner(gg_unit_e04O_0053, GetOwningPlayer(GetEnteringUnit()), true)
    call SetUnitInvulnerable(gg_unit_U004_0050, false)
    call DisplayTextToForce(GetPlayersAll(), ( "|c00ff0000" + ( GetPlayerName(GetOwningPlayer(GetEnteringUnit())) + ( "|r|c0000ffff님께서|r " + ( "|c0000ff40나루토|r|c0000ffff를 선택하셨습니다." ) ) ) ))
    call SetPlayerName(GetOwningPlayer(GetEnteringUnit()), ( GetPlayerName(GetOwningPlayer(GetEnteringUnit())) + "(나루토)" ))
	if ( (IsPlayerAlly(GetOwningPlayer(GetEnteringUnit()), Player(0))) ) then // INLINED!!
		call MultiboardSetItemIconBJ(udg_multiboard01, 1, ( ( 1 + GetPlayerId(GetOwningPlayer(GetEnteringUnit())) ) + 1 ), "ReplaceableTextures\\CommandButtons\\BTNChaosWarlockGreen.blp")
	else
		call MultiboardSetItemIconBJ(udg_multiboard01, 1, ( ( 1 + GetPlayerId(GetOwningPlayer(GetEnteringUnit())) ) + 2 ), "ReplaceableTextures\\CommandButtons\\BTNChaosWarlockGreen.blp")
	endif
endfunction

