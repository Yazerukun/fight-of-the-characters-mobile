    if ( ( GetSpellAbilityId() == 'A00K' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A071' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0HD' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Move4________2_______u_Conditions takes nothing returns boolean
