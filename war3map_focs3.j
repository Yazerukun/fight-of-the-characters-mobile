	call CreateNUnitsAtLoc(1, 'Hamg', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_MOB_LocB[2], bj_UNIT_FACING)
	call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 5., "|c0080ffff이제부터 보스를 잡으실 수 있습니다.|r")
	call TriggerExecute(gg_trg_MOBREGEN2)
endfunction

