        call RemoveLocation(udg_broutoloc[6])
        call EnableTrigger(gg_trg_brouto_q______________u)
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(250.00, udg_broutoloc[4], Condition(function Trig_brouto_q_______u_Func003Func012001003)), function Trig_brouto_q_______u_Func003Func012A)
        call StartTimerBJ(udg_broutotimer[1], false, 0.01)
