                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call CreateNUnitsAtLoc(1, 'e03P', GetOwningPlayer(udg_AasaaUnit1), PolarProjectionBJ(GetUnitLoc(udg_AasaaUnit1), 100.00, ( I2R(GetForLoopIndexA()) * 45.00 )), bj_UNIT_FACING)
