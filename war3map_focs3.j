    call TriggerRegisterAnyUnitEventBJ(gg_trg_nidoru2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_nidoru2, Condition(function Trig_nidoru2_Conditions))
    call TriggerAddAction(gg_trg_nidoru2, function Trig_nidoru2_Actions)
endfunction

