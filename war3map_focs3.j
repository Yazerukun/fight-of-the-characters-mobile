endfunction

function Rl takes nothing returns nothing
	call CreateTextTagUnitBJ(( GetObjectName(GetSpellAbilityId()) + " !!" ), GetTriggerUnit(), 0, 13., GetRandomReal(0, 100.), GetRandomReal(0, 100.), GetRandomReal(0, 100.), 0)
	call SetTextTagVelocityBJ(bj_lastCreatedTextTag, 80., 90.)
	call SetTextTagPermanentBJ(bj_lastCreatedTextTag, false)
	call SetTextTagLifespanBJ(bj_lastCreatedTextTag, 1.5)
	call SetTextTagFadepointBJ(bj_lastCreatedTextTag, .65)
endfunction

function Al takes nothing returns boolean
	return ( GetItemTypeId(GetManipulatedItem()) == 'I00F' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01K' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I003' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01R' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01G' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I00V' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I00W' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01S' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01T' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01E' )
endfunction

function Nl takes nothing returns boolean
	return ( GetItemCharges(GetManipulatedItem()) >= 1 ) and ( (( GetItemTypeId(GetManipulatedItem()) == 'I00F' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01K' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I003' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01R' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01G' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I00V' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I00W' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01S' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01T' ) or ( GetItemTypeId(GetManipulatedItem()) == 'I01E' )) ) // INLINED!!
endfunction

function bl takes nothing returns boolean
	return ( ( GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) + GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) ) <= 2 )
endfunction

function Bl takes nothing returns boolean
	return ( UnitHasItem(GetTriggerUnit(), UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) ) and ( UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex) != UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex) ) and ( GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) == GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) )
endfunction

function cl takes nothing returns boolean
	return ( (( UnitHasItem(GetTriggerUnit(), UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) ) and ( UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex) != UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex) ) and ( GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) == GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) )) ) // INLINED!!
endfunction

function Cl takes nothing returns boolean
	return ( GetItemTypeId(GetManipulatedItem()) == GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) ) and ( GetItemCharges(GetManipulatedItem()) <= 2 )
endfunction

function dl takes nothing returns nothing
	set bj_forLoopAIndex=1
	set bj_forLoopAIndexEnd=6
	loop
		exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
		if ( (( GetItemTypeId(GetManipulatedItem()) == GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) ) and ( GetItemCharges(GetManipulatedItem()) <= 2 )) ) then // INLINED!!
			set bj_forLoopBIndex=1
			set bj_forLoopBIndexEnd=6
			loop
				exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
				if ( (( UnitHasItem(GetTriggerUnit(), UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) ) and ( UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex) != UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex) ) and ( GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) == GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) )) ) then // INLINED!!
					if ( (( GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) + GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) ) <= 2) ) then // INLINED!!
						call SetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex), IMinBJ(2, ( GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) + GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) )))
						call RemoveItem(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex))
					else
						call SetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex), ( ( GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex)) + GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex)) ) - 2 ))
						call SetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopAIndex), 2)
						call UnitDropItemSlotBJ(GetTriggerUnit(), UnitItemInSlotBJ(GetTriggerUnit(), bj_forLoopBIndex), bj_forLoopAIndex)
					endif
				endif
				set bj_forLoopBIndex=bj_forLoopBIndex + 1
			endloop
		endif
		set bj_forLoopAIndex=bj_forLoopAIndex + 1
	endloop
endfunction

function fl takes nothing returns boolean
	return ( S2I(SubStringBJ(GetEventPlayerChatString(), 9, 11)) >= 50 ) and ( S2I(SubStringBJ(GetEventPlayerChatString(), 9, 11)) <= 150 )
endfunction

