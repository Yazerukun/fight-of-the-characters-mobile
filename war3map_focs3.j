function Trig_BlueBanM_Actions takes nothing returns nothing
    call EnableTrigger(gg_trg_BlueBan)
    call DestroyTextTagBJ(udg_AaBanPickText[33])
    call CreateTextTagLocBJ("TRIGSTR_11093", udg_AaBanPickTextL[33], 0, 10, GetRandomReal(25.00, 100.00), GetRandomReal(25.00, 100.00), GetRandomReal(25.00, 100.00), 0)
    set udg_AaBanPickText[33]=GetLastCreatedTextTag()
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=32
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_BlueBanM_Func005Func001C() ) then
            call DestroyTextTagBJ(udg_AaBanPickText[GetForLoopIndexA()])
            call CreateTextTagLocBJ("TRIGSTR_11286", udg_AaBanPickTextL[GetForLoopIndexA()], 0, 10, 100.00, 100.00, 0.00, 0)
            set udg_AaBanPickTextBlue[GetForLoopIndexA()]=GetLastCreatedTextTag()
        else
            if ( Trig_BlueBanM_Func005Func001Func001C() ) then
                call DestroyTextTagBJ(udg_AaBanPickText[GetForLoopIndexA()])
                call CreateTextTagLocBJ(( "◎Banned Blue|n" + I2S(GetForLoopIndexA()) ), udg_AaBanPickTextL[GetForLoopIndexA()], 0, 10, 50.00, 50.00, 100.00, 0)
                set udg_AaBanPickTextBlue[GetForLoopIndexA()]=GetLastCreatedTextTag()
            else
                if ( Trig_BlueBanM_Func005Func001Func001Func001C() ) then
                    call DestroyTextTagBJ(udg_AaBanPickText[GetForLoopIndexA()])
                    call CreateTextTagLocBJ(( "◎Banned Red|n" + I2S(GetForLoopIndexA()) ), udg_AaBanPickTextL[GetForLoopIndexA()], 0, 10, 100.00, 50.00, 50.00, 0)
                    set udg_AaBanPickTextRed[GetForLoopIndexA()]=GetLastCreatedTextTag()
                else
                endif
            endif
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=32
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_BlueBanM_Func006Func001C() ) then
            call DestroyTextTagBJ(udg_AaBanPickTextBlue[GetForLoopIndexA()])
            call DestroyTextTagBJ(udg_AaBanPickText[GetForLoopIndexA()])
            call CreateTextTagLocBJ("TRIGSTR_11253", udg_AaBanPickTextL[GetForLoopIndexA()], 0, 10, 0.00, 0.00, 100, 0)
            set udg_AaBanPickText[GetForLoopIndexA()]=GetLastCreatedTextTag()
        else
            if ( Trig_BlueBanM_Func006Func001Func005C() ) then
                call DestroyTextTagBJ(udg_AaBanPickTextRed[GetForLoopIndexA()])
                call DestroyTextTagBJ(udg_AaBanPickText[GetForLoopIndexA()])
                call CreateTextTagLocBJ("TRIGSTR_11254", udg_AaBanPickTextL[GetForLoopIndexA()], 0, 10, 100.00, 0.00, 0.00, 0)
                set udg_AaBanPickText[GetForLoopIndexA()]=GetLastCreatedTextTag()
            else
            endif
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

