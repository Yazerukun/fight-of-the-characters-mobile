// Trigger: ilgang0
//
// 조건에 아이탬중첩가능이란게 없어서 사용가능 클레스로 선택했습니다
// 변수없이 그냥 트리거 액션으로만 중첩시켜습니다
//===========================================================================
function Trig_ilgang0_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I02N' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ilgang0_Func001Func002C takes nothing returns boolean
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I00P') == true ) ) then
        return true
    endif
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02K') == true ) ) then
        return true
    endif
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02M') == true ) ) then
        return true
    endif
    if ( ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02L') == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_ilgang0_Func001Func003Func001Func001Func001C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02L') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ilgang0_Func001Func003Func001Func001C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02M') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ilgang0_Func001Func003Func001C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I02K') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ilgang0_Func001Func003C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I00P') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ilgang0_Func001C takes nothing returns boolean
    if ( not Trig_ilgang0_Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_ilgang0_Actions takes nothing returns nothing
    if ( Trig_ilgang0_Func001C() ) then
        if ( Trig_ilgang0_Func001Func003C() ) then
            call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I00P'))
            call UnitAddItemByIdSwapped('I02K', GetTriggerUnit())
        else
            if ( Trig_ilgang0_Func001Func003Func001C() ) then
                call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I02K'))
                call UnitAddItemByIdSwapped('I02M', GetTriggerUnit())
            else
                if ( Trig_ilgang0_Func001Func003Func001Func001C() ) then
                    call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I02M'))
                    call UnitAddItemByIdSwapped('I02L', GetTriggerUnit())
                else
                    if ( Trig_ilgang0_Func001Func003Func001Func001Func001C() ) then
                        call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I02L'))
                        call UnitAddItemByIdSwapped('I02P', GetTriggerUnit())
                    else
                    endif
                endif
            endif
        endif
    else
        call AdjustPlayerStateBJ(1000, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD)
    endif
endfunction

