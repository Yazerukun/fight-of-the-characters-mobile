function Trig_yunsungC_Actions takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ(true, 'A0HQ', GetOwningPlayer(GetTriggerUnit()))
    call PlaySoundBJ(gg_snd_YunsungClap)
    call PlaySoundBJ(gg_snd_v2)
    set udg_CannonIN=AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())
    call CreateNUnitsAtLoc(1, 'e053', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 50.00, ( AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc()) + 0.00 )), AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc()))
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=20
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call AddSpecialEffectLocBJ(PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), ( 50.00 * I2R(GetForLoopIndexA()) ), AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

