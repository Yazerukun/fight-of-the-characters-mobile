function Trig_DSetting3_______u_Actions takes nothing returns nothing
    if ( Trig_DSetting3_______u_Func001C() ) then
        call CreateNUnitsAtLoc(1, 'e06L', GetOwningPlayer(GetEventDamageSource()), Location(0, 0), bj_UNIT_FACING)
    else
    endif
    if ( Trig_DSetting3_______u_Func002C() ) then
        set udg_PoongCham=GetUnitLoc(GetTriggerUnit())
        call CreateNUnitsAtLoc(1, 'e06L', GetOwningPlayer(GetEventDamageSource()), udg_PoongCham, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", GetTriggerUnit())
        call RemoveLocation(udg_PoongCham)
    else
    endif
    if ( Trig_DSetting3_______u_Func003C() ) then
        set udg_inuyasaI=GetRandomInt(1, 5)
        call UnitDamageTargetBJ(udg_Inuyasa, GetTriggerUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Inuyasa, true)) * 0.50 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_ENHANCED)
    else
    endif
    if ( Trig_DSetting3_______u_Func004C() ) then
        call UnitDamageTargetBJ(udg_ZoroV, GetTriggerUnit(), ( I2R(GetHeroLevel(udg_ZoroV)) * 100.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
        call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "CrimsonWake.mdx")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    if ( Trig_DSetting3_______u_Func005C() ) then
        call GroupAddUnitSimple(GetTriggerUnit(), udg_ZoroV_2)
        call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        set udg_PoongCham=GetUnitLoc(GetTriggerUnit())
        call CreateNUnitsAtLoc(1, 'e06L', GetOwningPlayer(GetEventDamageSource()), udg_PoongCham, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", GetTriggerUnit())
        call CreateNUnitsAtLoc(1, 'e0C5', GetOwningPlayer(GetEventDamageSource()), udg_PoongCham, GetRandomDirectionDeg())
        call CreateNUnitsAtLoc(1, 'e0C5', GetOwningPlayer(GetEventDamageSource()), udg_PoongCham, GetRandomDirectionDeg())
        call RemoveLocation(udg_PoongCham)
    else
    endif
    if ( Trig_DSetting3_______u_Func006C() ) then
        set udg_ZoroV_4=GetUnitLoc(GetTriggerUnit())
        call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call CreateNUnitsAtLoc(1, 'e07D', GetOwningPlayer(GetEventDamageSource()), udg_ZoroV_4, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", GetTriggerUnit())
        call UnitDamageTargetBJ(udg_unit162, GetTriggerUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_unit162, true)) * 0.75 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        call RemoveLocation(udg_ZoroV_4)
    else
    endif
    if ( Trig_DSetting3_______u_Func007C() ) then
        call UnitDamageTargetBJ(udg_SeraceG, GetTriggerUnit(), 100.00, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
        call UnitDamageTargetBJ(udg_SeraceG, GetTriggerUnit(), I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_SeraceG, true)), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
        call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    if ( Trig_DSetting3_______u_Func008C() ) then
        set udg_BloodBo=( udg_BloodBo + 1 )
        if ( Trig_DSetting3_______u_Func008Func002C() ) then
            set udg_BloodBo=0
            if ( Trig_DSetting3_______u_Func008Func002Func002C() ) then
                set udg_Blood2=( udg_Blood2 + 1 )
                call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, ( "|c00ff0000흡혈 수 : " + I2S(udg_Blood2) ))
            else
                call DisplayTextToPlayer(GetOwningPlayer(GetEventDamageSource()), 0, 0, ( "|c00ff0000흡혈 수 : " + I2S(udg_Blood2) ))
            endif
        else
        endif
    else
    endif
    if ( Trig_DSetting3_______u_Func009C() ) then
        if ( Trig_DSetting3_______u_Func009Func001C() ) then
            call SetUnitLifeBJ(GetTriggerUnit(), ( ( GetEventDamage() * 0.50 ) + GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ))
        else
            if ( Trig_DSetting3_______u_Func009Func001Func002C() ) then
                call SetUnitLifeBJ(GetTriggerUnit(), ( ( GetEventDamage() * 0.35 ) + GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ))
            else
            endif
        endif
    else
    endif
    if ( Trig_DSetting3_______u_Func010C() ) then
        call SetUnitLifeBJ(GetTriggerUnit(), ( ( GetEventDamage() * 0.50 ) + GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ))
    else
    endif
    if ( Trig_DSetting3_______u_Func011C() ) then
        if ( Trig_DSetting3_______u_Func011Func001C() ) then
            call UnitDamageTargetBJ(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], GetTriggerUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], true)) * 0.25 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL)
        else
            call UnitDamageTargetBJ(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], GetTriggerUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], true)) * 0.50 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL)
        endif
    else
    endif
    if ( Trig_DSetting3_______u_Func012C() ) then
        set udg_Ar_Rcl=GetUnitLoc(GetTriggerUnit())
        call CreateNUnitsAtLoc(1, 'e07Y', GetOwningPlayer(GetEventDamageSource()), udg_Ar_Rcl, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", GetTriggerUnit())
        call RemoveLocation(udg_Ar_Rcl)
        if ( Trig_DSetting3_______u_Func012Func006C() ) then
            if ( Trig_DSetting3_______u_Func012Func006Func002C() ) then
                call UnitDamageTargetBJ(udg_Ar_Wu1, GetTriggerUnit(), ( 1200.00 + ( 75.00 * I2R(GetUnitLevel(udg_Ar_Wu1)) ) ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
            else
                call UnitDamageTargetBJ(udg_Ar_Wu1, GetTriggerUnit(), 2750.00, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
            endif
        else
            if ( Trig_DSetting3_______u_Func012Func006Func001C() ) then
                call UnitDamageTargetBJ(udg_Ar_Wu1, GetTriggerUnit(), ( 200.00 + ( 75.00 * I2R(GetUnitLevel(udg_Ar_Wu1)) ) ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
            else
                call UnitDamageTargetBJ(udg_Ar_Wu1, GetTriggerUnit(), 1750.00, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
            endif
        endif
        call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
        if ( Trig_DSetting3_______u_Func012Func001C() ) then
            call UnitDamageTargetBJ(udg_DeiSKu, GetTriggerUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_DeiSKu, true)) * 5.00 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL)
        else
        endif
    endif
endfunction

