//===========================================================================
// Trigger: maphackch
//===========================================================================
function Trig_maphackch_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=100
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_MapHackL=GetRandomLocInRect(GetPlayableMapRect())
        call CreateNUnitsAtLoc(1, 'e09P', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_MapHackL, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_MapHackChG)
        call CreateNUnitsAtLoc(1, 'e09P', Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_MapHackL, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_MapHackChG)
        call RemoveLocation(udg_MapHackL)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

