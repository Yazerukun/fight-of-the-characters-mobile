        return false
    endif
    return true
endfunction

function Trig_Sassuke_It_01_Func009001003001 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) != true )
endfunction

function Trig_Sassuke_It_01_Func009001003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Sassuke_It_U)) == true )
endfunction

function Trig_Sassuke_It_01_Func009001003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitDeadBJ(GetFilterUnit()) != true), (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Sassuke_It_U)) == true)) // INLINED!!
endfunction

function Trig_Sassuke_It_01_Func009A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Sassuke_It_U, GetEnumUnit(), ( 40.00 * I2R(GetHeroLevel(udg_Sassuke_It_U)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_Sassuke_It_01_Actions takes nothing returns nothing
    set udg_Sassuke_It_U=GetTriggerUnit()
    set udg_Sassuke_It_L[0]=GetSpellTargetLoc()
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Sassuke_It_U), udg_Sassuke_It_L[0], GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(1.50, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "by_wood_effect_yuzhiboyou_fire_tianzhao_fangchu_2.mdx")
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Sassuke_It_L[1]=PolarProjectionBJ(udg_Sassuke_It_L[0], 170.00, ( 60.00 * I2R(GetForLoopIndexA()) ))
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Sassuke_It_U), udg_Sassuke_It_L[1], GetRandomDirectionDeg())
        call UnitApplyTimedLifeBJ(1.50, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "by_wood_effect_yuzhiboyou_fire_tianzhao_fangchu_2.mdx")
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
        call RemoveLocation(udg_Sassuke_It_L[1])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(225.00, udg_Sassuke_It_L[0], Condition(function Trig_Sassuke_It_01_Func009001003)), function Trig_Sassuke_It_01_Func009A)
    call RemoveLocation(udg_Sassuke_It_L[0])
endfunction

