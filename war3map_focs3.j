                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
            call SetUnitPathing(udg_AasaaUnit1, true)
            set udg_AasaaUnit1=null
        endif
    else
        call DisableTrigger(gg_trg_chidori5)
        call DisableTrigger(gg_trg_chidori6)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=10
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call DestroyEffectBJ(udg_AasaaUnit5[GetForLoopIndexA()])
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        set udg_AasaaUnit2copy=GetUnitLoc(udg_AasaaUnit2)
