//===========================================================================
function Trig_Toshiro_Mone_01_Func002Func004Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'Binv') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_Toshiro_Move_U, 'B018') != true ) ) then
        return false
    endif
    return true
endfunction

