    call DestroyTrigger(GetTriggeringTrigger())
    call RemoveUnit(GetEnteringUnit())
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetEnteringUnit()), GetRectCenter(gg_rct_Sel), 0)
    call SetUnitPositionLoc(gg_unit_U004_0050, GetRectCenter(gg_rct_Sel))
    call SetUnitOwner(gg_unit_U004_0050, GetOwningPlayer(GetEnteringUnit()), true)
    call SetUnitInvulnerable(gg_unit_U004_0050, false)
    set udg_KenYes=true
endfunction

