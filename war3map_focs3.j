//===========================================================================
function Trig_C3Rskill2_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0C4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_C3Rskill2_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_C3SkillSound2)
    call SetUnitVertexColorBJ(udg_C3Rskillu, 100, 100, 100, 100.00)
    call CreateNUnitsAtLoc(1, 'e01H', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), 270.00)
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 10.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraSetEQNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()), 20.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call PolledWait(4.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraClearNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

