//===========================================================================
function Trig_SaMak________3_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0P6' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SaMak________3_Func003Func004001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h01E' )
endfunction

function Trig_SaMak________3_Func003Func004A takes nothing returns nothing
    set udg_MOL=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_MOL, "BloodFiendBurst.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_MOL)
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_SaMak________3_Func003C takes nothing returns boolean
    if ( not ( udg_Aak3 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SaMak________3_Actions takes nothing returns nothing
    set udg_integer39=( udg_integer39 - 10 )
    call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()), 0, 0, ( "|c00ff0000생명 수: " + I2S(udg_integer39) ))
    if ( Trig_SaMak________3_Func003C() ) then
        call TerrainDeformationCraterBJ(0.5, true, udg_MuljiokC_______u, 400.00, - 200.00)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(GetEntireMapRect(), Condition(function Trig_SaMak________3_Func003Func004001002)), function Trig_SaMak________3_Func003Func004A)
    else
        set udg_Aak3=true
    endif
    set udg_MuljiokC_______u=GetSpellTargetLoc()
    set udg_MuljiokCreal[8]=GetLocationX(udg_MuljiokC_______u)
    set udg_MuljiokCreal[9]=GetLocationY(udg_MuljiokC_______u)
    set udg_Muljiok_uC_______u=GetTriggerUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02J', GetOwningPlayer(udg_Muljiok_uC_______u), udg_MuljiokC_______u, udg_MuljiokC_______u)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'B025', 7)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'h01E', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(udg_MuljiokC, 400.00, ( 20.00 * I2R(GetForLoopIndexA()) )), udg_MuljiokC)
        call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100, 0.00, 0.00, 25.00)
        call SetUnitPathing(GetLastCreatedUnit(), false)
        call SetUnitPositionLocFacingLocBJ(GetLastCreatedUnit(), PolarProjectionBJ(udg_MuljiokC_______u, 400.00, ( 20.00 * I2R(GetForLoopIndexA()) )), udg_MuljiokC_______u)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TerrainDeformationCraterBJ(0.5, true, udg_MuljiokC_______u, 400.00, 200.00)
    call EnableTrigger(gg_trg_SaMak2________3)
    call StartTimerBJ(udg_Muljiok_uu3, true, 0.10)
    call StartTimerBJ(udg_Muljiok_uu2_______u, false, 10.50)
endfunction

