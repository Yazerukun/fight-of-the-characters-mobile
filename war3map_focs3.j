        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerAll(Player(5)), function Trig_SumeKung3_Func004Func005A)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerAll(Player(6)), function Trig_SumeKung3_Func004Func007A)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsOfPlayerAll(Player(7)), function Trig_SumeKung3_Func004Func009A)
