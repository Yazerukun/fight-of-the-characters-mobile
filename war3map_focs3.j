//===========================================================================
function Trig_Manneo1_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0RU' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Manneo1_Func011Func001Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0RU', udg_ManneoU) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Manneo1_Func011Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0RU', udg_ManneoU) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Manneo1_Func011C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0RU', udg_ManneoU) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Manneo1_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_Mannoee2)
    set udg_ManneoU=GetTriggerUnit()
    set udg_ManneoG=0
    set udg_ManneoZ=GetSpellTargetLoc()
    set udg_ManneoS=AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_ManneoU), "Abilities\\Weapons\\Bolt\\BoltImpact.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'e05W', GetOwningPlayer(GetTriggerUnit()), udg_ManneoZ, bj_UNIT_FACING)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'B025', 1)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "taunt")
    if ( Trig_Manneo1_Func011C() ) then
        call EnableTrigger(gg_trg_Manneo12)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call vibration(ConvertedPlayer(GetForLoopIndexA()) , 2.00 , 1.60)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    else
        if ( Trig_Manneo1_Func011Func001C() ) then
            call EnableTrigger(gg_trg_Manneo13)
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=8
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call vibration(ConvertedPlayer(GetForLoopIndexA()) , 2.00 , 3.00)
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
        else
            if ( Trig_Manneo1_Func011Func001Func003C() ) then
                call EnableTrigger(gg_trg_Manneo14)
                set bj_forLoopAIndex=1
                set bj_forLoopAIndexEnd=8
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    call vibration(ConvertedPlayer(GetForLoopIndexA()) , 2.00 , 4.40)
                    set bj_forLoopAIndex=bj_forLoopAIndex + 1
                endloop
            else
            endif
        endif
    endif
endfunction

