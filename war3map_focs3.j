    else
        if ( Trig_MadaraR_Func007Func004C() ) then
            call CreateNUnitsAtLoc(1, 'e0AK', GetOwningPlayer(udg_MadaraR[0]), udg_MadaraRL[0], udg_MadaraRT)
            set udg_MadaraR[6]=GetLastCreatedUnit()
