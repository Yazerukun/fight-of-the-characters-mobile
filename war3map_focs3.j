    call GroupAddUnitSimple(GetEnumUnit(), udg_Kaido_G[0])
    call UnitDamageTargetBJ(udg_Kaido_U, GetEnumUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_Kaido_U, true)) * 0.70 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_Kaido_Q_01_Func002Func030C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(udg_Kaido_U, 'I068') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kaido_Q_01_Func002C takes nothing returns boolean
    if ( not ( udg_Kaido_I[3] == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kaido_Q_01_Actions takes nothing returns nothing
    set udg_Kaido_I[3]=( udg_Kaido_I[3] + 1 )
    if ( Trig_Kaido_Q_01_Func002C() ) then
        call PauseTimerBJ(true, udg_Kaido_Timer[3])
        call GroupClear(udg_Kaido_G[0])
        call RemoveLocation(udg_Kaido_L[1])
        call RemoveLocation(udg_Kaido_L[2])
    else
        set udg_Kaido_I[0]=22
        set udg_Kaido_I[0]=( udg_Kaido_I[0] * udg_Kaido_I[3] )
        set udg_Kaido_L[3]=PolarProjectionBJ(udg_Kaido_L[1], ( 140.00 * I2R(udg_Kaido_I[3]) ), AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]))
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[3], AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]))
        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Effect Dust Wave Ice.mdx")
        call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 100.00, 1000000000.00)
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 0)
        call SetUnitScalePercent(GetLastCreatedUnit(), ( 100.00 + I2R(udg_Kaido_I[0]) ), ( 100.00 + I2R(udg_Kaido_I[0]) ), ( 100.00 + I2R(udg_Kaido_I[0]) ))
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[3], AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]))
        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Effect BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_1_1.mdx")
        call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 100.00, 1000000000.00)
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
        call SetUnitScalePercent(GetLastCreatedUnit(), ( 100.00 + I2R(udg_Kaido_I[0]) ), ( 100.00 + I2R(udg_Kaido_I[0]) ), ( 100.00 + I2R(udg_Kaido_I[0]) ))
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[3], AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]))
        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Effect Archor Claw Target.mdx")
        call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 100.00, 1000000000.00)
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
        call SetUnitScalePercent(GetLastCreatedUnit(), ( 100.00 + I2R(udg_Kaido_I[0]) ), ( 100.00 + I2R(udg_Kaido_I[0]) ), ( 100.00 + I2R(udg_Kaido_I[0]) ))
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[3], AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]))
        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "WarStompCaster.mdx")
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
        call UnitAddAbilityBJ('A0UC', GetLastCreatedUnit())
        call SetUnitAbilityLevelSwapped('A0UC', GetLastCreatedUnit(), 2)
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
        if ( Trig_Kaido_Q_01_Func002Func030C() ) then
            set udg_Kaido_I[4]=( udg_Kaido_I[4] + 1 )
            set bj_wantDestroyGroup=true
            call ForGroupBJ(GetUnitsInRangeOfLocMatching(( 100.00 + ( I2R(udg_Kaido_I[4]) * 50.00 ) ), udg_Kaido_L[3], Condition(function Trig_Kaido_Q_01_Func002Func030Func003001003)), function Trig_Kaido_Q_01_Func002Func030Func003A)
        else
        endif
        call RemoveLocation(udg_Kaido_L[3])
        // -------------------------------
        set udg_Kaido_I[0]=22
        set udg_Kaido_I[0]=( udg_Kaido_I[0] * udg_Kaido_I[3] )
        set udg_Kaido_L[10]=PolarProjectionBJ(udg_Kaido_L[1], ( 140.00 * I2R(udg_Kaido_I[3]) ), ( AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]) - 22.00 ))
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[3], ( AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]) - 22.00 ))
        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Effect Dust Wave Ice.mdx")
        call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 100.00, 1000000000.00)
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 0)
        call SetUnitScalePercent(GetLastCreatedUnit(), ( 100.00 + I2R(udg_Kaido_I[0]) ), ( 100.00 + I2R(udg_Kaido_I[0]) ), ( 100.00 + I2R(udg_Kaido_I[0]) ))
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[3], ( AngleBetweenPoints(udg_Kaido_L[1], udg_Kaido_L[2]) - 22.00 ))
