    set gg_trg_junkuk2_______u=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_junkuk2_______u, udg_JunKukT_______u)
    call TriggerAddAction(gg_trg_junkuk2_______u, function Trig_junkuk2_______u_Actions)
endfunction

