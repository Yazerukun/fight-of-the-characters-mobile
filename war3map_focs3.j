function Trig_Charge_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O00C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Actions takes nothing returns nothing
    set udg_Ul=GetOrderPointLoc()
    set udg_Ulu=GetOrderedUnit()
    call SetUnitPathing(GetTriggerUnit(), false)
    set udg_Charge_Unit=GetTriggerUnit()
    set udg_Charge_Real[1]=0.00
    set udg_Charge_Real[2]=0.00
    set udg_Charge_Real[3]=0.00
    set udg_Charge_Point[1]=GetUnitLoc(udg_Charge_Unit)
    set udg_Charge_Point[2]=GetOrderPointLoc()
    set udg_Charge_Real[1]=( DistanceBetweenPoints(udg_Charge_Point[1], udg_Charge_Point[2]) / 50.00 )
    set udg_Charge_Real[2]=( DistanceBetweenPoints(udg_Charge_Point[1], udg_Charge_Point[2]) / 50.00 )
    set udg_Angle=AngleBetweenPoints(udg_Charge_Point[1], udg_Charge_Point[2])
    call SetUnitFacingTimed(udg_Charge_Unit, udg_Angle, 0)
    call RemoveLocation(udg_Charge_Point[1])
    call RemoveLocation(udg_Charge_Point[2])
    call EnableTrigger(gg_trg_Charge_Loop)
    call EnableTrigger(gg_trg_Animation)
endfunction

