//===========================================================================
function Trig_TskillClare_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0BP' ) ) then
        return false
    endif
    return true
endfunction

function Trig_TskillClare_Func005002 takes nothing returns nothing
    call AddSpecialEffectLocBJ(GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl")
endfunction

function Trig_TskillClare_Func007002 takes nothing returns nothing
    call ExplodeUnitBJ(GetEnumUnit())
endfunction

function Trig_TskillClare_Actions takes nothing returns nothing
    set udg_b1_uu=GetSpellTargetLoc()
    set udg_b4_uu=CreateGroup()
    set udg_b2_uu=1
    loop
        exitwhen udg_b2_uu > 12
        set udg_b3_uu=1
        loop
            exitwhen udg_b3_uu > 18
            call CreateNUnitsAtLoc(1, 'e006', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(udg_b1_uu, ( 50.00 * I2R(udg_b2_uu) ), ( 20.00 * I2R(udg_b3_uu) )), bj_UNIT_FACING)
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_b4_uu)
            call SetUnitTimeScalePercent(GetLastCreatedUnit(), 1.00)
            set udg_b3_uu=udg_b3_uu + 1
        endloop
        set udg_b2_uu=udg_b2_uu + 1
    endloop
    call PolledWait(1.50)
    call ForGroupBJ(udg_b4_uu, function Trig_TskillClare_Func005002)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call ForGroupBJ(udg_b4_uu, function Trig_TskillClare_Func007002)
    call DestroyGroup(udg_b4_uu)
    call RemoveLocation(udg_b1_uu)
endfunction

