function Trig_gametimer2________2_Actions takes nothing returns nothing
    call PauseTimerBJ(true, udg_gametimer)
    set udg_gametimer_i=( udg_gametimer_i + 1 )
    if ( Trig_gametimer2________2_Func003C() ) then
        set udg_gametimer_i=0
        set udg_gametimer_i2=0
