    if ( not ( GetSpellAbilityId() == 'A0T3' ) ) then
        return false
    endif
    return true
endfunction

function Trig_sabert___________________________________u_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_MSDTeachW)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=30
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00P', GetOwningPlayer(udg_UlA), PolarProjectionBJ(udg_UlAl, ( I2R(GetForLoopIndexA()) * 10.00 ), 90.00), udg_UlC)
        call SetUnitTimeScalePercent(GetLastCreatedUnit(), 25.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00P', GetOwningPlayer(udg_UlA), PolarProjectionBJ(udg_UlAl, 0.00, 0), udg_UlC)
        call SetUnitTimeScalePercent(GetLastCreatedUnit(), 25.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'e00P', GetOwningPlayer(udg_UlA), PolarProjectionBJ(udg_UlAl, ( I2R(GetForLoopIndexA()) * 10.00 ), 270.00), udg_UlC)
        call SetUnitTimeScalePercent(GetLastCreatedUnit(), 25.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction(0.10)
    call RemoveLocation(udg_UlAl)
endfunction

//===========================================================================
function InitTrig_sabert___________________________________u takes nothing returns nothing
