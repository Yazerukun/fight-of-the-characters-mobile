    call TriggerAddCondition(gg_trg_Toshiro_Move_02, Condition(function Trig_Toshiro_Move_02_Conditions))
    call TriggerAddAction(gg_trg_Toshiro_Move_02, function Trig_Toshiro_Move_02_Actions)
endfunction

//===========================================================================
// Trigger: Toshiro Move 07
//===========================================================================
function Trig_Toshiro_Move_07_Actions takes nothing returns nothing
    call SetUnitAnimationByIndex(udg_Toshiro_Move_U, 0)
endfunction

//===========================================================================
function InitTrig_Toshiro_Move_07 takes nothing returns nothing
    set gg_trg_Toshiro_Move_07=CreateTrigger()
    call DisableTrigger(gg_trg_Toshiro_Move_07)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Toshiro_Move_07, 0.00)
    call TriggerAddAction(gg_trg_Toshiro_Move_07, function Trig_Toshiro_Move_07_Actions)
endfunction

