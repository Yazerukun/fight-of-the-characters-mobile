        return false
    endif
    return true
endfunction

function Trig_Enel_______u_Actions takes nothing returns nothing
    set udg_AzenQL1=GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc(1, 'e03Z', GetOwningPlayer(GetTriggerUnit()), udg_AzenQL1, bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e08J', GetOwningPlayer(GetTriggerUnit()), udg_AzenQL1, bj_UNIT_FACING)
    set udg_AzenWU=GetLastCreatedUnit()
    call RemoveLocation(udg_AzenQL1)
    if ( Trig_Enel_______u_Func006C() ) then
        call IssueImmediateOrderBJ(udg_AzenWU, "stomp")
    else
        if ( Trig_Enel_______u_Func006Func001C() ) then
            call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
            call IssueImmediateOrderBJ(udg_AzenWU, "stomp")
        else
            if ( Trig_Enel_______u_Func006Func001Func001C() ) then
                call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                call IssueImmediateOrderBJ(udg_AzenWU, "stomp")
            else
                if ( Trig_Enel_______u_Func006Func001Func001Func001C() ) then
                    call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                    call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                    call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                    call IssueImmediateOrderBJ(udg_AzenWU, "stomp")
                else
                    call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                    call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                    call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                    call IncUnitAbilityLevelSwapped('A0O8', udg_AzenWU)
                    call IssueImmediateOrderBJ(udg_AzenWU, "stomp")
                endif
            endif
        endif
    endif
endfunction

