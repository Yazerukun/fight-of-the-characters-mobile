//===========================================================================
// Trigger: lee
//
// 모든 플레이어의 기본 멜리 게임 초기화
//===========================================================================
function Trig_lee_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EG' ) ) then
        return false
    endif
    return true
endfunction

function Trig_lee_Actions takes nothing returns nothing
    set udg_REEca=GetTriggerUnit()
    set udg_REEta=GetSpellTargetUnit()
    call UnitRemoveBuffBJ('B013', udg_REEca)
    call UnitRemoveBuffBJ('B013', udg_REEta)
    call SetPlayerAbilityAvailableBJ(false, 'A08T', GetOwningPlayer(udg_REEca))
    call SetPlayerAbilityAvailableBJ(false, 'A08T', GetOwningPlayer(udg_REEta))
    call UnitAddAbilityBJ('A08T', udg_REEca)
    call UnitAddAbilityBJ('A08T', udg_REEta)
    set udg_REElo=GetUnitLoc(udg_REEca)
    call SetUnitInvulnerable(udg_REEca, true)
    call SetUnitInvulnerable(udg_REEta, true)
    call PauseUnitBJ(true, udg_REEca)
    call PauseUnitBJ(true, udg_REEta)
    call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Spells\\Undead\\OrbOfDeath\\AnnihilationMissile.mdl")
    set udg_REEeff[1]=GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl")
    set udg_REEeff[2]=GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ("chest", GetTriggerUnit(), "Abilities\\Weapons\\ZigguratFrostMissile\\ZigguratFrostMissile.mdl")
    set udg_REEeff[3]=GetLastCreatedEffectBJ()
    call SetUnitVertexColorBJ(udg_REEca, 100, 0.00, 0.00, 0)
    set udg_REEint=0
    call EnableTrigger(gg_trg_lee2)
    call StartTimerBJ(udg_Aaa[12], false, 0.10)
endfunction

