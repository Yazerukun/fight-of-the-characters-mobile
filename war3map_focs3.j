    call TriggerSleepAction(0.50)
    call IssueImmediateOrderBJ(udg_MadaraR[2], "stomp")
    call CreateNUnitsAtLoc(1, 'e0AI', GetOwningPlayer(udg_MadaraR[0]), udg_MadaraRL[3], udg_MadaraRT)
    set udg_MadaraR[3]=GetLastCreatedUnit()
