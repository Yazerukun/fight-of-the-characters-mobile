        return false
    endif
    return true
endfunction

function Trig_ColdA_End_Actions takes nothing returns nothing
    call AddSpecialEffectLocBJ(udg_ColdLC, "Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'e05N', GetOwningPlayer(udg_ColdU2), udg_ColdLC, 0.00)
    call CreateNUnitsAtLoc(1, 'e073', GetOwningPlayer(udg_ColdU2), udg_ColdLC, 0.00)
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 200.00)
    if ( Trig_ColdA_End_Func006C() ) then
        call IssueImmediateOrderBJ(udg_ColdU, "stomp")
    else
        if ( Trig_ColdA_End_Func006Func001C() ) then
            call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
            call IssueImmediateOrderBJ(udg_ColdU, "stomp")
        else
            if ( Trig_ColdA_End_Func006Func001Func001C() ) then
                call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                call IssueImmediateOrderBJ(udg_ColdU, "stomp")
            else
                if ( Trig_ColdA_End_Func006Func001Func001Func001C() ) then
                    call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                    call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                    call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                    call IssueImmediateOrderBJ(udg_ColdU, "stomp")
                else
                    call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                    call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                    call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                    call IncUnitAbilityLevelSwapped('A0JV', udg_ColdU)
                    call IssueImmediateOrderBJ(udg_ColdU, "stomp")
                endif
            endif
        endif
    endif
    set udg_ColdU2=null
    set udg_ColdU=null
    call RemoveLocation(udg_ColdLC)
endfunction

