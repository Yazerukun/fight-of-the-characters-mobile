    call TriggerSleepAction(0.50)
    call IssueImmediateOrderBJ(udg_MadaraR[3], "stomp")
    call CreateNUnitsAtLoc(1, 'e0AI', GetOwningPlayer(udg_MadaraR[0]), udg_MadaraRL[4], udg_MadaraRT)
