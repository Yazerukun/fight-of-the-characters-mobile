            else
                call CreateItemLoc('I01X', GetUnitLoc(GetTriggerUnit()))
                call SetItemUserData(GetLastCreatedItem(), GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit())))
            endif
        endif
    else
        set udg_ITEMowner=GetItemUserData(GetManipulatedItem())
        if ( Trig_item_cha2______________u_Func001Func002C() ) then
            call CreateItemLoc('I01X', GetUnitLoc(GetTriggerUnit()))
            call SetItemUserData(GetLastCreatedItem(), udg_ITEMowner)
