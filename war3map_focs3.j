// 데미지 주기로 주는 함수

function poisonattack takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit source= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Source"))
local unit target=LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Target"))
local real damage= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Damage"))
local real frequency=LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Frequency"))
local real number= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Number"))
local string impact= LoadStr(udg_Hashtable, GetHandleId(t), StringHash("impact"))
local string sticking= LoadStr(udg_Hashtable, GetHandleId(t), StringHash("Sticking"))
local real DestroyE= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Destroy"))
if ( number >= frequency ) then
     call FlushChildHashtableBJ(GetHandleId(t), udg_Hashtable)
     call DestroyTimer(t)
else
     if ( IsUnitAliveBJ(target) == true ) then
     call UnitDamageTargetBJ(source, target, damage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
      call AddSpecialEffectTargetUnitBJ(sticking, target, impact)
      call EDestroy(GetLastCreatedEffectBJ() , DestroyE)
 
     else
     call FlushChildHashtableBJ(GetHandleId(t), udg_Hashtable)
     call DestroyTimer(t)
     endif
set number=number + 1
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Number"), number)
endif
set target=null
set source=null
set t=null
endfunction

function poison takes unit a,unit b,real c,real d,real e,real z,string f,string g returns nothing
local timer t= CreateTimer()
local unit source= a
local unit target= b
local real damage= c
local real frequency= d
local real cycle= e
local string impact= f
local string sticking= g
local real DestroyE= z
     call UnitDamageTargetBJ(source, target, damage, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED)
      call AddSpecialEffectTargetUnitBJ(sticking, target, impact)
      call EDestroy(GetLastCreatedEffectBJ() , DestroyE)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Source"), source)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Target"), target)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Damage"), damage)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Frequency"), frequency)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Number"), 1)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Destroy"), DestroyE)
call SaveStr(udg_Hashtable, GetHandleId(t), StringHash("impact"), impact)
call SaveStr(udg_Hashtable, GetHandleId(t), StringHash("Sticking"), sticking)
call TimerStart(t, cycle, true, function poisonattack)
set source=null
set target=null
set t=null
endfunction

// 유닛 자동 회복

function recovery1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit source= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Source"))
local real recover= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("recover"))
local real frequency=LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Frequency"))
local real number= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Number"))
local string impact= LoadStr(udg_Hashtable, GetHandleId(t), StringHash("impact"))
local string sticking= LoadStr(udg_Hashtable, GetHandleId(t), StringHash("Sticking"))
local real DestroyE= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Destroy"))
if ( number >= frequency ) then
     call FlushChildHashtableBJ(GetHandleId(t), udg_Hashtable)
      call DestroyTimer(t)
else
     if ( IsUnitAliveBJ(source) == true ) then
    call SetUnitLifeBJ(source, GetUnitStateSwap(UNIT_STATE_LIFE, source) + recover)
      call AddSpecialEffectTargetUnitBJ(sticking, source, impact)
      call EDestroy(GetLastCreatedEffectBJ() , DestroyE)
 
     else
     call FlushChildHashtableBJ(GetHandleId(t), udg_Hashtable)
     call DestroyTimer(t)
 
     endif
set number=number + 1
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Number"), number)
endif
set source=null
set t=null
endfunction

function recovery takes unit a,real c,real d,real e,real z,string f,string g returns nothing
local timer t= CreateTimer()
local unit source= a
local real recover= c
local real frequency= d
local real cycle= e
local string impact= f
local string sticking= g
local real DestroyE= z
    call SetUnitLifeBJ(source, GetUnitStateSwap(UNIT_STATE_LIFE, source) + recover)
      call AddSpecialEffectTargetUnitBJ(sticking, source, impact)
      call EDestroy(GetLastCreatedEffectBJ() , DestroyE)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Source"), source)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("recover"), recover)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Frequency"), frequency)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Number"), 1)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Destroy"), DestroyE)
call SaveStr(udg_Hashtable, GetHandleId(t), StringHash("impact"), impact)
call SaveStr(udg_Hashtable, GetHandleId(t), StringHash("Sticking"), sticking)
call TimerStart(t, cycle, true, function recovery1)
set source=null
set t=null
endfunction

// 유닛 중심으로 회전

function UCircle1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local unit CircleUnit= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Circle"))
local unit Center= LoadUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Center"))
local real Cease= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Cease"))
local real CeaseNumber= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("CeaseNumber"))
local real Distance= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Distance"))
local real Angle= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Angle"))
local real OriginalAngle
local location CircleLoc= GetUnitLoc(Center)
local location CricleMove= GetUnitLoc(CircleUnit)
set OriginalAngle=AngleBetweenPoints(CircleLoc, CricleMove)
call RemoveLocation(CricleMove)
set CricleMove=PolarProjectionBJ(CircleLoc, Distance, OriginalAngle + Angle)
  if ( CeaseNumber >= Cease ) then
  call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
  call DestroyTimer(t)
  call RemoveUnit(CircleUnit)
  else
  set CeaseNumber=CeaseNumber + 1
  call SetUnitX(CircleUnit, GetLocationX(CricleMove))
  call SetUnitY(CircleUnit, GetLocationY(CricleMove))
  call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("CeaseNumber"), CeaseNumber)
  endif
call RemoveLocation(CricleMove)
call RemoveLocation(CircleLoc)
set CircleUnit=null
set t=null
set Center=null
set CricleMove=null
set CircleLoc=null
endfunction

function UCircle takes unit a,real f,unit b,real c,real d,real e,boolean g returns nothing
local unit CircleUnit= a
local real Distance= c
local real Cease= d
local real Timerfrequency= e
local boolean direction= g
local real size= f
local unit Center= b
local timer t= CreateTimer()
local real OriginalAngle
local real number= Cease / Timerfrequency
local real A= 360 / ( Distance / size )
local location CircleLoc= GetUnitLoc(Center)
local location CricleMove= GetUnitLoc(CircleUnit)
set OriginalAngle=AngleBetweenPoints(CircleLoc, CricleMove)
call RemoveLocation(CricleMove)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Circle"), CircleUnit)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Distance"), Distance)
if ( direction == true ) then
else
set A=- ( A )
endif
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Angle"), A)
call SaveUnitHandle(udg_Hashtable, GetHandleId(t), StringHash("Center"), Center)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Cease"), number)
set CricleMove=PolarProjectionBJ(CircleLoc, Distance, OriginalAngle + A)
call SetUnitX(CircleUnit, GetLocationX(CricleMove))
call SetUnitY(CircleUnit, GetLocationY(CricleMove))
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("CeaseNumber"), 1)
call TimerStart(t, Timerfrequency, true, function UCircle1)
call RemoveLocation(CricleMove)
call RemoveLocation(CircleLoc)
set CircleUnit=null
set t=null
set Center=null
set CricleMove=null
set CircleLoc=null
endfunction



