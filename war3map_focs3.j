function InitTrig_MSDTeachR1 takes nothing returns nothing
    set gg_trg_MSDTeachR1=CreateTrigger()
    call DisableTrigger(gg_trg_MSDTeachR1)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_MSDTeachR1, udg_MSDTeachRt)
    call TriggerAddAction(gg_trg_MSDTeachR1, function Trig_MSDTeachR1_Actions)
endfunction

