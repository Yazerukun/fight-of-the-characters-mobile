    call MultiboardSetItemIconBJ(GetLastCreatedMultiboard(), 3, 1, "ReplaceableTextures\\CommandButtons\\BTNImmolationOn.blp")
    call MultiboardSetItemIconBJ(GetLastCreatedMultiboard(), 3, 6, "ReplaceableTextures\\CommandButtons\\BTNImmolationOn.blp")
