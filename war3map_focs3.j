function Trig_brouto_R2_Actions takes nothing returns nothing
    set udg_broutoloc[50]=PolarProjectionBJ(GetUnitLoc(udg_brouto[90]), 300.00, ( udg_broutoreal[2] + 90.00 ))
    set udg_broutoloc[88]=GetUnitLoc(udg_brouto[90])
    set udg_broutoloc[51]=PolarProjectionBJ(GetUnitLoc(udg_brouto[90]), 300.00, ( udg_broutoreal[2] + 270.00 ))
    call CreateNUnitsAtLoc(1, 'h02U', GetOwningPlayer(udg_brouto[4]), udg_broutoloc[50], ( udg_broutoreal[2] - 90.00 ))
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'h02U', GetOwningPlayer(udg_brouto[4]), udg_broutoloc[51], ( udg_broutoreal[2] + 90.00 ))
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'h02W', GetOwningPlayer(udg_brouto[4]), udg_broutoloc[88], ( udg_broutoreal[2] + 90.00 ))
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call RemoveLocation(udg_broutoloc[50])
    call RemoveLocation(udg_broutoloc[51])
    call RemoveLocation(udg_broutoloc[88])
endfunction

