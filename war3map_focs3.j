//===========================================================================
function Trig_own_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0I4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_own_Actions takes nothing returns nothing
    set udg_OnegiokB=false
    set udg_OnegiokL=GetSpellTargetLoc()
    set udg_NooSoo=GetUnitLoc(GetSpellAbilityUnit())
    call CreateNUnitsAtLoc(1, 'e05Y', GetOwningPlayer(GetSpellAbilityUnit()), udg_NooSoo, 270.00)
    call RemoveLocation(udg_NooSoo)
    set udg_OnegiokU=GetLastCreatedUnit()
    set udg_OnegiokU2=GetSpellAbilityUnit()
    call EnableTrigger(gg_trg_own2_______u)
    call EnableTrigger(gg_trg_own2______________u)
    set udg_OnegiokU3=GetUnitLoc(udg_OnegiokU2)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'h009', GetOwningPlayer(udg_OnegiokU2), udg_OnegiokU3, ( I2R(GetForLoopIndexA()) * 30.00 ))
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_OnegiokUg)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveLocation(udg_OnegiokU3)
endfunction

