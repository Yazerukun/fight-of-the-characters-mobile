    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'ewsp' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Narak2_Actions takes nothing returns nothing
    call DestroyTrigger(GetTriggeringTrigger())
    call RemoveUnit(GetEnteringUnit())
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetEnteringUnit()), GetRectCenter(gg_rct_Sel), 0)
    call SetUnitPositionLoc(gg_unit_H01M_0135, GetRectCenter(gg_rct_Sel))
    call SetUnitOwner(gg_unit_H01M_0135, GetOwningPlayer(GetEnteringUnit()), true)
    call SetUnitInvulnerable(gg_unit_H01M_0135, false)
endfunction

