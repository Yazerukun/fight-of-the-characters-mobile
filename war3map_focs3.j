function InitTrig_TskillClare_____________________u takes nothing returns nothing
    set gg_trg_TskillClare_____________________u=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TskillClare_____________________u, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_TskillClare_____________________u, Condition(function Trig_TskillClare_____________________u_Conditions))
