function Trig_Kaido_R_02_Func002Func016001003001001 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) != true )
endfunction

function Trig_Kaido_R_02_Func002Func016001003001002 takes nothing returns boolean
    return ( IsUnitInGroup(GetFilterUnit(), udg_Kaido_G[1]) != true )
endfunction

function Trig_Kaido_R_02_Func002Func016001003001 takes nothing returns boolean
    return GetBooleanAnd((IsUnitDeadBJ(GetFilterUnit()) != true), (IsUnitInGroup(GetFilterUnit(), udg_Kaido_G[1]) != true)) // INLINED!!
endfunction

function Trig_Kaido_R_02_Func002Func016001003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Kaido_U)) == true )
endfunction

function Trig_Kaido_R_02_Func002Func016001003 takes nothing returns boolean
    return GetBooleanAnd((GetBooleanAnd((IsUnitDeadBJ(GetFilterUnit()) != true), (IsUnitInGroup(GetFilterUnit(), udg_Kaido_G[1]) != true))), (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Kaido_U)) == true)) // INLINED!!
endfunction

function Trig_Kaido_R_02_Func002Func016Func002Func001Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0U9', udg_Kaido_U) >= 3 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0U9', udg_Kaido_U) < 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kaido_R_02_Func002Func016Func002Func001C takes nothing returns boolean
