function Trig_MSDteachE3_Func002C takes nothing returns boolean
    if ( not ( udg_MSDteachEr[3] >= 5.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_MSDteachE3_Func004001003 takes nothing returns boolean
    return ( IsUnitEnemy(udg_MSDteachEu, GetOwningPlayer(GetFilterUnit())) == true )
endfunction

function Trig_MSDteachE3_Func004Func001Func007C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B02Y') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B03E') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B02Q') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'BPSE') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_MSDteachE3_Func004Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B000') == false ) ) then
        return false
    endif
    if ( not ( SubStringBJ(GetUnitName(GetEnumUnit()), 1, 6) != "거미" ) ) then
        return false
    endif
    if ( not ( SubStringBJ(GetUnitName(GetEnumUnit()), 1, 6) != "백조" ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'n012' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O003' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O011' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'H01G' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O00C' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O00D' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'O00E' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'e058' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'e08A' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'nspb' ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MSDteachE3_Func004A takes nothing returns nothing
    if ( Trig_MSDteachE3_Func004Func001C() ) then
        call IssueImmediateOrderBJ(GetEnumUnit(), "stop")
        call UnitDamageTargetBJ(udg_MSDteachEu, GetEnumUnit(), ( 100.00 * I2R(GetUnitAbilityLevelSwapped('A0T0', udg_MSDteachEu)) ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL)
        if ( Trig_MSDteachE3_Func004Func001Func007C() ) then
            set udg_MSDteachEl2=GetUnitLoc(GetEnumUnit())
            call SetUnitPositionLoc(GetEnumUnit(), PolarProjectionBJ(udg_MSDteachEl2, 8.00, ( AngleBetweenPoints(udg_MSDteachEl, udg_MSDteachEl2) - 180.00 )))
            call RemoveLocation(udg_MSDteachEl2)
        else
        endif
    else
    endif
endfunction

function Trig_MSDteachE3_Actions takes nothing returns nothing
    set udg_MSDteachEr[3]=( udg_MSDteachEr[3] + 1 )
    if ( Trig_MSDteachE3_Func002C() ) then
        set udg_MSDteachEr[3]=0.00
        call AddSpecialEffectLocBJ(udg_MSDteachEl, "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(PolarProjectionBJ(udg_MSDteachEl, GetRandomReal(0, 250.00), GetRandomReal(0, 360.00)), "war3mapImported\\ShadowAssault.mdx")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call AddSpecialEffectLocBJ(PolarProjectionBJ(udg_MSDteachEl, GetRandomReal(0, 250.00), GetRandomReal(0, 360.00)), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_MSDteachEl, Condition(function Trig_MSDteachE3_Func004001003)), function Trig_MSDteachE3_Func004A)
endfunction

