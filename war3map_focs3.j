        return false
    endif
    return true
endfunction

function Trig_kenRSkil_Func030A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_KenR3copy)
endfunction

function Trig_kenRSkil_Func031A takes nothing returns nothing
    call PauseUnitBJ(false, GetEnumUnit())
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_KenR3)
endfunction

function Trig_kenRSkil_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraSetEQNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()), 2.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitInvulnerable(udg_KenR7, true)
    set udg_KenR4=0.00
    set udg_KenR6=0.00
    call PlaySoundBJ(gg_snd_KenpachiR2)
    call EnableTrigger(gg_trg_kenRskil3)
    call StartTimerBJ(udg_Aaa[37], false, 0.01)
    call EnableTrigger(gg_trg_kenRskil3_______u)
    call StartTimerBJ(udg_Aaa[38], false, 0.01)
    call CreateNUnitsAtLoc(1, 'e00I', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), 270.00)
    set udg_KenR1=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'e00J', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), 270.00)
    set udg_KenR2=GetLastCreatedUnit()
    call EnableTrigger(gg_trg_kenRskil2)
    call StartTimerBJ(udg_Aaa[36], false, 0.15)
    call TriggerSleepAction(1.00)
    call DisableTrigger(gg_trg_kenRskil3)
    call DisableTrigger(gg_trg_kenRskil3_______u)
    set udg_KenR4=0.00
    set udg_KenR6=0.00
    call TriggerSleepAction(9.00)
    call EnableTrigger(gg_trg_kenRskil4)
    call StartTimerBJ(udg_Aaa[39], false, 0.01)
    call EnableTrigger(gg_trg_kenRskil4_______u)
    call StartTimerBJ(udg_Aaa[40], false, 0.01)
    call TriggerSleepAction(1.00)
    call DisableTrigger(gg_trg_kenRskil4)
    call DisableTrigger(gg_trg_kenRskil4_______u)
    call DisableTrigger(gg_trg_kenRskil2)
    call ForGroupBJ(udg_KenR3copy, function Trig_kenRSkil_Func030A)
    call ForGroupBJ(udg_KenR3, function Trig_kenRSkil_Func031A)
    call KillUnit(udg_KenR1)
    call KillUnit(udg_KenR2)
    call PauseUnitBJ(false, udg_KenR7)
    call SetUnitInvulnerable(udg_KenR7, false)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraClearNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set udg_KenR1=null
    set udg_KenR2=null
endfunction

