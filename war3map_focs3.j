    set gg_trg_hinataR1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_hinataR1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_hinataR1, Condition(function Trig_hinataR1_Conditions))
