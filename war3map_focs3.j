//===========================================================================
// Trigger: sigy1
//===========================================================================
function Trig_sigy1_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0JL' ) ) then
        return false
    endif
    return true
endfunction

function Trig_sigy1_Func008C takes nothing returns boolean
    if ( not ( udg_siginon == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_SigiUnit2, 'B031') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_sigy1_Actions takes nothing returns nothing
    set udg_SigiUnit1=GetSpellAbilityUnit()
    set udg_SigiUnit2=GetSpellTargetUnit()
    set udg_siginon=true
    call PauseUnitBJ(true, udg_SigiUnit2)
    call CreateNUnitsAtLoc(1, 'h014', GetOwningPlayer(udg_SigiUnit1), GetUnitLoc(udg_SigiUnit1), GetUnitFacing(udg_SigiUnit1))
    // 이렇게하면 지점누수 1개 생기긴 하겠지만 별일 없겠지 뭐
    call TriggerSleepAction(2.80)
    if ( Trig_sigy1_Func008C() ) then
        set udg_siginon=false
        call TriggerExecute(gg_trg_sigy2)
    else
    endif
endfunction

//===========================================================================
function InitTrig_sigy1 takes nothing returns nothing
    set gg_trg_sigy1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_sigy1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_sigy1, Condition(function Trig_sigy1_Conditions))
    call TriggerAddAction(gg_trg_sigy1, function Trig_sigy1_Actions)
endfunction

