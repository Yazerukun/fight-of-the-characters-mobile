function Trig_bugfix11_______u_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetLevelingUnit()) == 'H01I' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetLevelingUnit()) == 'H026' ) ) then
        return true
    endif
    return false
endfunction

function Trig_bugfix11_______u_Conditions takes nothing returns boolean
    if ( not Trig_bugfix11_______u_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_bugfix11_______u_Func002C takes nothing returns boolean
    if ( not ( GetUnitLevel(GetLevelingUnit()) >= 2 ) ) then
