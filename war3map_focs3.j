//===========================================================================
// Trigger: C1 Bombing
//===========================================================================
function Trig_C1_Bombing_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0C5' ) ) then
        return false
    endif
    return true
endfunction

function Trig_C1_Bombing_Func005002 takes nothing returns nothing
    call AddSpecialEffectLocBJ(GetUnitLoc(GetEnumUnit()), "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
endfunction

function Trig_C1_Bombing_Func007002 takes nothing returns nothing
    call ExplodeUnitBJ(GetEnumUnit())
endfunction

function Trig_C1_Bombing_Actions takes nothing returns nothing
    set udg_b1_uu=GetUnitLoc(GetTriggerUnit())
    set udg_b4_uu=CreateGroup()
    set udg_b2_uu=1
    loop
        exitwhen udg_b2_uu > 7
        set udg_b3_uu=1
        loop
            exitwhen udg_b3_uu > 18
            call CreateNUnitsAtLoc(1, 'e01I', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(udg_b1_uu, ( 50.00 * I2R(udg_b2_uu) ), ( 20.00 * I2R(udg_b3_uu) )), bj_UNIT_FACING)
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_b4_uu)
            set udg_b3_uu=udg_b3_uu + 1
        endloop
        set udg_b2_uu=udg_b2_uu + 1
    endloop
    call PolledWait(1.00)
    call ForGroupBJ(udg_b4_uu, function Trig_C1_Bombing_Func005002)
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call ForGroupBJ(udg_b4_uu, function Trig_C1_Bombing_Func007002)
    call DestroyGroup(udg_b4_uu)
    call RemoveLocation(udg_b1_uu)
endfunction

