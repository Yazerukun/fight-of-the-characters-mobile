function InitTrig_pungdun2 takes nothing returns nothing
    set gg_trg_pungdun2=CreateTrigger()
    call DisableTrigger(gg_trg_pungdun2)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_pungdun2, udg_Aaa[9])
    call TriggerAddAction(gg_trg_pungdun2, function Trig_pungdun2_Actions)
endfunction

