function Trig_SerasRs_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_SrsBR)
    set udg_BloodBunAuu=GetTriggerUnit()
    call SetPlayerAbilityAvailableBJ(true, 'A0KR', GetOwningPlayer(udg_BloodBunAuu))
    set udg_BloodBunC=GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc(1, 'e07L', GetOwningPlayer(GetTriggerUnit()), udg_BloodBunC, bj_UNIT_FACING)
