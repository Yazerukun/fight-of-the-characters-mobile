// Trigger: gomugomustorm 복사
//===========================================================================
function Trig_gomugomustorm_______u_Func001C takes nothing returns boolean
    if ( not ( udg_GomuSg < 50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_gomugomustorm_______u_Actions takes nothing returns nothing
    if ( Trig_gomugomustorm_______u_Func001C() ) then
        set udg_GomuSg=( udg_GomuSg + 1 )
        set udg_GomuSu2=OffsetLocation(udg_GomuSz, GetRandomReal(- 200.00, 200.00), GetRandomReal(- 200.00, 200.00))
        call CreateNUnitsAtLoc(1, 'e05M', GetOwningPlayer(udg_GomuSu), udg_GomuSu2, udg_GomuSs)
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
        call RemoveLocation(udg_GomuSu2)
        call CreateNUnitsAtLoc(1, 'e05R', GetOwningPlayer(udg_GomuSu), udg_GomuSz, udg_GomuSs)
        call SetUnitAnimation(GetLastCreatedUnit(), "Attack")
        call SetUnitTimeScalePercent(GetLastCreatedUnit(), 200.00)
        call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100, 100, 100, 70.00)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call TriggerSleepAction(0.50)
        call SetUnitInvulnerable(udg_GomuSu, false)
        call PauseUnitBJ(false, udg_GomuSu)
        call ShowUnitShow(udg_GomuSu)
        call SelectUnitForPlayerSingle(udg_GomuSu, GetOwningPlayer(udg_GomuSu))
        set udg_GomuSu=null
        call RemoveLocation(udg_GomuSz)
    endif
endfunction

