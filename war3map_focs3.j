        call StartTimerBJ(udg_BloodBunEu, false, 7.00)
    else
        call DisplayTextToPlayer(GetOwningPlayer(udg_BloodBunAu), 0, 0, ( "|c00ff0000흡혈수가 부족합니다." ))
