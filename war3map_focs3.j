    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'hwat' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'hwt2' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'hwt3' ) ) then
