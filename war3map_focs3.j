function Trig_WskillClare2m1_______u_Actions takes nothing returns nothing
    call DisableTrigger(gg_trg_WskillClare7_______u)
    call CreateNUnitsAtLocFacingLocBJ(1, 'e06S', GetOwningPlayer(udg_P_Caster2), GetUnitLoc(udg_P_Caster2), GetUnitLoc(udg_P_Target2))
    set udg_WskillClare_2=GetLastCreatedUnit()
    if ( Trig_WskillClare2m1_______u_Func004C() ) then
        call IssueTargetOrderBJ(udg_WskillClare_2, "thunderbolt", udg_P_Target2)
    else
        if ( Trig_WskillClare2m1_______u_Func004Func002C() ) then
            call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
            call IssueTargetOrderBJ(udg_WskillClare_2, "thunderbolt", udg_P_Target2)
        else
            if ( Trig_WskillClare2m1_______u_Func004Func002Func004C() ) then
                call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                call IssueTargetOrderBJ(udg_WskillClare_2, "thunderbolt", udg_P_Target2)
            else
                if ( Trig_WskillClare2m1_______u_Func004Func002Func004Func004C() ) then
                    call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                    call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                    call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                    call IssueTargetOrderBJ(udg_WskillClare_2, "thunderbolt", udg_P_Target2)
                else
                    if ( Trig_WskillClare2m1_______u_Func004Func002Func004Func004Func005C() ) then
                        call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                        call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                        call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                        call IncUnitAbilityLevelSwapped('A03X', udg_WskillClare_2)
                        call IssueTargetOrderBJ(udg_WskillClare_2, "thunderbolt", udg_P_Target2)
                    else
                    endif
                endif
            endif
        endif
    endif
    call PauseUnitBJ(false, udg_P_Target2)
    call SetUnitAnimation(udg_P_Target2, "stand")
endfunction

