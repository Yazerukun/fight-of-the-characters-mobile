        call SetPlayerAbilityAvailableBJ(false, 'A0OO', ConvertedPlayer(GetForLoopIndexA()))
        call SetPlayerAbilityAvailableBJ(false, 'A0OS', ConvertedPlayer(GetForLoopIndexA()))
