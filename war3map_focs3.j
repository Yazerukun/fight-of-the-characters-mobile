    call IssueImmediateOrderBJ(udg_MadaraR[4], "stomp")
    call CreateNUnitsAtLoc(1, 'e0AI', GetOwningPlayer(udg_MadaraR[0]), udg_MadaraRL[5], udg_MadaraRT)
