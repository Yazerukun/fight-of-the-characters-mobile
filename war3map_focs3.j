//===========================================================================
// Trigger: MSDTeachR1
//===========================================================================
function Trig_MSDTeachR1_Func004C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_MSDTeachRlc, udg_MSDTeachRl) >= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_MSDTeachR1_Actions takes nothing returns nothing
    set udg_MSDTeachRlc=GetUnitLoc(udg_MSDTeachRu)
    set udg_MSDTeachRl=GetUnitLoc(udg_MSDTeachRl_u)
    set udg_MSDTeachRAngle7=AngleBetweenPoints(udg_MSDTeachRl, GetUnitLoc(udg_MSDTeachRu))
    if ( Trig_MSDTeachR1_Func004C() ) then
        call SetUnitPathing(udg_MSDTeachRu, false)
        call AddSpecialEffectLocBJ(udg_MSDTeachRlc, "war3mapImported\\ShadowAssault.mdx")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call SetUnitPositionLocFacingBJ(udg_MSDTeachRu, PolarProjectionBJ(udg_MSDTeachRlc, 40.00, ( udg_MSDTeachRAngle7 + 180.00 )), ( udg_MSDTeachRAngle7 + 180.00 ))
    else
        call DisableTrigger(GetTriggeringTrigger())
        call CreateNUnitsAtLoc(1, 'e03G', GetOwningPlayer(udg_MSDTeachRu), udg_MSDTeachRl, bj_UNIT_FACING)
        call SetUnitVertexColorBJ(udg_MSDTeachRu, 100, 100, 100, 100.00)
        call IssuePointOrderLocBJ(udg_MSDTeachRu, "dreadlordinferno", udg_MSDTeachRl)
        call CreateNUnitsAtLoc(1, 'e06L', GetOwningPlayer(udg_MSDTeachRu), udg_MSDTeachRl, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_MSDTeachRl_u)
        call TriggerSleepAction(0.50)
        call UnitDamageTargetBJ(udg_MSDTeachRu2, udg_MSDTeachRl_u, 1000.00, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
        call UnitDamageTargetBJ(udg_MSDTeachRu2, udg_MSDTeachRl_u, ( 2000.00 * I2R(GetUnitAbilityLevelSwapped('A0TA', udg_MSDTeachRu2)) ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
        call CreateNUnitsAtLoc(3, 'e0CB', GetOwningPlayer(udg_MSDTeachRu), udg_MSDTeachRl, bj_UNIT_FACING)
        call CreateNUnitsAtLoc(1, 'e0CC', GetOwningPlayer(udg_MSDTeachRu), udg_MSDTeachRl, bj_UNIT_FACING)
        call SetUnitAnimation(GetLastCreatedUnit(), "birth")
        call CreateNUnitsAtLoc(1, 'e0CC', GetOwningPlayer(udg_MSDTeachRu), udg_MSDTeachRl, bj_UNIT_FACING)
        call SetUnitAnimation(GetLastCreatedUnit(), "birth")
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call vibration(ConvertedPlayer(GetForLoopIndexA()) , 6.00 , 2.00)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call RemoveUnit(udg_MSDTeachRu)
        set udg_MSDTeachRu=null
        call RemoveLocation(udg_MSDTeachRl)
    endif
    call RemoveLocation(udg_MSDTeachRlc)
    call StartTimerBJ(udg_MSDTeachRt, false, 0.02)
endfunction

