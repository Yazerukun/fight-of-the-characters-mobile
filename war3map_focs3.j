function Trig_SaberSel_Actions takes nothing returns nothing
    call DestroyTrigger(GetTriggeringTrigger())
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetEnteringUnit()), GetRectCenter(gg_rct_Sel), 0)
    call RemoveUnit(GetEnteringUnit())
    call SetUnitInvulnerable(gg_unit_H00A_0000, false)
    call SetUnitPositionLoc(gg_unit_H00A_0000, GetRectCenter(gg_rct_Sel))
    call SetUnitOwner(gg_unit_H00A_0000, GetOwningPlayer(GetEnteringUnit()), true)
    call DisplayTextToForce(GetPlayersAll(), ( "|c00ff0000" + ( GetPlayerName(GetOwningPlayer(GetEnteringUnit())) + ( "|r|c0000ffff님께서|r " + ( "|c0000ff40기사왕 세이버|r|c0000ffff를 선택하셨습니다." ) ) ) ))
