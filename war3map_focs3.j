function InitTrig_junkuk2 takes nothing returns nothing
    set gg_trg_junkuk2=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_junkuk2, udg_JunKukT)
    call TriggerAddAction(gg_trg_junkuk2, function Trig_junkuk2_Actions)
endfunction

