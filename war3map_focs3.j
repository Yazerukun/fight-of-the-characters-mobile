//===========================================================================
// Trigger: sigy2
//===========================================================================
function Trig_sigy2_Actions takes nothing returns nothing
    call PlaySoundBJ(udg_sound19)
    call UnitDamageTargetBJ(udg_SigiUnit1, udg_SigiUnit2, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_SigiUnit1) / 2.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
    call AddSpecialEffectTargetUnitBJ("origin", udg_SigiUnit2, "Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call AddSpecialEffectTargetUnitBJ("origin", udg_SigiUnit2, "Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call PauseUnitBJ(false, udg_SigiUnit2)
    call KillUnit(udg_SigiUnit1)
    set udg_SigiUnit2=null
    set udg_SigiUnit1=null
endfunction

//===========================================================================
function InitTrig_sigy2 takes nothing returns nothing
    set gg_trg_sigy2=CreateTrigger()
    call TriggerAddAction(gg_trg_sigy2, function Trig_sigy2_Actions)
endfunction

