            call CreateNUnitsAtLoc(1, 'e03P', GetOwningPlayer(udg_AasaaUnit1), PolarProjectionBJ(udg_AasaaUnit2copy, 100.00, ( I2R(GetForLoopIndexA()) * 45.00 )), bj_UNIT_FACING)
