function InitTrig_StringTest_______u takes nothing returns nothing
    set gg_trg_StringTest_______u=CreateTrigger()
    call DisableTrigger(gg_trg_StringTest_______u)
    call TriggerRegisterPlayerChatEvent(gg_trg_StringTest_______u, Player(0), "", false)
    call TriggerAddAction(gg_trg_StringTest_______u, function Trig_StringTest_______u_Actions)
endfunction

