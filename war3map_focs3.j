//===========================================================================
// Trigger: ChingHo
//===========================================================================
function Trig_ChingHo_Conditions takes nothing returns boolean
    if ( not ( GetPlayerState(GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER) >= 8 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'e09W' ) ) then
        return false
    endif
    if ( not ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_POWERUP ) ) then
        return false
    endif
    return true
endfunction

function Trig_ChingHo_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()), 0, 0, "TRIGSTR_11510")
    call KillUnit(GetTriggerUnit())
    call SetPlayerName(GetOwningPlayer(GetTriggerUnit()), ( GetItemName(GetManipulatedItem()) + GetPlayerName(GetOwningPlayer(GetTriggerUnit())) ))
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_ChingHo takes nothing returns nothing
    set gg_trg_ChingHo=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ChingHo, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_ChingHo, Condition(function Trig_ChingHo_Conditions))
    call TriggerAddAction(gg_trg_ChingHo, function Trig_ChingHo_Actions)
endfunction

