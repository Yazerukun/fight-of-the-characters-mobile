function Trig_NewZoroV_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0TB' ) ) then
        return false
    endif
    return true
endfunction

function Trig_NewZoroV_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call PlaySoundBJ(gg_snd_NewZoroV)
    call UnitDamageTargetBJ(GetTriggerUnit(), GetSpellTargetUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, GetTriggerUnit(), true)) * 0.30 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
    set udg_NewZoroVu=GetTriggerUnit()
    set udg_NewZoroVl2=GetUnitLoc(udg_NewZoroVu)
    set udg_NewZoroVl=GetUnitLoc(GetSpellTargetUnit())
    set udg_NewZoroVl3=PolarProjectionBJ(udg_NewZoroVl, 100.00, AngleBetweenPoints(udg_NewZoroVl2, udg_NewZoroVl))
    call SetUnitPathing(udg_NewZoroVu, false)
    call CreateNUnitsAtLoc(1, 'e0BU', GetOwningPlayer(udg_NewZoroVu), udg_NewZoroVl2, GetRandomDirectionDeg())
    call KnockBack(udg_NewZoroVu , udg_NewZoroVl3 , 0.10 , 0.01)
    call TriggerSleepAction(0.10)
    call CreateNUnitsAtLoc(1, 'e0BT', GetOwningPlayer(udg_NewZoroVu), udg_NewZoroVl, GetRandomDirectionDeg())
    call CreateNUnitsAtLoc(1, 'e0BS', GetOwningPlayer(udg_NewZoroVu), udg_NewZoroVl, GetRandomDirectionDeg())
    call SetUnitPathing(udg_NewZoroVu, true)
    call RemoveLocation(udg_NewZoroVl)
    call RemoveLocation(udg_NewZoroVl2)
    call RemoveLocation(udg_NewZoroVl3)
    call EnableTrigger(GetTriggeringTrigger())
endfunction

