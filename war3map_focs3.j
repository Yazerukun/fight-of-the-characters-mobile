//===========================================================================
// Trigger: DuelTaget1
//===========================================================================
function Trig_DuelTaget1_Func001C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(0) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(1) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(2) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(3) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(4) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(5) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(6) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(7) ) ) then
        return true
    endif
    return false
endfunction

function Trig_DuelTaget1_Conditions takes nothing returns boolean
    if ( not Trig_DuelTaget1_Func001C() ) then
        return false
    endif
    if ( not ( GetOrderedUnit() == udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))] ) ) then
        return false
    endif
    if ( not ( GetIssuedOrderIdBJ() != String2OrderIdBJ("move") ) ) then
        return false
    endif
    if ( not ( GetIssuedOrderIdBJ() != String2OrderIdBJ("stop") ) ) then
        return false
    endif
    return true
endfunction

function Trig_DuelTaget1_Func011Func003C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(0) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(1) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(2) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetOrderedUnit()) == Player(3) ) ) then
        return true
    endif
    return false
endfunction

function Trig_DuelTaget1_Func011C takes nothing returns boolean
    if ( not Trig_DuelTaget1_Func011Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_DuelTaget1_Actions takes nothing returns nothing
    call RemoveLocation(udg_DftCamera2[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))])
    call ExplodeUnitBJ(udg_DftCameraU[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))])
    call RemoveUnit(udg_DftCameraU[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))])
    set udg_DftCamera2[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))]=GetOrderPointLoc()
    call CreateNUnitsAtLoc(1, 'e0BI', GetOwningPlayer(GetOrderedUnit()), udg_DftCamera2[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))], bj_UNIT_FACING)
    set udg_DftCameraU[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))]=GetLastCreatedUnit()
    if ( Trig_DuelTaget1_Func011C() ) then
