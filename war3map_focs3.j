function Trig_gumdo_______u_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_KenpachiT)
    call UnitDamageTargetBJ(udg_KenGum, udg_KenGum2, I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_KenGum, true)), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_ENHANCED)
    call CreateNUnitsAtLoc(1, 'e00M', GetOwningPlayer(udg_KenGum), GetUnitLoc(udg_KenGum2), bj_UNIT_FACING)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraSetEQNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()), 6.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction(2)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraClearNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set udg_KenGum=null
    set udg_KenGum2=null
endfunction

