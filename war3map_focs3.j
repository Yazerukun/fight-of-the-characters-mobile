        else
            call CreateNUnitsAtLoc(1, 'e0AL', GetOwningPlayer(udg_MadaraR[0]), udg_MadaraRL[0], udg_MadaraRT)
            set udg_MadaraR[6]=GetLastCreatedUnit()
            call SetUnitTimeScalePercent(udg_MadaraR[6], 120.00)
        endif
    endif
    set udg_MadaraRL[1]=PolarProjectionBJ(udg_MadaraRL[0], GetRandomReal(200.00, - 200.00), GetRandomDirectionDeg())
    set udg_MadaraRL[2]=PolarProjectionBJ(udg_MadaraRL[0], GetRandomReal(200.00, - 200.00), GetRandomDirectionDeg())
    set udg_MadaraRL[3]=PolarProjectionBJ(udg_MadaraRL[0], GetRandomReal(200.00, - 200.00), GetRandomDirectionDeg())
    set udg_MadaraRL[4]=PolarProjectionBJ(udg_MadaraRL[0], GetRandomReal(200.00, - 200.00), GetRandomDirectionDeg())
    set udg_MadaraRL[5]=PolarProjectionBJ(udg_MadaraRL[0], GetRandomReal(200.00, - 200.00), GetRandomDirectionDeg())
    call CreateNUnitsAtLoc(1, 'e0AI', GetOwningPlayer(udg_MadaraR[0]), udg_MadaraRL[1], udg_MadaraRT)
    set udg_MadaraR[1]=GetLastCreatedUnit()
