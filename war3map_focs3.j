//===========================================================================
function Trig_deathmassage_Func004C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(0) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(1) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(2) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(3) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(4) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(5) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(6) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetDyingUnit()) == Player(7) ) ) then
        return true
    endif
    return false
endfunction

function Trig_deathmassage_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not Trig_deathmassage_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_deathmassage_Func001C takes nothing returns boolean
    if ( not ( udg_GameDuelOn == false ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(GetOwningPlayer(GetDyingUnit())) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_deathmassage_Func002Func002C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(0) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(1) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(2) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(3) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(4) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(5) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(6) ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetKillingUnitBJ()) == Player(7) ) ) then
        return true
    endif
    return false
endfunction

function Trig_deathmassage_Func002Func008C takes nothing returns boolean
    if ( not ( GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit())) <= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_deathmassage_Func002Func009Func005C takes nothing returns boolean
    if ( not ( udg_GameDuelTeamRed == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_deathmassage_Func002Func009C takes nothing returns boolean
    if ( not ( udg_GameDuelTeamBlue == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_deathmassage_Func002C takes nothing returns boolean
    if ( not ( udg_GameDuelOn == true ) ) then
        return false
    endif
    if ( not Trig_deathmassage_Func002Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_deathmassage_Actions takes nothing returns nothing
    if ( Trig_deathmassage_Func001C() ) then
        call TriggerSleepAction(4.00)
        call ReviveHeroLoc(GetDyingUnit(), GetPlayerStartLocationLoc(GetOwningPlayer(GetDyingUnit())), true)
    else
    endif
    if ( Trig_deathmassage_Func002C() ) then
        set udg_WichiUnitGhost[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]=udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]
        call CreateNUnitsAtLoc(1, 'e0BJ', GetOwningPlayer(GetDyingUnit()), udg_DftCamera[0], bj_UNIT_FACING)
        set udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]=GetLastCreatedUnit()
        call RemoveLocation(udg_DftCamera2[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))])
        set udg_DftCamera2[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]=GetRectCenter(gg_rct_SelZoneCenter)
        if ( Trig_deathmassage_Func002Func008C() ) then
            set udg_GameDuelTeamRed=( udg_GameDuelTeamRed - 1 )
            call DisplayTextToForce(GetPlayersAll(), ( "|cffff4500(!)레드팀 생명 : " + I2S(udg_GameDuelTeamRed) ))
        else
            set udg_GameDuelTeamBlue=( udg_GameDuelTeamBlue - 1 )
            call DisplayTextToForce(GetPlayersAll(), ( "|cff1e90ff(!)블루팀 생명 : " + I2S(udg_GameDuelTeamBlue) ))
        endif
        if ( Trig_deathmassage_Func002Func009C() ) then
            call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_3989")
            call StartTimerBJ(udg_GameDuelTimer, false, 0.01)
            call TriggerSleepAction(1.00)
            call TriggerExecute(gg_trg_GoldGoRed1)
        else
            if ( Trig_deathmassage_Func002Func009Func005C() ) then
                call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_4006")
                call StartTimerBJ(udg_GameDuelTimer, false, 0.01)
                call TriggerSleepAction(1.00)
                call TriggerExecute(gg_trg_GoldGoBlue1)
            else
            endif
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_deathmassage takes nothing returns nothing
    set gg_trg_deathmassage=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_deathmassage, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_deathmassage, Condition(function Trig_deathmassage_Conditions))
    call TriggerAddAction(gg_trg_deathmassage, function Trig_deathmassage_Actions)
endfunction

//===========================================================================
// Trigger: GoldGoBlue1
//===========================================================================
function Trig_GoldGoBlue1_Actions takes nothing returns nothing
    set udg_GameDuelLVRed=( GetHeroLevel(udg_WichiUnit[1]) + ( GetHeroLevel(udg_WichiUnit[2]) + ( GetHeroLevel(udg_WichiUnit[3]) + GetHeroLevel(udg_WichiUnit[4]) ) ) )
    set udg_GameDuelLVRed=( udg_GameDuelLVRed * 150 )
    call DisplayTextToForce(GetPlayersAll(), ( "|cff1e90ff(!)블루팀에게 상금 " + ( I2S(udg_GameDuelLVRed) + "원이 지급됩니다!!!" ) ))
    call AdjustPlayerStateBJ(udg_GameDuelLVRed, Player(4), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(udg_GameDuelLVRed, Player(5), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(udg_GameDuelLVRed, Player(6), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(udg_GameDuelLVRed, Player(7), PLAYER_STATE_RESOURCE_GOLD)
endfunction

