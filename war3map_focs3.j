    endif
    return true
endfunction

function Trig_begi________2________2_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_SasukeW1)
    call SetUnitAnimation(udg_saber_Bu, "Spell One")
    call SetUnitTimeScalePercent(udg_saber_Bu, 100)
    set udg_saber_Bu3=GetUnitLoc(udg_saber_Bu2)
    if ( Trig_begi________2________2_Func005C() ) then
        call SetUnitPositionLocFacingLocBJ(udg_saber_Bu, udg_saber_Bu3, udg_saber_Bu3)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call CreateNUnitsAtLoc(1, 'e03P', GetOwningPlayer(udg_saber_Bu), PolarProjectionBJ(udg_saber_Bu3, 100.00, ( I2R(GetForLoopIndexA()) * 45.00 )), bj_UNIT_FACING)
            call CreateNUnitsAtLoc(1, 'e00Y', GetOwningPlayer(udg_saber_Bu), PolarProjectionBJ(udg_saber_Bu3, 100.00, ( I2R(GetForLoopIndexA()) * 45.00 )), bj_UNIT_FACING)
            call CreateNUnitsAtLoc(1, 'e03P', GetOwningPlayer(udg_saber_Bu), PolarProjectionBJ(udg_saber_Bu3, 50.00, ( I2R(GetForLoopIndexA()) * 45.00 )), bj_UNIT_FACING)
            call CreateNUnitsAtLoc(1, 'e00Y', GetOwningPlayer(udg_saber_Bu), PolarProjectionBJ(udg_saber_Bu3, 50.00, ( I2R(GetForLoopIndexA()) * 45.00 )), bj_UNIT_FACING)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        if ( Trig_begi________2________2_Func005Func004C() ) then
            call CreateNUnitsAtLoc(1, 'e03X', GetOwningPlayer(udg_saber_Bu), udg_saber_Bu3, bj_UNIT_FACING)
            call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_saber_Bu2)
        else
            if ( Trig_begi________2________2_Func005Func004Func001C() ) then
                call CreateNUnitsAtLoc(1, 'e03X', GetOwningPlayer(udg_saber_Bu), udg_saber_Bu3, bj_UNIT_FACING)
                call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_saber_Bu2)
            else
                if ( Trig_begi________2________2_Func005Func004Func001Func001C() ) then
                    call CreateNUnitsAtLoc(1, 'e03X', GetOwningPlayer(udg_saber_Bu), udg_saber_Bu3, bj_UNIT_FACING)
                    call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                    call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                    call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_saber_Bu2)
                else
                    if ( Trig_begi________2________2_Func005Func004Func001Func001Func001C() ) then
                        call CreateNUnitsAtLoc(1, 'e03X', GetOwningPlayer(udg_saber_Bu), udg_saber_Bu3, bj_UNIT_FACING)
                        call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                        call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                        call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_saber_Bu2)
                    else
                        call CreateNUnitsAtLoc(1, 'e03X', GetOwningPlayer(udg_saber_Bu), udg_saber_Bu3, bj_UNIT_FACING)
                        call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                        call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                        call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                        call IncUnitAbilityLevelSwapped('A0FO', GetLastCreatedUnit())
                        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_saber_Bu2)
                    endif
                endif
            endif
        endif
    else
    endif
    call RemoveLocation(udg_saber_Bu3)
    set udg_saber_Bu=null
    set udg_saber_Bu2=null
endfunction

