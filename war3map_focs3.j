function HU takes nothing returns boolean
	return ( GetSpellAbilityId() == 'A08U' )
endfunction

function jU takes nothing returns nothing
	set udg_integer104=0
	set udg_unit137=GetTriggerUnit()
	set udg_unit138=GetSpellTargetUnit()
	call StartTimerBJ(udg_timer95, true, .1)
endfunction

function kU takes nothing returns boolean
	return ( udg_integer104 == 7 )
endfunction

function KU takes nothing returns nothing
	if ( (udg_integer104 == 7) ) then // INLINED!!
		call PauseTimerBJ(true, udg_timer95)
	else
		set udg_integer104=( udg_integer104 + 1 )
		call SetUnitAnimation(udg_unit137, "attack")
		call QueueUnitAnimation(udg_unit137, "stand")
		call CreateNUnitsAtLoc(1, 'h016', GetOwningPlayer(udg_unit137), GetUnitLoc(udg_unit137), bj_UNIT_FACING)
		call UnitAddAbility(bj_lastCreatedUnit, 'A08V')
		call IssueTargetOrderById(bj_lastCreatedUnit, 852095, udg_unit138)
	endif
endfunction

function LU takes nothing returns nothing
	call DestroyTrigger(udg_trigger111)
	call PauseTimerBJ(true, udg_timer197)
