        call UnitApplyTimedLifeBJ(2.00, 'BHwe', GetLastCreatedUnit())
        call RemoveLocation(udg_broutoloc[8])
        call DestroyGroup(udg_broutOGROUP[0])
        call PauseTimerBJ(true, udg_broutotimer[1])
