    if ( not ( udg_HiddenChar[1] == false ) ) then
        return false
    endif
    if ( not ( udg_Random_Hidden[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleHidden_Func005C takes nothing returns boolean
    if ( not ( udg_Random_Hidden[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleHidden_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    call ShowUnitHide(GetTriggerUnit())
    call SetPlayerAbilityAvailableBJ(false, 'A0O9', GetOwningPlayer(GetTriggerUnit()))
    set udg_Random_Hidden[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]=GetRandomInt(1, 10)
    if ( Trig_ruleHidden_Func005C() ) then
        set udg_Random_Hidden[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]=GetRandomInt(2, 2)
        if ( Trig_ruleHidden_Func005Func008C() ) then
            call ShowUnitShow(GetTriggerUnit())
            call RemoveUnit(GetTriggerUnit())
            call RemoveUnit(gg_unit_H026_0060)
            call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetSpellAbilityUnit()), GetRectCenter(gg_rct_Sel), 0)
            call CreateNUnitsAtLoc(1, 'H026', GetOwningPlayer(GetTriggerUnit()), GetRectCenter(gg_rct_Sel), bj_UNIT_FACING)
            call DisplayTextToForce(bj_FORCE_ALL_PLAYERS, ( "|c00ff0000" + ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + ( "|r|c0000ffff님께서|r " + ( "|c0000ff40" + ( GetUnitName(bj_lastCreatedUnit) + ( "|r|c0000ffff을(를) 선택하셨습니다.|r" ) ) ) ) ) ))
            call SetPlayerName(GetOwningPlayer(GetTriggerUnit()), ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + ( "(" + ( GetHeroProperName(bj_lastCreatedUnit) + ")" ) ) ))
            if ( Trig_ruleHidden_Func005Func008Func010C() ) then
                call MultiboardSetItemIconBJ(udg_multiboard01, 1, ( ( 1 + GetPlayerId(GetOwningPlayer(GetTriggerUnit())) ) + 1 ), "ReplaceableTextures\\CommandButtons\\BTNBTNHeadhunter.blp")
            else
                call MultiboardSetItemIconBJ(udg_multiboard01, 1, ( ( 1 + GetPlayerId(GetOwningPlayer(GetTriggerUnit())) ) + 2 ), "ReplaceableTextures\\CommandButtons\\BTNBTNHeadhunter.blp")
            endif
            set udg_HiddenChar[1]=true
        else
            if ( Trig_ruleHidden_Func005Func008Func001C() ) then
                call ShowUnitShow(GetTriggerUnit())
                call RemoveUnit(GetTriggerUnit())
                call RemoveUnit(gg_unit_H018_0114)
                call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetSpellAbilityUnit()), GetRectCenter(gg_rct_Sel), 0)
                call CreateNUnitsAtLoc(1, 'H018', GetOwningPlayer(GetTriggerUnit()), GetRectCenter(gg_rct_Sel), bj_UNIT_FACING)
                call DisplayTextToForce(bj_FORCE_ALL_PLAYERS, ( "|c00ff0000" + ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + ( "|r|c0000ffff님께서|r " + ( "|c0000ff40" + ( GetUnitName(bj_lastCreatedUnit) + ( "|r|c0000ffff을(를) 선택하셨습니다.|r" ) ) ) ) ) ))
                call SetPlayerName(GetOwningPlayer(GetTriggerUnit()), ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + ( "(" + ( GetHeroProperName(bj_lastCreatedUnit) + ")" ) ) ))
                if ( Trig_ruleHidden_Func005Func008Func001Func014C() ) then
                    call MultiboardSetItemIconBJ(udg_multiboard01, 1, ( ( 1 + GetPlayerId(GetOwningPlayer(GetTriggerUnit())) ) + 1 ), "ReplaceableTextures\\CommandButtons\\BTNHeroBlademaster.blp")
                else
                    call MultiboardSetItemIconBJ(udg_multiboard01, 1, ( ( 1 + GetPlayerId(GetOwningPlayer(GetTriggerUnit())) ) + 2 ), "ReplaceableTextures\\CommandButtons\\BTNHeroBlademaster.blp")
                endif
                set udg_HiddenChar[2]=true
            else
                call ShowUnitShow(GetTriggerUnit())
                call ClearSelectionForPlayer(GetOwningPlayer(GetTriggerUnit()))
                call SelectUnitForPlayerSingle(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
                call IssueImmediateOrderBJ(GetTriggerUnit(), "creepthunderclap")
                call EnableTrigger(GetTriggeringTrigger())
            endif
        endif
    else
        call ShowUnitShow(GetTriggerUnit())
        call ClearSelectionForPlayer(GetOwningPlayer(GetTriggerUnit()))
        call SelectUnitForPlayerSingle(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
        call IssueImmediateOrderBJ(GetTriggerUnit(), "creepthunderclap")
        call EnableTrigger(GetTriggeringTrigger())
    endif
endfunction

