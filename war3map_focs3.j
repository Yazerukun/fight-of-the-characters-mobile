//===========================================================================
function Trig_Boowoo2_Func002001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'Osam' )
endfunction

function Trig_Boowoo2_Func002A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_boowooU2)
endfunction

function Trig_Boowoo2_Func004Func005C takes nothing returns boolean
    if ( not ( udg_integer118 <= 40 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boowoo2_Func004C takes nothing returns boolean
    if ( not ( udg_RPGMODE == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Boowoo2_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectMatching(GetEntireMapRect(), Condition(function Trig_Boowoo2_Func002001002)), function Trig_Boowoo2_Func002A)
    set udg_boowooU=GroupPickRandomUnit(udg_boowooU2)
    if ( Trig_Boowoo2_Func004C() ) then
        call UnitAddItemByIdSwapped('I04C', udg_boowooU)
        call IncUnitAbilityLevelSwapped('A06L', udg_boowooU)
        call SetHeroLevelBJ(udg_boowooU, 5000, false)
    else
        if ( Trig_Boowoo2_Func004Func005C() ) then
            call UnitAddItemByIdSwapped('I00S', udg_boowooU)
        else
            call UnitAddItemByIdSwapped('I03S', udg_boowooU)
        endif
    endif
endfunction

