//===========================================================================
function Trig_BloodC_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0JQ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BloodC_Func005Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_BloodP)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BloodC_Func005A takes nothing returns nothing
    if ( Trig_BloodC_Func005Func001C() ) then
        set udg_BloodTLC=GetUnitLoc(GetEnumUnit())
        call CreateNUnitsAtLoc(1, 'e071', GetOwningPlayer(udg_BloodP), udg_BloodTLC, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", GetEnumUnit())
        call CreateNUnitsAtLoc(1, 'e071', GetOwningPlayer(udg_BloodP), udg_BloodTLC, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "drunkenhaze", udg_BloodP)
        call RemoveLocation(udg_BloodTLC)
        call UnitDamageTargetBJ(udg_BloodP, GetEnumUnit(), 200.00, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
        call UnitDamageTargetBJ(udg_BloodP, GetEnumUnit(), I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_BloodP, true)), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
        set udg_Blood3=( udg_Blood3 + 1 )
    else
    endif
endfunction

function Trig_BloodC_Func007C takes nothing returns boolean
    if ( not ( udg_Blood3 <= 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BloodC_Actions takes nothing returns nothing
    set udg_BloodP=GetSpellAbilityUnit()
    set udg_BloodLC=GetSpellTargetLoc()
    call CreateNUnitsAtLocFacingLocBJ(1, 'e0C8', GetOwningPlayer(udg_BloodP), udg_BloodLC, udg_BloodLC)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(300.00, udg_BloodLC), function Trig_BloodC_Func005A)
    call TriggerSleepAction(0.20)
    if ( Trig_BloodC_Func007C() ) then
        call DisplayTextToPlayer(GetOwningPlayer(udg_BloodP), 0, 0, ( "|c00ff0000흡수한 능력치 : " + I2S(R2I(udg_Blood3)) ))
    else
        set udg_Blood3=100.00
        call DisplayTextToPlayer(GetOwningPlayer(udg_BloodP), 0, 0, ( "|c00ff0000흡수한 능력치 : " + I2S(R2I(udg_Blood3)) ))
    endif
    set udg_BloodP=null
endfunction

