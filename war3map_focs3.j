//===========================================================================
function Trig_SimpanCamera1_Conditions takes nothing returns boolean
    if ( not ( SubStringBJ(GetEventPlayerChatString(), 1, 1) == "#" ) ) then
        return false
    endif
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 2, 2)) >= 0 ) ) then
        return false
    endif
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 2, 2)) <= 8 ) ) then
        return false
    endif
    if ( not ( udg_SimpanN[GetConvertedPlayerId(GetTriggerPlayer())] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SimpanCamera1_Func001Func001Func004C takes nothing returns boolean
    if ( ( IsUnitType(udg_WichiUnit[S2I(SubStringBJ(GetEventPlayerChatString(), 2, 2))], UNIT_TYPE_HERO) == true ) ) then
        return true
    endif
    if ( ( IsUnitAliveBJ(udg_WichiUnit[S2I(SubStringBJ(GetEventPlayerChatString(), 2, 2))]) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_SimpanCamera1_Func001Func001C takes nothing returns boolean
    if ( not Trig_SimpanCamera1_Func001Func001Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_SimpanCamera1_Func001Func002C takes nothing returns boolean
    if ( not ( udg_GameDuelOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_SimpanCamera1_Func001C takes nothing returns boolean
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 2, 2)) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SimpanCamera1_Actions takes nothing returns nothing
    if ( Trig_SimpanCamera1_Func001C() ) then
        if ( Trig_SimpanCamera1_Func001Func002C() ) then
            call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 1.50, "TRIGSTR_12556")
            set udg_SimpanNC[GetConvertedPlayerId(GetTriggerPlayer())]=false
        else
            call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 1.50, "TRIGSTR_12557")
        endif
    else
        if ( Trig_SimpanCamera1_Func001Func001C() ) then
            call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 1.50, ( "플레이어" + ( SubStringBJ(GetEventPlayerChatString(), 2, 2) + "에게 카메라를 고정합니다." ) ))
            set udg_SimpanPC[GetConvertedPlayerId(GetTriggerPlayer())]=S2I(SubStringBJ(GetEventPlayerChatString(), 2, 2))
            set udg_SimpanNC[GetConvertedPlayerId(GetTriggerPlayer())]=true
        else
        endif
    endif
endfunction

