    set gg_trg_killbonus=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_killbonus, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_killbonus, Condition(function Trig_killbonus_Conditions))
    call TriggerAddAction(gg_trg_killbonus, function Trig_killbonus_Actions)
endfunction

//===========================================================================
// Trigger: MSDteachE1
//===========================================================================
function Trig_MSDteachE1_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0T0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MSDteachE1_Func002Func004001002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h029' )
endfunction

function Trig_MSDteachE1_Func002Func004A takes nothing returns nothing
    set udg_MSDteachEml=GetUnitLoc(GetEnumUnit())
    call AddSpecialEffectLocBJ(udg_MSDteachEml, "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_MSDteachEml)
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_MSDteachE1_Func002C takes nothing returns boolean
    if ( not ( udg_MSDteachEb == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MSDteachE1_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_MSDTeachE)
    if ( Trig_MSDteachE1_Func002C() ) then
        call TerrainDeformationCraterBJ(0.5, true, udg_MSDteachEl, 400.00, - 200.00)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRectMatching(GetEntireMapRect(), Condition(function Trig_MSDteachE1_Func002Func004001002)), function Trig_MSDteachE1_Func002Func004A)
    else
        set udg_MSDteachEb=true
    endif
    set udg_MSDteachEl=GetSpellTargetLoc()
    set udg_MSDteachEr[1]=GetLocationX(udg_MSDteachEl)
    set udg_MSDteachEr[2]=GetLocationY(udg_MSDteachEl)
    set udg_MSDteachEr[3]=0.00
    set udg_MSDteachEu=GetTriggerUnit()
    call UnitAddItemByIdSwapped('I049', udg_MSDteachEu)
    call CreateNUnitsAtLocFacingLocBJ(1, 'n02Y', GetOwningPlayer(udg_MSDteachEu), udg_MSDteachEl, udg_MSDteachEl)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'B025', 11)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLocFacingLocBJ(1, 'h029', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(udg_MSDteachEl, 400.00, ( 20.00 * I2R(GetForLoopIndexA()) )), udg_MSDteachEl)
        call SetUnitVertexColorBJ(GetLastCreatedUnit(), 0.00, 0.00, 0.00, 25.00)
        call SetUnitPathing(GetLastCreatedUnit(), false)
        call SetUnitPositionLocFacingLocBJ(GetLastCreatedUnit(), PolarProjectionBJ(udg_MSDteachEl, 400.00, ( 20.00 * I2R(GetForLoopIndexA()) )), udg_MSDteachEl)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TerrainDeformationCraterBJ(0.5, true, udg_MSDteachEl, 400.00, 200.00)
    call EnableTrigger(gg_trg_MSDteachE3)
    call StartTimerBJ(udg_MSDteachEt2, true, 0.10)
    call StartTimerBJ(udg_MSDteachEt, false, 10.50)
endfunction

//===========================================================================
function InitTrig_MSDteachE1 takes nothing returns nothing
    set gg_trg_MSDteachE1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MSDteachE1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_MSDteachE1, Condition(function Trig_MSDteachE1_Conditions))
    call TriggerAddAction(gg_trg_MSDteachE1, function Trig_MSDteachE1_Actions)
endfunction

