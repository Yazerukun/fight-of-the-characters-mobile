    set udg_GameDuelLVBlue=( udg_GameDuelLVBlue * 150 )
    call DisplayTextToForce(GetPlayersAll(), ( "|cffff4500(!)레드팀에게 상금 " + ( I2S(udg_GameDuelLVBlue) + "원이 지급됩니다!!!" ) ))
    call AdjustPlayerStateBJ(udg_GameDuelLVBlue, Player(0), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(udg_GameDuelLVBlue, Player(1), PLAYER_STATE_RESOURCE_GOLD)
    call AdjustPlayerStateBJ(udg_GameDuelLVBlue, Player(2), PLAYER_STATE_RESOURCE_GOLD)
