    set gg_trg_brouto_c1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_brouto_c1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_brouto_c1, Condition(function Trig_brouto_c1_Conditions))
    call TriggerAddAction(gg_trg_brouto_c1, function Trig_brouto_c1_Actions)
endfunction

