    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Ulu), udg_Ul) < 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Loop_Actions takes nothing returns nothing
    set udg_Charge_Point[3]=GetUnitLoc(udg_Charge_Unit)
    set udg_Charge_Real[3]=( udg_Charge_Real[3] + udg_Charge_Real[1] )
    call SetUnitPositionLoc(udg_Charge_Unit, PolarProjectionBJ(udg_Charge_Point[3], 10.00, udg_Angle))
    if ( Trig_Charge_Loop_Func004C() ) then
        call DisableTrigger(GetTriggeringTrigger())
        call DisableTrigger(gg_trg_Animation)
        call ResetUnitAnimation(udg_Charge_Unit)
    else
    endif
    call DestroyGroup(udg_Group)
    call RemoveLocation(udg_Charge_Point[3])
endfunction

