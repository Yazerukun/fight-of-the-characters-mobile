    call CreateNUnitsAtLoc(1, 'e08G', GetOwningPlayer(GetTriggerUnit()), udg_AzenRL, bj_UNIT_FACING)
    set udg_AzenRU=GetLastCreatedUnit()
    call StartTimerBJ(udg_AzenRT, true, 0.01)
    call TriggerSleepAction(2.50)
    call PlaySoundBJ(gg_snd_AzenR)
    call PauseTimerBJ(true, udg_AzenRT)
    call TriggerSleepAction(0.50)
    call RemoveUnit(udg_AzenRU)
    call CreateNUnitsAtLoc(1, 'e08I', GetOwningPlayer(GetTriggerUnit()), udg_AzenRL, bj_UNIT_FACING)
    set udg_AzenRU=GetLastCreatedUnit()
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call AddSpecialEffectLocBJ(PolarProjectionBJ(udg_AzenRL, 450.00, ( 30.00 * I2R(GetForLoopIndexA()) )), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

