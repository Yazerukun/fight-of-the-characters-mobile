function Trig_DuelEndSet1_Actions takes nothing returns nothing
    call DestroyTimerDialogBJ(udg_GameDuelTimer3)
    call StartTimerBJ(udg_GameDuelTimer2, false, 300.00)
    call CreateTimerDialogBJ(GetLastCreatedTimerBJ(), "TRIGSTR_8770")
    set udg_GameDuelTimer4=GetLastCreatedTimerDialogBJ()
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call TimerDialogDisplayForPlayerBJ(true, udg_GameDuelTimer4, ConvertedPlayer(GetForLoopIndexA()))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call EnableWeatherEffect(GetLastCreatedWeatherEffect(), false)
    set bj_wantDestroyGroup=true
    call EnumItemsInRectBJ(gg_rct_DuelZone2, function Trig_DuelEndSet1_Func008A)
    set bj_wantDestroyGroup=true
    call EnumDestructablesInRectAll(gg_rct_DuelZone2, function Trig_DuelEndSet1_Func010A)
    call SetTerrainTypeBJ(GetRectCenter(gg_rct_DuelMap1), 'Alvd', - 1, 10, 1)
    call SetTerrainTypeBJ(GetRectCenter(gg_rct_DuelMap2), 'Alvd', - 1, 10, 1)
    call EnableTrigger(gg_trg_DuelZoneSkill)
    call EnableTrigger(gg_trg_DuelZoneDontMove1)
    call EnableTrigger(gg_trg_DuelZoneDontMove2)
    call EnableTrigger(gg_trg_DuelZoneDontMove3)
    call DisableTrigger(gg_trg_DuelZoneDontMove4)
    call DisableTrigger(gg_trg_DuelZoneDontMove5)
    call DisableTrigger(gg_trg_DuelZoneDontMove6)
    call DisableTrigger(gg_trg_DuelTaget1)
    call DisableTrigger(gg_trg_DuelTaget2)
    set udg_GameDuelOn=false
    call RemoveLocation(udg_DftCamera[0])
    set udg_DftCamera[13]=GetRectCenter(gg_rct_RedTeam1)
    set udg_DftCamera[14]=GetRectCenter(gg_rct_BlueTeam1)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_DuelEndSet1_Func027Func001C() ) then
            if ( Trig_DuelEndSet1_Func027Func001Func001C() ) then
                call KillUnit(udg_WichiUnit[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))])
                set udg_WichiUnit[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))]=udg_WichiUnitGhost[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))]
                if ( Trig_DuelEndSet1_Func027Func001Func001Func004C() ) then
                    call ReviveHeroLoc(udg_WichiUnit[GetForLoopIndexA()], GetPlayerStartLocationLoc(GetOwningPlayer(udg_WichiUnit[GetForLoopIndexA()])), true)
                else
                endif
            else
                if ( Trig_DuelEndSet1_Func027Func001Func001Func001C() ) then
                    call ReviveHeroLoc(udg_WichiUnit[GetForLoopIndexA()], GetPlayerStartLocationLoc(GetOwningPlayer(udg_WichiUnit[GetForLoopIndexA()])), true)
                else
                endif
            endif
            call RemoveLocation(udg_DftCamera2[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))])
            call ExplodeUnitBJ(udg_DftCameraU[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))])
            call RemoveUnit(udg_DftCameraU[GetConvertedPlayerId(GetOwningPlayer(GetOrderedUnit()))])
            call SetCameraFieldForPlayer(ConvertedPlayer(GetForLoopIndexA()), CAMERA_FIELD_ANGLE_OF_ATTACK, - 56.00, 0.00)
            call SetCameraFieldForPlayer(ConvertedPlayer(GetForLoopIndexA()), CAMERA_FIELD_ZOFFSET, 0.00, 0.00)
            call SetCameraFieldForPlayer(ConvertedPlayer(GetForLoopIndexA()), CAMERA_FIELD_ROTATION, 90.00, 0.50)
            call PauseTimerBJ(true, udg_SimpanT[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))])
        else
            set udg_DftCamera[GetForLoopIndexA()]=GetUnitLoc(udg_WichiUnit[udg_SimpanPC[GetForLoopIndexA()]])
            call PanCameraToTimedLocForPlayer(ConvertedPlayer(GetForLoopIndexA()), udg_DftCamera[GetForLoopIndexA()], 0.50)
            call RemoveLocation(udg_DftCamera[GetForLoopIndexA()])
            call SetCameraFieldForPlayer(ConvertedPlayer(GetForLoopIndexA()), CAMERA_FIELD_ANGLE_OF_ATTACK, - 56.00, 0.00)
            call SetCameraFieldForPlayer(ConvertedPlayer(GetForLoopIndexA()), CAMERA_FIELD_ZOFFSET, 0.00, 0.00)
            call SetCameraFieldForPlayer(ConvertedPlayer(GetForLoopIndexA()), CAMERA_FIELD_ROTATION, 90.00, 0.50)
            call PauseTimerBJ(false, udg_SimpanT[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))])
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_DuelEndSet1_Func028Func001C() ) then
            set udg_SimpanNC[GetConvertedPlayerId(GetTriggerPlayer())]=false
            set udg_SimpanPC[GetForLoopIndexA()]=udg_SimpanPC2
        else
