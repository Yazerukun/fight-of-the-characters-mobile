function Trig_C1_Bombing2_Actions takes nothing returns nothing
    set udg_RSkillDei=null
    call SetUnitPathing(udg_RSkillDei, true)
    call DisableTrigger(gg_trg_Loop_______u)
    call DisableTrigger(gg_trg_Loop1_______u)
    set udg_C1_Bombing_tnf=true
    set udg_C1_Bombing=gg_rct_C1_Bombing
    set udg_C1_Bombingu=CreateGroup()
    call MoveRectToLoc(udg_C1_Bombing, GetUnitLoc(GetSpellAbilityUnit()))
    call EnableTrigger(gg_trg_C1_Bombing3)
    call StartTimerBJ(udg_C1_Bombing_t, false, 0.00)
    call TriggerSleepAction(1.00)
    call DisableTrigger(gg_trg_C1_Bombing3)
    if ( Trig_C1_Bombing2_Func013C() ) then
        call PlaySoundBJ(gg_snd_DeiQskill)
        call ForGroupBJ(udg_C1_Bombingu, function Trig_C1_Bombing2_Func013Func006002)
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call ForGroupBJ(udg_C1_Bombingu, function Trig_C1_Bombing2_Func013Func008A)
        call ForGroupBJ(udg_C1_Bombingu, function Trig_C1_Bombing2_Func013Func009002)
        call DestroyGroup(udg_C1_Bombingu)
    else
        call ForGroupBJ(udg_C1_Bombingu, function Trig_C1_Bombing2_Func013Func001A)
        call ForGroupBJ(udg_C1_Bombingu, function Trig_C1_Bombing2_Func013Func004002)
        call DestroyGroup(udg_C1_Bombingu)
    endif
endfunction

