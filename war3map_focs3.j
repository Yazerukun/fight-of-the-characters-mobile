//===========================================================================
// Trigger: ADes
//===========================================================================
function Trig_ADes_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0HB' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ADes_Func011Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0HB', udg_AdEskUnitA) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ADes_Func011C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0HB', udg_AdEskUnitA) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ADes_Func019C takes nothing returns boolean
    if ( not ( IsUnitType(udg_AdEskUnitB, UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ADes_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_YunsungR2)
    call SetUnitInvulnerable(udg_AdEskUnitA, true)
    call SetUnitInvulnerable(udg_AdEskUnitB, true)
    call PauseUnitBJ(true, udg_AdEskUnitA)
    call PauseUnitBJ(true, udg_AdEskUnitB)
    call EnableTrigger(gg_trg_ADes________2)
    call TriggerSleepAction(2.00)
    call SetUnitInvulnerable(udg_AdEskUnitA, false)
    call SetUnitInvulnerable(udg_AdEskUnitB, false)
    call DisableTrigger(gg_trg_ADes________2)
    if ( Trig_ADes_Func011C() ) then
        call CreateNUnitsAtLocFacingLocBJ(1, 'e05E', GetOwningPlayer(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitB))
        call IncUnitAbilityLevelSwapped('A0HC', GetLastCreatedUnit())
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_AdEskUnitB)
    else
        if ( Trig_ADes_Func011Func001C() ) then
            call CreateNUnitsAtLocFacingLocBJ(1, 'e05E', GetOwningPlayer(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitB))
            call IncUnitAbilityLevelSwapped('A0HC', GetLastCreatedUnit())
            call IncUnitAbilityLevelSwapped('A0HC', GetLastCreatedUnit())
            call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_AdEskUnitB)
        else
            call CreateNUnitsAtLocFacingLocBJ(1, 'e05E', GetOwningPlayer(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitB))
            call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", udg_AdEskUnitB)
        endif
    endif
    call CreateNUnitsAtLocFacingLocBJ(1, 'e03F', GetOwningPlayer(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitB), GetUnitLoc(udg_AdEskUnitB))
    call CreateNUnitsAtLocFacingLocBJ(1, 'e03G', GetOwningPlayer(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitB), GetUnitLoc(udg_AdEskUnitB))
    call CreateNUnitsAtLocFacingLocBJ(1, 'e058', GetOwningPlayer(udg_AdEskUnitA), GetUnitLoc(udg_AdEskUnitB), GetUnitLoc(udg_AdEskUnitB))
    call PauseUnitBJ(false, udg_AdEskUnitA)
    call PauseUnitBJ(false, udg_AdEskUnitB)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call AddSpecialEffectLocBJ(PolarProjectionBJ(GetUnitLoc(udg_AdEskUnitB), 50.00, ( 30.00 * I2R(GetForLoopIndexA()) )), "Abilities\\Spells\\Items\\AIob\\AIobSpecialArt.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitAnimation(udg_AdEskUnitB, "stand")
    if ( Trig_ADes_Func019C() ) then
        call SetPlayerAbilityAvailableBJ(true, 'A0HX', GetOwningPlayer(udg_AdEskUnitA))
    else
    endif
    set udg_AdEskUnitA=null
    set udg_AdEskUnitB=null
endfunction

