    return true
endfunction

function Trig_Toshiro_Mone_01_Actions takes nothing returns nothing
    set udg_Toshiro_Move_L[0]=GetUnitLoc(udg_Toshiro_Move_U)
    if ( Trig_Toshiro_Mone_01_Func002C() ) then
        call IssueImmediateOrderBJ(udg_Toshiro_Move_U, "stop")
        call DisableTrigger(gg_trg_Toshiro_Move_07)
        call SetUnitAnimation(udg_Toshiro_Move_U, "stand")
        call RemoveLocation(udg_Toshiro_Move_L[0])
        call RemoveLocation(udg_Toshiro_Move_L[1])
    else
        if ( Trig_Toshiro_Mone_01_Func002Func004C() ) then
            if ( Trig_Toshiro_Mone_01_Func002Func004Func002C() ) then
                call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Toshiro_Move_U), udg_Toshiro_Move_L[0], GetUnitFacing(udg_Toshiro_Move_U))
                call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
                call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "BY_Wood_Effect_Texture_Frame_Ring_0.mdx")
                call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 100.00, 1000000000.00)
                call SetUnitScalePercent(GetLastCreatedUnit(), 180.00, 180.00, 180.00)
                call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
            else
            endif
            set udg_Toshiro_Move_R[1]=( udg_Toshiro_Move_R[1] + 0.02 )
            if ( Trig_Toshiro_Mone_01_Func002Func004Func004C() ) then
                set udg_Toshiro_Move_R[1]=0.00
            else
            endif
        else
        endif
        call RemoveLocation(udg_Toshiro_Move_L[0])
        call RemoveLocation(udg_Toshiro_Move_L[2])
        call StartTimerBJ(udg_Toshiro_Move, false, 0.02)
    endif
endfunction

