        call PauseUnitBJ(false, udg_AasaaUnit1)
        call SetUnitAnimation(udg_AasaaUnit1, "Spell One")
        call SetUnitTimeScalePercent(udg_AasaaUnit1, 100)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
