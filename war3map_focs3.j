//===========================================================================
function Trig_TskillClare_____________________u_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0K8' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == 'n012' ) ) then
        return false
    endif
    return true
endfunction

function Trig_TskillClare_____________________u_Func018001003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_BloodEXP0)) == true )
endfunction

function Trig_TskillClare_____________________u_Func018A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_BloodEXP0, GetEnumUnit(), udg_BloodEXP3, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_TskillClare_____________________u_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_BloodEX)
    set udg_BloodEXP0=GetTriggerUnit()
    set udg_BloodEXP1=GetUnitLoc(GetSpellTargetUnit())
    set udg_BloodEXP3=( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_BloodEXP0, true)) * 0.50 )
    set udg_BloodEXP3=( udg_BloodEXP3 + 1000.00 )
    call CreateTextTagUnitBJ(( "Damage " + I2S(R2I(udg_BloodEXP3)) ), GetSpellTargetUnit(), 0, 12.00, 100.00, 100.00, 0.00, 0)
    call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
    call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 2.50)
    call SetTextTagFadepointBJ(GetLastCreatedTextTag(), 2.50)
    call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 96.00, 90)
    call ExplodeUnitBJ(GetSpellTargetUnit())
    call RemoveUnit(GetSpellTargetUnit())
    call AddSpecialEffectLocBJ(udg_BloodEXP1, "CrimsonWake.mdx")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call CreateNUnitsAtLoc(1, 'e079', GetOwningPlayer(GetTriggerUnit()), udg_BloodEXP1, 270.00)
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 400.00)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_BloodEXP1, Condition(function Trig_TskillClare_____________________u_Func018001003)), function Trig_TskillClare_____________________u_Func018A)
    call RemoveLocation(udg_BloodEXP1)
    set udg_BloodEXP0=null
endfunction

