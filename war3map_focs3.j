        call SelectUnitForPlayerSingle(udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], GetOwningPlayer(GetTriggerUnit()))
        call RemoveLocation(udg_location34)
        call RemoveLocation(udg_location34u)
