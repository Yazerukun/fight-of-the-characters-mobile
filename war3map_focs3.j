    if ( not ( CountUnitsInGroup(udg_Chunneon0) < 8 ) ) then
        return false
    endif
    return true
endfunction

function Trig_chunneon12_Actions takes nothing returns nothing
    if ( Trig_chunneon12_Func001C() ) then
        set udg_Chunneon3=( udg_Chunneon3 + 1 )
        call CreateNUnitsAtLocFacingLocBJ(1, 'e02J', GetOwningPlayer(udg_Chunneon1), PolarProjectionBJ(GetUnitLoc(udg_Chunneon1), 500.00, ( 45.00 * udg_Chunneon3 )), GetUnitLoc(udg_Chunneon1))
        call CreateNUnitsAtLocFacingLocBJ(1, 'e02I', GetOwningPlayer(udg_Chunneon1), PolarProjectionBJ(GetUnitLoc(udg_Chunneon1), 500.00, ( 45.00 * udg_Chunneon3 )), GetUnitLoc(udg_Chunneon1))
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Chunneon0)
        call SetUnitPathing(GetLastCreatedUnit(), false)
        call SetUnitPositionLoc(GetLastCreatedUnit(), PolarProjectionBJ(GetUnitLoc(udg_Chunneon1), 500.00, ( 45.00 * udg_Chunneon3 )))
        call StartTimerBJ(udg_Chunneon2, false, 0.07)
    else
        call PlaySoundBJ(udg_sound101)
        call EnableTrigger(gg_trg_chunneon13)
        call StartTimerBJ(udg_Aaa[27], false, 0.01)
        call EnableTrigger(gg_trg_chunneon15)
        call StartTimerBJ(udg_Aaa[29], false, 0.02)
    endif
endfunction

