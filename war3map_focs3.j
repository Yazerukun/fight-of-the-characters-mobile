//===========================================================================
// Trigger: Toshiro Move
//===========================================================================
function Trig_Toshiro_Move_Func001C takes nothing returns boolean
    if ( not ( IsUnitIllusionBJ(GetTriggerUnit()) != true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O003' ) ) then
        return false
    endif
    if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return false
    endif
    return true
endfunction

function Trig_Toshiro_Move_Conditions takes nothing returns boolean
    if ( not Trig_Toshiro_Move_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Toshiro_Move_Func010C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Toshiro_Move_L[0], udg_Toshiro_Move_L[1]) >= 200.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Toshiro_Move_Actions takes nothing returns nothing
    set udg_Toshiro_Move_U=GetTriggerUnit()
    call PauseTimerBJ(true, udg_Toshiro_Move)
    call IssueImmediateOrderBJ(udg_Toshiro_Move_U, "stop")
    call RemoveLocation(udg_Toshiro_Move_L[0])
    call RemoveLocation(udg_Toshiro_Move_L[1])
    set udg_Toshiro_Move_L[0]=GetUnitLoc(udg_Toshiro_Move_U)
    set udg_Toshiro_Move_L[1]=GetOrderPointLoc()
    set udg_Toshiro_Move_R[1]=0.00
    if ( Trig_Toshiro_Move_Func010C() ) then
        call RemoveLocation(udg_Toshiro_Move_L[0])
        call EnableTrigger(gg_trg_Toshiro_Move_07)
        call StartTimerBJ(udg_Toshiro_Move, false, 0.00)
    else
        call SetUnitAnimation(udg_Toshiro_Move_U, "stand")
        call RemoveLocation(udg_Toshiro_Move_L[0])
        call RemoveLocation(udg_Toshiro_Move_L[1])
    endif
endfunction

//===========================================================================
function InitTrig_Toshiro_Move takes nothing returns nothing
    set gg_trg_Toshiro_Move=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Toshiro_Move, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddCondition(gg_trg_Toshiro_Move, Condition(function Trig_Toshiro_Move_Conditions))
    call TriggerAddAction(gg_trg_Toshiro_Move, function Trig_Toshiro_Move_Actions)
endfunction

