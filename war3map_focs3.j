function Hl takes nothing returns nothing
	call SetSkyModel("Environment\\Sky\\Sky\\SkyLight.mdl")
	call CreateMultiboardBJ(4, 12, "FOCS 전광판")
	set udg_multiboard01=bj_lastCreatedMultiboard
	set udg_integer86=1
	loop
		exitwhen udg_integer86 > 12
		call MultiboardSetItemStyleBJ(bj_lastCreatedMultiboard, 2, udg_integer86, true, false)
		call MultiboardSetItemStyleBJ(bj_lastCreatedMultiboard, 3, udg_integer86, true, false)
		set udg_integer86=udg_integer86 + 1
	endloop
	set udg_integer86=1
	loop
