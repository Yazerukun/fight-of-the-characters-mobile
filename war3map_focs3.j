    endif
    return true
endfunction

function Trig_baQ_______________2_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttacker()) == 'hatw' ) ) then
        return false
    endif
    return true
endfunction

function Trig_baQ_______________2_Actions takes nothing returns nothing
    if ( Trig_baQ_______________2_Func001C() ) then
        call ShowUnitHide(GetAttackedUnitBJ())
        call KillUnit(GetAttackedUnitBJ())
    else
        call SetUnitPositionLoc(GetAttackedUnitBJ(), GetUnitLoc(GetAttacker()))
        call ReplaceUnitBJ(GetAttackedUnitBJ(), 'n01T', bj_UNIT_STATE_METHOD_MAXIMUM)
    endif
endfunction

