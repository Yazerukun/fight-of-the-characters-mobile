//===========================================================================
// Trigger: brouto c1
//===========================================================================
function Trig_brouto_c1_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0TO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_brouto_c1_Func006001003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_brouto[0])) == true )
endfunction

function Trig_brouto_c1_Func006A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_brouto[0], GetEnumUnit(), ( 40.00 * I2R(GetHeroLevel(udg_brouto[0])) ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_brouto_c1_Func007Func005Func001C takes nothing returns boolean
    if ( not ( udg_broutointger[0] == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_brouto_c1_Func007Func005C takes nothing returns boolean
    if ( not ( udg_broutointger[0] == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_brouto_c1_Func007Func006001003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_brouto[0])) == true )
endfunction

function Trig_brouto_c1_Func007Func006A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_brouto[0], GetEnumUnit(), ( 2.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_brouto[0], true)) ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_brouto_c1_Func007C takes nothing returns boolean
    if ( not ( udg_broutointger[0] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_brouto_c1_Actions takes nothing returns nothing
    set udg_broutointger[0]=GetRandomInt(1, 3)
    call PlaySoundBJ(gg_snd_burto4)
    set udg_broutoreal[0]=0.00
    set udg_brouto[0]=GetTriggerUnit()
    set udg_broutoloc[28]=GetUnitLoc(udg_brouto[0])
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(400.00, udg_broutoloc[28], Condition(function Trig_brouto_c1_Func006001003)), function Trig_brouto_c1_Func006A)
    if ( Trig_brouto_c1_Func007C() ) then
        set udg_broutoloc[77]=GetUnitLoc(udg_brouto[0])
        call CreateNUnitsAtLoc(1, 'h02L', GetOwningPlayer(udg_brouto[0]), udg_broutoloc[77], bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(2.00, 'BHwe', GetLastCreatedUnit())
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_broutoloc[77], Condition(function Trig_brouto_c1_Func007Func006001003)), function Trig_brouto_c1_Func007Func006A)
        call RemoveLocation(udg_broutoloc[77])
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=18
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_broutoreal[0]=( udg_broutoreal[0] + 20.00 )
            set udg_broutoloc[0]=PolarProjectionBJ(GetUnitLoc(udg_brouto[0]), 150.00, udg_broutoreal[0])
            call CreateNUnitsAtLoc(1, 'h02L', GetOwningPlayer(udg_brouto[0]), udg_broutoloc[0], bj_UNIT_FACING)
            call UnitApplyTimedLifeBJ(2.00, 'BHwe', GetLastCreatedUnit())
            call RemoveLocation(udg_broutoloc[0])
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    else
        if ( Trig_brouto_c1_Func007Func005C() ) then
            set udg_broutoloc[1]=GetUnitLoc(udg_brouto[0])
            call CreateNUnitsAtLoc(1, 'h02O', GetOwningPlayer(udg_brouto[0]), udg_broutoloc[1], bj_UNIT_FACING)
            call UnitApplyTimedLifeBJ(10.00, 'BHwe', GetLastCreatedUnit())
            call RemoveLocation(udg_broutoloc[1])
        else
            if ( Trig_brouto_c1_Func007Func005Func001C() ) then
                set udg_broutoloc[2]=GetUnitLoc(udg_brouto[0])
                call CreateNUnitsAtLoc(1, 'h02P', GetOwningPlayer(udg_brouto[0]), udg_broutoloc[2], bj_UNIT_FACING)
                call UnitApplyTimedLifeBJ(5.00, 'BHwe', GetLastCreatedUnit())
                call RemoveLocation(udg_broutoloc[2])
            else
            endif
        endif
    endif
endfunction

