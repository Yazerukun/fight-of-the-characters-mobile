function InitSounds takes nothing returns nothing
    set gg_snd_saber1=CreateSound("war3mapImported\\saber1.mp3", false, false, false, 10, 10, "")
    call SetSoundDuration(gg_snd_saber1, 731)
    call SetSoundChannel(gg_snd_saber1, 0)
    call SetSoundVolume(gg_snd_saber1, 127)
    call SetSoundPitch(gg_snd_saber1, 1.0)
