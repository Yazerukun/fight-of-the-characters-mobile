function Trig_SerasRQskill________2_Actions takes nothing returns nothing
    call SetUnitX(udg_BloodBunB, GetUnitX(GetTriggerUnit()))
    call SetUnitY(udg_BloodBunB, GetUnitY(GetTriggerUnit()))
    set udg_BloodBunA=GetTriggerUnit()
    if ( Trig_SerasRQskill________2_Func004C() ) then
        set udg_Blood2=( udg_Blood2 - 1 )
        call DisplayTextToPlayer(GetOwningPlayer(udg_BloodBunA), 0, 0, ( "|c00ff0000남은 흡혈 수 : " + I2S(udg_Blood2) ))
        call UnitRemoveBuffBJ('B03B', udg_BloodBunA)
        if ( Trig_SerasRQskill________2_Func004Func005C() ) then
            call IncUnitAbilityLevelSwapped('A0KL', udg_BloodBunB)
        else
        endif
        call IssueTargetOrderBJ(udg_BloodBunB, "innerfire", udg_BloodBunA)
        call StartTimerBJ(udg_BloodBunE, false, 5.00)
    else
        call DisplayTextToPlayer(GetOwningPlayer(udg_BloodBunA), 0, 0, ( "|c00ff0000흡혈수가 부족합니다." ))
    endif
    set udg_BloodBunA=null
endfunction

