//===========================================================================
// Trigger: OnePM LOOP
//===========================================================================
function Trig_OnePM_LOOP_Func002C takes nothing returns boolean
    if ( not ( IsUnitType(udg_OnePunManE, UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'B00X') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'B029') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'B00V') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'B00T') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'B00H') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'B01A') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'BSTN') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'BPSE') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'B032') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'B02O') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_OnePunManE, 'Bmlt') != true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_OnePunManELChar, udg_OnePunManEL) >= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OnePM_LOOP_Actions takes nothing returns nothing
    set udg_OnePunManELChar=GetUnitLoc(udg_OnePunManE)
    if ( Trig_OnePM_LOOP_Func002C() ) then
        call SetUnitPositionLocFacingBJ(udg_OnePunManE, PolarProjectionBJ(udg_OnePunManELChar, 30.00, ( udg_OnePunManAngle + 180.00 )), ( udg_OnePunManAngle + 180.00 ))
        call SetUnitAnimationByIndex(udg_OnePunManE, 10)
        call SetUnitTimeScale(udg_OnePunManE, 2)
        call StartTimerBJ(udg_OnePunManTimer, false, 0.02)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call SetUnitPathing(udg_OnePunManE, true)
        call DisableTrigger(gg_trg_OnePM_LOOP2)
        call ResetUnitAnimation(udg_OnePunManE)
        call RemoveLocation(udg_OnePunManEL)
    endif
    call RemoveLocation(udg_OnePunManELChar)
endfunction

//===========================================================================
function InitTrig_OnePM_LOOP takes nothing returns nothing
    set gg_trg_OnePM_LOOP=CreateTrigger()
    call DisableTrigger(gg_trg_OnePM_LOOP)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_OnePM_LOOP, udg_OnePunManTimer)
    call TriggerAddAction(gg_trg_OnePM_LOOP, function Trig_OnePM_LOOP_Actions)
