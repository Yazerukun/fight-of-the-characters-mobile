    if ( not ( GetSpellAbilityId() == 'A0JW' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ColdB_Func014Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetEnumUnit()), GetOwningPlayer(udg_NapalmU)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ColdB_Func014A takes nothing returns nothing
    if ( Trig_ColdB_Func014Func001C() ) then
        call UnitDamageTargetBJ(udg_NapalmU, GetEnumUnit(), ( 1000.00 * I2R(GetUnitAbilityLevelSwapped('A0JW', udg_NapalmU)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        set udg_NapalmLC_2=GetUnitLoc(GetEnumUnit())
        call CreateNUnitsAtLoc(1, 'e071', GetOwningPlayer(udg_NapalmU), udg_NapalmLC_2, bj_UNIT_FACING)
        call IssueTargetOrderBJ(GetLastCreatedUnit(), "thunderbolt", GetEnumUnit())
        call RemoveLocation(udg_NapalmLC_2)
        call AddSpecialEffectTargetUnitBJ("chest", GetEnumUnit(), "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
    else
    endif
endfunction

function Trig_ColdB_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_SrsAE)
    set udg_NapalmIT=0
    set udg_NapalmLC=GetSpellTargetLoc()
    set udg_NapalmU=GetSpellAbilityUnit()
    call CreateNUnitsAtLoc(1, 'e074', GetOwningPlayer(udg_NapalmU), udg_NapalmLC, bj_UNIT_FACING)
    call SetUnitPathing(GetLastCreatedUnit(), false)
    call SetUnitPositionLoc(GetLastCreatedUnit(), udg_NapalmLC)
    call CreateNUnitsAtLoc(1, 'e076', GetOwningPlayer(udg_NapalmU), udg_NapalmLC, bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e058', GetOwningPlayer(udg_NapalmU), udg_NapalmLC, bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e07W', GetOwningPlayer(udg_NapalmU), udg_NapalmLC, bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e07C', GetOwningPlayer(udg_NapalmU), udg_NapalmLC, bj_UNIT_FACING)
    call TriggerSleepAction(0.10)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(400.00, udg_NapalmLC), function Trig_ColdB_Func014A)
    call StartTimerBJ(udg_NapalmTI, true, 1.00)
endfunction

