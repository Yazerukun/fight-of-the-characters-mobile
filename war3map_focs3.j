    if ( not ( udg_AasasU4copy < 1000.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_sas3________2_Actions takes nothing returns nothing
    if ( Trig_sas3________2_Func001C() ) then
        set udg_AasasU4copy=( udg_AasasU4copy + 125.00 )
        set udg_WindsHits[1]=PolarProjectionBJ(GetUnitLoc(udg_AasaaUnit1copy), udg_AasasU4copy, ( udg_AasaaUnit3copy - 30.00 ))
        call CreateNUnitsAtLoc(1, 'e04J', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[1], ( udg_AasaaUnit3copy - 30.00 ))
        call CreateNUnitsAtLoc(1, 'e04K', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[1], ( udg_AasaaUnit3copy - 30.00 ))
        call RemoveLocation(udg_WindsHits[1])
        set udg_WindsHits[2]=PolarProjectionBJ(GetUnitLoc(udg_AasaaUnit1copy), udg_AasasU4copy, ( udg_AasaaUnit3copy - 10.00 ))
        call CreateNUnitsAtLoc(1, 'e04J', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[2], ( udg_AasaaUnit3copy - 10.00 ))
        call CreateNUnitsAtLoc(1, 'e04K', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[2], ( udg_AasaaUnit3copy - 10.00 ))
        call RemoveLocation(udg_WindsHits[2])
        set udg_WindsHits[3]=PolarProjectionBJ(GetUnitLoc(udg_AasaaUnit1copy), udg_AasasU4copy, ( udg_AasaaUnit3copy + 10.00 ))
        call CreateNUnitsAtLoc(1, 'e04J', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[3], ( udg_AasaaUnit3copy + 10.00 ))
        call CreateNUnitsAtLoc(1, 'e04K', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[3], ( udg_AasaaUnit3copy + 10.00 ))
        call RemoveLocation(udg_WindsHits[3])
        set udg_WindsHits[4]=PolarProjectionBJ(GetUnitLoc(udg_AasaaUnit1copy), udg_AasasU4copy, ( udg_AasaaUnit3copy + 30.00 ))
        call CreateNUnitsAtLoc(1, 'e04J', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[4], ( udg_AasaaUnit3copy + 30.00 ))
        call CreateNUnitsAtLoc(1, 'e04K', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[4], ( udg_AasaaUnit3copy + 30.00 ))
        call RemoveLocation(udg_WindsHits[4])
        if ( Trig_sas3________2_Func001Func022C() ) then
            set udg_WindsHits[5]=PolarProjectionBJ(GetUnitLoc(udg_AasaaUnit1copy), udg_AasasU4copy, udg_AasaaUnit3copy)
            call CreateNUnitsAtLoc(1, 'e04J', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[5], udg_AasaaUnit3copy)
            call CreateNUnitsAtLoc(1, 'e04K', GetOwningPlayer(udg_AasaaUnit1copy), udg_WindsHits[5], udg_AasaaUnit3copy)
            call RemoveLocation(udg_WindsHits[5])
        else
        endif
        call StartTimerBJ(udg_Aaab[8], false, 0.05)
    else
        call DisableTrigger(GetTriggeringTrigger())
        set udg_AasaaUnit1copy=null
        call RemoveLocation(udg_AasaaUnit2copy2)
    endif
endfunction

