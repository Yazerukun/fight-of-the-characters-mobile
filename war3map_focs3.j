    set udg_UlAl=GetUnitLoc(udg_UlA)
    set udg_UlB=AngleBetweenPoints(GetUnitLoc(GetSpellAbilityUnit()), GetSpellTargetLoc())
    set udg_UlC=PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 10000.00, ( udg_UlB + 0.00 ))
