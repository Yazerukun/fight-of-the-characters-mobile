//===========================================================================
function Trig_rehit1_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0R7' ) ) then
        return false
    endif
    return true
endfunction

function Trig_rehit1_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_ururehit)
    set udg_GomuSu_______u=GetTriggerUnit()
    set udg_GomuSg_______u=0
    set udg_GomuSz_______u=GetSpellTargetLoc()
    set udg_GomuSs_______u=AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_GomuSu_______u), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call SetUnitInvulnerable(udg_GomuSu_______u, true)
    call PauseUnitBJ(true, udg_GomuSu_______u)
    call SetUnitPositionLoc(udg_GomuSu_______u, udg_GomuSz_______u)
    call ShowUnitHide(udg_GomuSu_______u)
    call CreateNUnitsAtLoc(1, 'e05W', GetOwningPlayer(GetTriggerUnit()), udg_GomuSz_______u, bj_UNIT_FACING)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'B025', 2)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "taunt")
    call TriggerSleepAction(0.50)
    call EnableTrigger(gg_trg_rehit2)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CameraSetEQNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()), 5.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

