function Trig_ArW3_______u_Actions takes nothing returns nothing
    if ( Trig_ArW3_______u_Func001C() ) then
        set udg_Ar_Wr2=( udg_Ar_Wr2 + 60.00 )
        call SetUnitPositionLocFacingBJ(udg_Ar_Wu1, PolarProjectionBJ(udg_Ar_Wl, udg_Ar_Wr2, udg_Ar_Wr), udg_Ar_Wr)
        call SetUnitAnimationByIndex(udg_Ar_Ru, 1)
        call StartTimerBJ(udg_Ar_Wt, false, 0.01)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call SetUnitPathing(udg_Ar_Wu1, true)
        call RemoveLocation(udg_Ar_Wl)
        set udg_Ar_Wu1=null
    endif
