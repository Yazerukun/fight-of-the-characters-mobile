// Trigger: asdasd
//===========================================================================
    function Callback takes nothing returns nothing
        local integer i=0
        loop
            exitwhen i >= udg_qn
            if GetWidgetLife(udg_queue[i]) < 0.405 then
                call RemoveItem(udg_queue[i])
            endif
            set udg_queue[i]=null
            set i=i + 1
        endloop
        set udg_qn=0
    endfunction
    function CleanCall takes nothing returns boolean
        set udg_queue[udg_qn]=GetManipulatedItem()
        set udg_qn=udg_qn + 1
        call TimerStart(udg_tic, 0.0, false, function Callback)
        return false
    endfunction
    function InitTrig_asdasd takes nothing returns nothing
        local trigger t=CreateTrigger()
        local integer i= 0
        set udg_tic=CreateTimer()
        loop
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_PICKUP_ITEM, null)
            set i=i + 1
            exitwhen i == bj_MAX_PLAYER_SLOTS
        endloop
        call TriggerAddCondition(t, Condition(function CleanCall))
    endfunction//===========================================================================
