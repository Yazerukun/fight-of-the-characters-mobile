function Trig_gameover_Actions takes nothing returns nothing
    call DestroyTrigger(gg_trg_gob2)
    call DisableTrigger(gg_trg_gob2)
    call PlaySoundBJ(gg_snd_HeroMountainKingWarcry1)
    call PauseTimerBJ(true, udg_ScoreTimer)
    set udg_Score[9]=( udg_Score[1] + ( udg_Score[2] + ( udg_Score[3] + udg_Score[4] ) ) )
    set udg_Score[10]=( udg_Score[5] + ( udg_Score[6] + ( udg_Score[7] + udg_Score[8] ) ) )
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 1, I2S(udg_Score[9]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 2, I2S(udg_Score[1]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 3, I2S(udg_Score[2]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 4, I2S(udg_Score[3]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 5, I2S(udg_Score[4]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 6, I2S(udg_Score[10]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 7, I2S(udg_Score[5]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 8, I2S(udg_Score[6]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 9, I2S(udg_Score[7]))
    call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(), 4, 10, I2S(udg_Score[8]))
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_8138")
    call TriggerSleepAction(5.00)
    if ( Trig_gameover_Func019C() ) then
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=4
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
