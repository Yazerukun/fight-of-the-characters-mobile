function Trig_brouto_q_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_brotuo2)
    set udg_brouto[2]=GetTriggerUnit()
    set udg_broutoreal[1]=AngleBetweenPoints(GetUnitLoc(udg_brouto[2]), GetSpellTargetLoc())
    set udg_broutointger[22]=0
    set udg_broutoloc[5]=GetSpellTargetLoc()
    set udg_broutoloc[99]=GetUnitLoc(udg_brouto[2])
    set udg_broutoloc[93]=PolarProjectionBJ(GetUnitLoc(udg_brouto[2]), 50.00, udg_broutoreal[1])
    set udg_broutOGROUP[0]=CreateGroup()
    call CreateNUnitsAtLoc(1, 'h02S', GetOwningPlayer(udg_brouto[2]), udg_broutoloc[93], udg_broutoreal[1])
    set udg_brouto[1]=GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ(2.00, 'BHwe', GetLastCreatedUnit())
    call SetUnitAnimation(GetLastCreatedUnit(), "spell three")
    call AddSpecialEffectTargetUnitBJ("hand right", udg_brouto[1], "war3mapImported\\RasenganImpact.mdx")
    set udg_broutoeffect[0]=GetLastCreatedEffectBJ()
    call CreateNUnitsAtLoc(1, 'h02X', GetOwningPlayer(udg_brouto[2]), udg_broutoloc[99], udg_broutoreal[1])
    call UnitApplyTimedLifeBJ(2.00, 'BHwe', GetLastCreatedUnit())
    call RemoveLocation(udg_broutoloc[99])
    call CreateNUnitsAtLoc(1, 'h02Y', GetOwningPlayer(udg_brouto[1]), udg_broutoloc[5], bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
    call SetUnitAbilityLevelSwapped('A0TW', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0TS', udg_brouto[2]))
    call UnitApplyTimedLifeBJ(2.00, 'BHwe', GetLastCreatedUnit())
    call StartTimerBJ(udg_broutotimer[1], false, 0.01)
