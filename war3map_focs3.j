function Duv takes nothing returns nothing
	set udg_location48=GetUnitLoc(GetTriggerUnit())
	set udg_unit156=GetTriggerUnit()
	set udg_integer116=1
	loop
		exitwhen udg_integer116 > 10
		call CreateNUnitsAtLoc(1, 'narg', GetOwningPlayer(GetTriggerUnit()), Zj(GetUnitLoc(GetTriggerUnit()) , GetRandomReal(50., 500.) , GetRandomReal(0, 360)), GetRandomReal(0, 360))
		set udg_integer117=GetRandomInt('d', 200)
		call SetUnitScalePercent(bj_lastCreatedUnit, I2R(udg_integer117), I2R(udg_integer117), I2R(udg_integer117))
		call CreateNUnitsAtLoc(1, 'nwrg', GetOwningPlayer(GetTriggerUnit()), Zj(GetUnitLoc(GetTriggerUnit()) , GetRandomReal(50., 500.) , GetRandomReal(0, 360)), GetRandomReal(0, 360))
		call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(200., 500.), 9999999.)
		set udg_integer117=GetRandomInt(200, 500)
		call SetUnitScalePercent(bj_lastCreatedUnit, I2R(udg_integer117), I2R(udg_integer117), I2R(udg_integer117))
		call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(100., 200.), 9999999.)
		set udg_integer116=udg_integer116 + 1
	endloop
	set udg_integer116=1
	loop
		exitwhen udg_integer116 > 72
		call CreateNUnitsAtLoc(1, 'nggr', GetOwningPlayer(GetTriggerUnit()), Zj(GetUnitLoc(GetTriggerUnit()) , 600. , ( I2R(udg_integer116) * 5. )), bj_UNIT_FACING)
		call CreateDestructableLoc('YTpb', GetUnitLoc(bj_lastCreatedUnit), bj_UNIT_FACING, 1, 0)
		set udg_units27[udg_integer116]=bj_lastCreatedUnit
		set udg_integer116=udg_integer116 + 1
	endloop
	call StartTimerBJ(udg_timer126, true, .05)
endfunction

