        call CreateNUnitsAtLoc(1, 'e04R', GetOwningPlayer(udg_PejantUnit), GetUnitLoc(udg_PejantUnit), GetRandomDirectionDeg())
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
