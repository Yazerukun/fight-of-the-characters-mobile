        call UnitAddItemByIdSwapped('I05J', GetLastCreatedUnit())
        call UnitUseItemTarget(GetLastCreatedUnit(), GetItemOfTypeFromUnitBJ(GetLastCreatedUnit(), 'I05J'), udg_MadaraE2)
        call RemoveLocation(udg_MadaraEL2)
        call TriggerSleepAction(1.50)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call vibration(ConvertedPlayer(GetForLoopIndexA()) , 4.00 , 0.50)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call DestroyEffectBJ(udg_MadaraEE)
        set udg_MadaraEL2=GetUnitLoc(udg_MadaraE2)
        call UnitDamageTargetBJ(udg_MadaraE1, udg_MadaraE2, ( 1000.00 * I2R(GetUnitAbilityLevelSwapped('A0QN', udg_MadaraE1)) ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
        if ( Trig_MadaraE_Func006Func014C() ) then
            set bj_wantDestroyGroup=true
            call ForGroupBJ(GetUnitsInRangeOfLocMatching(400.00, udg_MadaraEL2, Condition(function Trig_MadaraE_Func006Func014Func002001003)), function Trig_MadaraE_Func006Func014Func002A)
        else
            set bj_wantDestroyGroup=true
            call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_MadaraEL2, Condition(function Trig_MadaraE_Func006Func014Func004001003)), function Trig_MadaraE_Func006Func014Func004A)
        endif
        call CreateNUnitsAtLoc(1, 'e041', GetOwningPlayer(udg_MadaraE1), udg_MadaraEL2, bj_UNIT_FACING)
        call CreateNUnitsAtLoc(1, 'e03F', GetOwningPlayer(udg_MadaraE1), udg_MadaraEL2, bj_UNIT_FACING)
        call RemoveLocation(udg_MadaraEL2)
        call EnableTrigger(GetTriggeringTrigger())
    else
        call EnableTrigger(GetTriggeringTrigger())
    endif
endfunction

