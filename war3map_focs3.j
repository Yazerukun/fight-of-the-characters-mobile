    set gg_trg_lee=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_lee, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_lee, Condition(function Trig_lee_Conditions))
    call TriggerAddAction(gg_trg_lee, function Trig_lee_Actions)
endfunction

//===========================================================================
// Trigger: lee2
//
// 모든 플레이어의 기본 멜리 게임 초기화
//===========================================================================
function Trig_lee2_Func001C takes nothing returns boolean
    if ( not ( udg_REEint < 18 ) ) then
        return false
    endif
    return true
endfunction

function Trig_lee2_Actions takes nothing returns nothing
    if ( Trig_lee2_Func001C() ) then
        set udg_REEint=( udg_REEint + 1 )
        call SetUnitFlyHeightBJ(udg_REEta, GetRandomReal(200.00, 400.00), 0.00)
        call SetUnitFlyHeightBJ(udg_REEca, GetUnitFlyHeight(udg_REEta), 0.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h00X', GetOwningPlayer(udg_REEca), GetUnitLoc(udg_REEta), GetUnitLoc(udg_REEta))
        call UnitApplyTimedLife(GetLastCreatedUnit(), 'Boar', 1)
        call SetUnitFlyHeightBJ(GetLastCreatedUnit(), GetUnitFlyHeight(udg_REEta), 0.00)
        call SetUnitPositionLoc(udg_REEta, PolarProjectionBJ(udg_REElo, 300.00, GetRandomDirectionDeg()))
        call SetUnitPositionLocFacingLocBJ(udg_REEca, PolarProjectionBJ(GetUnitLoc(udg_REEta), 100.00, GetUnitFacing(udg_REEta)), GetUnitLoc(udg_REEta))
        call SetUnitAnimation(udg_REEca, "attack")
        call SetUnitTimeScalePercent(udg_REEca, 500.00)
        call SetUnitAnimation(udg_REEta, "death")
        call StartTimerBJ(udg_Aaa[12], false, 0.10)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call SetUnitFlyHeightBJ(udg_REEta, 200.00, 0.00)
        call SetUnitFlyHeightBJ(udg_REEca, GetUnitFlyHeight(udg_REEta), 0.00)
        call CreateNUnitsAtLocFacingLocBJ(1, 'h00X', GetOwningPlayer(udg_REEca), GetUnitLoc(udg_REEta), GetUnitLoc(udg_REEta))
        call UnitApplyTimedLife(GetLastCreatedUnit(), 'Boar', 1)
        call SetUnitFlyHeightBJ(GetLastCreatedUnit(), GetUnitFlyHeight(udg_REEta), 0.00)
        call SetUnitPositionLoc(udg_REEta, PolarProjectionBJ(udg_REElo, 300.00, GetRandomDirectionDeg()))
        call SetUnitPositionLocFacingLocBJ(udg_REEca, PolarProjectionBJ(GetUnitLoc(udg_REEta), 100.00, GetUnitFacing(udg_REEta)), GetUnitLoc(udg_REEta))
        call SetUnitAnimation(udg_REEca, "attack")
        call SetUnitAnimation(udg_REEta, "death")
        call TriggerExecute(gg_trg_lee3)
        call SetUnitPositionLocFacingLocBJ(udg_REEca, PolarProjectionBJ(GetUnitLoc(udg_REEta), 100.00, GetUnitFacing(udg_REEta)), GetUnitLoc(udg_REEta))
        call DestroyEffectBJ(udg_REEeff[1])
        call DestroyEffectBJ(udg_REEeff[2])
        call DestroyEffectBJ(udg_REEeff[3])
    endif
endfunction

