    set udg_JETpU2c=GetUnitLoc(udg_JETpU2)
    set udg_JETpR=AngleBetweenPoints(udg_JETpU1L, udg_JETpL)
    if ( Trig_Loopc2q_______u_Func003C() ) then
        call SetUnitPathing(udg_JETpU2, false)
        call SetUnitPositionLocFacingBJ(udg_JETpU2, PolarProjectionBJ(udg_JETpU2c, 20.00, udg_JETpR), udg_JETpR)
        call AddSpecialEffectLocBJ(udg_JETpU2c, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call StartTimerBJ(udg_Aaab[9], false, 0.01)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call IssueImmediateOrderBJ(udg_JETpU2, "stomp")
    endif
    call RemoveLocation(udg_JETpU2c)
endfunction

