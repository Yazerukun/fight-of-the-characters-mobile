    if ( not ( IsUnitIllusionBJ(GetAttacker()) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kisame_It_01_Actions takes nothing returns nothing
    if ( Trig_Kisame_It_01_Func001C() ) then
        if ( Trig_Kisame_It_01_Func001Func002C() ) then
            set udg_Kisame_Attack=GetAttacker()
            set udg_Kisame_Target=GetAttackedUnitBJ()
            set udg_Kisame_L=GetUnitLoc(udg_Kisame_Target)
            call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kisame_Attack), udg_Kisame_L, GetRandomDirectionDeg())
            call UnitApplyTimedLifeBJ(1.50, 'BHwe', GetLastCreatedUnit())
            call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl")
            call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
            call SetUnitLifeBJ(udg_Kisame_Attack, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Kisame_Attack) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Kisame_Attack) * 0.08 ) ))
            call RemoveLocation(udg_Kisame_L)
        else
        endif
    else
        if ( Trig_Kisame_It_01_Func001Func001C() ) then
            set udg_Kisame_Attack=GetAttacker()
            set udg_Kisame_Target=GetAttackedUnitBJ()
            set udg_Kisame_L=GetUnitLoc(udg_Kisame_Target)
            call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kisame_Attack), udg_Kisame_L, GetRandomDirectionDeg())
            call UnitApplyTimedLifeBJ(1.50, 'BHwe', GetLastCreatedUnit())
            call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl")
            call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
            call SetUnitLifeBJ(udg_Kisame_Attack, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Kisame_Attack) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Kisame_Attack) * 0.08 ) ))
            call RemoveLocation(udg_Kisame_L)
        else
        endif
    endif
endfunction

