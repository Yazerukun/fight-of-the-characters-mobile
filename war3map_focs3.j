        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(350.00, udg_BloodBunBu, Condition(function Trig_SerasRQskill________2______________u_Func002Func010001003)), function Trig_SerasRQskill________2______________u_Func002Func010A)
