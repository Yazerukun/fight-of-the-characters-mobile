        return false
    endif
    return true
endfunction

function Trig_baQ______________u_Func012001003 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n00P' )
endfunction

function Trig_baQ______________u_Func012Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(GetLastCreatedUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_baQ______________u_Func012A takes nothing returns nothing
    if ( Trig_baQ______________u_Func012Func001C() ) then
        call ShowUnitHide(GetEnumUnit())
        call KillUnit(GetEnumUnit())
    else
    endif
endfunction

function Trig_baQ______________u_Actions takes nothing returns nothing
    call ShowUnitShow(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))])
    call PauseUnitBJ(false, udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))])
    call SetUnitPositionLoc(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))], GetUnitLoc(GetDyingUnit()))
    call CreateNUnitsAtLoc(1, 'h00Y', GetOwningPlayer(GetDyingUnit()), GetUnitLoc(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveUnit(GetDyingUnit())
    call ClearSelectionForPlayer(ConvertedPlayer(GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))))
    call SelectUnitForPlayerSingle(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))], ConvertedPlayer(GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))))
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(250.00, GetUnitLoc(GetLastCreatedUnit()), Condition(function Trig_baQ______________u_Func012001003)), function Trig_baQ______________u_Func012A)
endfunction

