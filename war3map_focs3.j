//===========================================================================
function Trig_nosingle_Func002Func001C takes nothing returns boolean
    if ( not ( GetPlayerSlotState(ConvertedPlayer(GetForLoopIndexA())) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerName(ConvertedPlayer(GetForLoopIndexA())) != "컴퓨터" ) ) then
        return false
    endif
    return true
endfunction

function Trig_nosingle_Func003C takes nothing returns boolean
    if ( not ( udg_NoSingle == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_nosingle_Actions takes nothing returns nothing
    set udg_NoSingle=0
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_nosingle_Func002Func001C() ) then
            set udg_NoSingle=( udg_NoSingle + 1 )
        else
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    if ( Trig_nosingle_Func003C() ) then
        call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_11169")
        call DestroyTrigger(gg_trg_csitem1)
        call DestroyTrigger(gg_trg_csitem2)
        call DestroyTrigger(gg_trg_csitem3)
        call DestroyTrigger(gg_trg_csitem4)
    else
    endif
    call EnableTrigger(gg_trg_nosingle2)
endfunction

