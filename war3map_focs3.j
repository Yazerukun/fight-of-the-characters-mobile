// Trigger: ruleHidden
//
// 1번 예거 2번 아이젠
//===========================================================================
function Trig_ruleHidden_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0O9' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleHidden_Func005Func008Func001Func014C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetTriggerUnit()), Player(10)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleHidden_Func005Func008Func001C takes nothing returns boolean
    if ( not ( udg_HiddenChar[2] == false ) ) then
        return false
    endif
    if ( not ( udg_Random_Hidden[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ruleHidden_Func005Func008Func010C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetTriggerUnit()), Player(10)) == true ) ) then
        return false
    endif
    return true
endfunction

