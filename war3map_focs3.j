//***************************************************************************
//*
//*  Custom Script Code
//*
//***************************************************************************
function StartFunction takes nothing returns nothing
if ( udg_Hashtable == null ) then
set udg_Hashtable=InitHashtable()
endif
endfunction

function PlayerFog takes player p,integer style,real zstart,real zend,real density,real red,real green,real blue returns nothing
if ( GetLocalPlayer() == p ) then
call SetTerrainFogExBJ(style, zstart, zend, density, red, green, blue)
endif
endfunction

function PlayerWaterColor takes player p,real red,real green,real blue,real density returns nothing
if ( GetLocalPlayer() == p ) then
call SetWaterBaseColorBJ(red, green, blue, density)
endif
endfunction


function PlayerFogOff takes player p returns nothing
if ( GetLocalPlayer() == p ) then
call ResetTerrainFogBJ()
endif
endfunction

function FilterBasic takes player a,real b,string c,real d,real e,real f,real g,real h,real i,real j,real k returns nothing
if ( GetLocalPlayer() == a ) then
call CinematicFilterGenericBJ(b, BLEND_MODE_BLEND, c, d, e, f, g, h, i, j, k)
endif
endfunction 

function FilterFadeinOut1 takes nothing returns nothing
local timer t= GetExpiredTimer()
local player p= LoadPlayerHandle(udg_Hashtable, GetHandleId(t), StringHash("Player"))
local real time= LoadReal(udg_Hashtable, GetHandleId(t), StringHash("Time"))
local string String= LoadStr(udg_Hashtable, GetHandleId(t), StringHash("String"))
if ( GetLocalPlayer() == p ) then
call CinematicFilterGenericBJ(time, BLEND_MODE_BLEND, String, 100, 100, 100, 0, 100, 100, 100, 100)
endif
call FlushChildHashtable(udg_Hashtable, GetHandleId(t))
call DestroyTimer(t)
set t=null
set p=null
endfunction

function Playerinvisible takes player a,unit b,real c,real d,real e,real f returns nothing
if ( GetLocalPlayer() == a ) then
call SetUnitVertexColorBJ(b, c, d, e, f)
endif
endfunction

function FilterFadeinOut takes player a,real b,string c returns nothing
local timer t= CreateTimer()
call SavePlayerHandle(udg_Hashtable, GetHandleId(t), StringHash("Player"), a)
call SaveReal(udg_Hashtable, GetHandleId(t), StringHash("Time"), b / 2)
call SaveStr(udg_Hashtable, GetHandleId(t), StringHash("String"), c)
if ( GetLocalPlayer() == a ) then
call CinematicFilterGenericBJ(b / 2, BLEND_MODE_BLEND, c, 100, 100, 100, 100, 100, 100, 100, 0)
endif
call TimerStart(t, b / 2, false, function FilterFadeinOut1)
set t=null
endfunction 

function CauseDamage takes nothing returns nothing
call UnitDamageTarget(LoadUnitHandle(udg_Hashtable, StringHash("GiveDamageUnit"), 0), GetEnumUnit(), LoadReal(udg_Hashtable, StringHash("GiveDamageUnit"), 1), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
endfunction

function discrimination takes nothing returns boolean
return ( IsUnitAliveBJ(GetFilterUnit()) == true and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(LoadUnitHandle(udg_Hashtable, StringHash("GiveDamageUnit"), 0))) == true and IsUnitInRangeLoc(GetFilterUnit(), LoadLocationHandle(udg_Hashtable, StringHash("GiveDamageUnit"), 2), LoadReal(udg_Hashtable, StringHash("GiveDamageUnit"), 3)) == true )
endfunction

function GroupimpactDamage takes unit a,real e,real b,real c,real d returns nothing
local group DamageGroup
local location Point= Location(c, d)
call SaveUnitHandle(udg_Hashtable, StringHash("GiveDamageUnit"), 0, a)
call SaveReal(udg_Hashtable, StringHash("GiveDamageUnit"), 1, e)
call SaveLocationHandle(udg_Hashtable, StringHash("GiveDamageUnit"), 2, Point)
call SaveReal(udg_Hashtable, StringHash("GiveDamageUnit"), 3, b)
set DamageGroup=GetUnitsInRangeOfLocMatching(b, Point, Condition(function discrimination))
call ForGroup(DamageGroup, function CauseDamage)
call DestroyGroup(DamageGroup)
call RemoveLocation(LoadLocationHandle(udg_Hashtable, StringHash("GiveDamageUnit"), 2))
call RemoveLocation(Point)
call FlushChildHashtable(udg_Hashtable, StringHash("GiveDamageUnit"))
set Point=null
set DamageGroup=null
endfunction


