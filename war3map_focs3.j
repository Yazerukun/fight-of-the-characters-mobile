    if ( not ( GetUnitAbilityLevelSwapped('A0MZ', GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_sair_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_SaiR1)
    set udg_SaiR=GetSpellTargetLoc()
    set udg_SaiR2=GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc(1, 'e08D', GetOwningPlayer(GetTriggerUnit()), udg_SaiR2, AngleBetweenPoints(udg_SaiR2, udg_SaiR))
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "clusterrockets", udg_SaiR)
    set udg_SaiR3[1]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'e08D', GetOwningPlayer(GetTriggerUnit()), udg_SaiR2, AngleBetweenPoints(udg_SaiR2, udg_SaiR))
    call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100, 100, 100, 100.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "clusterrockets", udg_SaiR)
    set udg_SaiR3[2]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'e08D', GetOwningPlayer(GetTriggerUnit()), udg_SaiR2, AngleBetweenPoints(udg_SaiR2, udg_SaiR))
    call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100, 100, 100, 100.00)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "clusterrockets", udg_SaiR)
    set udg_SaiR3[3]=GetLastCreatedUnit()
    call SetUnitFlyHeightBJ(udg_SaiR3[1], 0.00, 0.00)
    call SetUnitFlyHeightBJ(udg_SaiR3[2], 0.00, 0.00)
    call SetUnitFlyHeightBJ(udg_SaiR3[3], 0.00, 0.00)
    if ( Trig_sair_Func018C() ) then
        call CreateNUnitsAtLoc(1, 'e08A', GetOwningPlayer(GetTriggerUnit()), udg_SaiR, AngleBetweenPoints(udg_SaiR2, udg_SaiR))
        call SetUnitTimeScalePercent(GetLastCreatedUnit(), 50.00)
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
    else
        if ( Trig_sair_Func018Func001C() ) then
            call CreateNUnitsAtLoc(1, 'e08A', GetOwningPlayer(GetTriggerUnit()), udg_SaiR, AngleBetweenPoints(udg_SaiR2, udg_SaiR))
            call SetUnitTimeScalePercent(GetLastCreatedUnit(), 50.00)
            call IncUnitAbilityLevelSwapped('A0N0', GetLastCreatedUnit())
            call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
        else
            if ( Trig_sair_Func018Func001Func001C() ) then
                call CreateNUnitsAtLoc(1, 'e08A', GetOwningPlayer(GetTriggerUnit()), udg_SaiR, AngleBetweenPoints(udg_SaiR2, udg_SaiR))
                call SetUnitTimeScalePercent(GetLastCreatedUnit(), 50.00)
                call IncUnitAbilityLevelSwapped('A0N0', GetLastCreatedUnit())
                call IncUnitAbilityLevelSwapped('A0N0', GetLastCreatedUnit())
                call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
            else
            endif
        endif
    endif
    call RemoveLocation(udg_SaiR)
    call RemoveLocation(udg_SaiR2)
endfunction

