    if ( not ( GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit())) != GetItemUserData(GetManipulatedItem()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_ItemOwnerSet_Func013C takes nothing returns boolean
    if ( not ( GetItemUserData(GetManipulatedItem()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ItemOwnerSet_Actions takes nothing returns nothing
    if ( Trig_ItemOwnerSet_Func013C() ) then
        call SetItemUserData(GetManipulatedItem(), GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit())))
    else
        if ( Trig_ItemOwnerSet_Func013Func001C() ) then
            call UnitRemoveItemSwapped(GetManipulatedItem(), GetTriggerUnit())
            call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()), 0, 0, "TRIGSTR_2012")
        else
        endif
    endif
endfunction

