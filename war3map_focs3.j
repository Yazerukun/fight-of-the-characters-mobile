    if ( not ( DistanceBetweenPoints(udg_aTosiroAu, udg_aTosiroBu) >= 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_yongsangaLoop_Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_aTosiroA, 'B018') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_yongsangaLoop_Actions takes nothing returns nothing
    set udg_aTosiroAu=GetUnitLoc(udg_aTosiroA)
    set udg_aTosiroBu=GetUnitLoc(udg_aTosiroB)
    if ( Trig_yongsangaLoop_Func003C() ) then
        if ( Trig_yongsangaLoop_Func003Func001C() ) then
            set udg_aTosiroC=AngleBetweenPoints(udg_aTosiroAu, udg_aTosiroBu)
            call SetUnitAnimationByIndex(udg_aTosiroA, 0)
            call SetUnitPositionLocFacingBJ(udg_aTosiroA, PolarProjectionBJ(udg_aTosiroAu, 20.00, udg_aTosiroC), udg_aTosiroC)
        else
            call DisableTrigger(GetTriggeringTrigger())
            call DisableTrigger(gg_trg_yongsangaLoop1)
            set udg_aTosiroTorF=false
            call SetUnitInvulnerable(udg_aTosiroA, false)
            call PauseUnitBJ(false, udg_aTosiroA)
            call CreateNUnitsAtLoc(1, 'e01U', GetOwningPlayer(udg_aTosiroA), udg_aTosiroAu, udg_aTosiroC)
            call CreateNUnitsAtLoc(1, 'e01V', GetOwningPlayer(udg_aTosiroA), udg_aTosiroAu, udg_aTosiroC)
            call CreateNUnitsAtLoc(1, 'e01W', GetOwningPlayer(udg_aTosiroA), udg_aTosiroAu, udg_aTosiroC)
            call CreateNUnitsAtLoc(1, 'e01X', GetOwningPlayer(udg_aTosiroA), udg_aTosiroAu, udg_aTosiroC)
            call CreateNUnitsAtLoc(1, 'e03C', GetOwningPlayer(udg_aTosiroA), udg_aTosiroAu, udg_aTosiroC)
            call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
            call SetUnitPathing(udg_aTosiroA, true)
            call AddSpecialEffectLocBJ(GetUnitLoc(udg_aTosiroA), "war3mapImported\\IceNova.mdx")
            if ( Trig_yongsangaLoop_Func003Func001Func016C() ) then
                set bj_wantDestroyGroup=true
                call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_aTosiroAu, Condition(function Trig_yongsangaLoop_Func003Func001Func016Func002001003)), function Trig_yongsangaLoop_Func003Func001Func016Func002A)
            else
            endif
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            set udg_aTosiroA=null
            set udg_aTosiroB=null
        endif
    else
    endif
    call RemoveLocation(udg_aTosiroAu)
    call RemoveLocation(udg_aTosiroBu)
    call StartTimerBJ(udg_Aaa[6], false, 0.02)
endfunction

