        return false
    endif
    return true
endfunction

function Trig_Manneo12_Actions takes nothing returns nothing
    if ( Trig_Manneo12_Func001C() ) then
        set udg_ManneoG=( udg_ManneoG + 1 )
        set udg_ManneoU2=OffsetLocation(udg_ManneoZ, GetRandomReal(- 225.00, 225.00), GetRandomReal(- 225.00, 225.00))
        call CreateNUnitsAtLoc(1, 'e0B4', GetOwningPlayer(udg_ManneoU), udg_ManneoU2, udg_ManneoS)
        call IssueImmediateOrderBJ(GetLastCreatedUnit(), "thunderclap")
        call RemoveLocation(udg_ManneoU2)
    else
        call DisableTrigger(GetTriggeringTrigger())
        set udg_ManneoU=null
        call RemoveLocation(udg_ManneoZ)
    endif
endfunction

