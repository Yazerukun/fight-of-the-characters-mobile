        return false
    endif
    return true
endfunction

function Trig_Enel_Actions takes nothing returns nothing
    set udg_EneluL=GetUnitLoc(udg_Enelu)
    call CreateNUnitsAtLoc(1, 'e011', GetOwningPlayer(udg_Enelu), udg_EneluL, bj_UNIT_FACING)
    set udg_Enelu2=GetLastCreatedUnit()
    if ( Trig_Enel_Func004C() ) then
        call IssueImmediateOrderBJ(udg_Enelu2, "stomp")
        call CreateNUnitsAtLoc(1, 'n02D', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
        call CreateNUnitsAtLoc(1, 'n02D', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
        call CreateNUnitsAtLoc(1, 'n02D', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
        call RemoveLocation(udg_EneluL)
    else
        if ( Trig_Enel_Func004Func001C() ) then
            call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
            call IssueImmediateOrderBJ(udg_Enelu2, "stomp")
            call CreateNUnitsAtLoc(1, 'n02D', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
            call CreateNUnitsAtLoc(1, 'n02D', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
            call CreateNUnitsAtLoc(1, 'n02D', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
            call RemoveLocation(udg_EneluL)
        else
            if ( Trig_Enel_Func004Func001Func001C() ) then
                call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                call IssueImmediateOrderBJ(udg_Enelu2, "stomp")
                call CreateNUnitsAtLoc(1, 'n02E', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                call CreateNUnitsAtLoc(1, 'n02E', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                call CreateNUnitsAtLoc(1, 'n02E', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                call RemoveLocation(udg_EneluL)
            else
                if ( Trig_Enel_Func004Func001Func001Func001C() ) then
                    call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                    call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                    call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                    call IssueImmediateOrderBJ(udg_Enelu2, "stomp")
                    call CreateNUnitsAtLoc(1, 'n02E', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                    call CreateNUnitsAtLoc(1, 'n02E', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                    call CreateNUnitsAtLoc(1, 'n02E', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                    call RemoveLocation(udg_EneluL)
                else
                    call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                    call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                    call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                    call IncUnitAbilityLevelSwapped('A0BS', udg_Enelu2)
                    call IssueImmediateOrderBJ(udg_Enelu2, "stomp")
                    call CreateNUnitsAtLoc(1, 'n02F', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                    call CreateNUnitsAtLoc(1, 'n02F', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                    call CreateNUnitsAtLoc(1, 'n02F', GetOwningPlayer(udg_Enelu), udg_EneluL, GetRandomReal(0, 359.99))
                    call RemoveLocation(udg_EneluL)
                endif
            endif
        endif
    endif
endfunction

