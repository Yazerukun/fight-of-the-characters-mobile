function Trig_chidori5_Actions takes nothing returns nothing
    if ( Trig_chidori5_Func001C() ) then
        if ( Trig_chidori5_Func001Func001C() ) then
            call SetUnitPathing(udg_AasaaUnit1, false)
            set udg_AasaaUnit3=AngleBetweenPoints(GetUnitLoc(udg_AasaaUnit1), GetUnitLoc(udg_AasaaUnit2))
            call SetUnitPositionLocFacingBJ(udg_AasaaUnit1, PolarProjectionBJ(GetUnitLoc(udg_AasaaUnit1), 30.00, udg_AasaaUnit3), udg_AasaaUnit3)
            call SetUnitAnimation(udg_AasaaUnit1, "Spell One")
        else
            call DisableTrigger(gg_trg_chidori5)
            call DisableTrigger(gg_trg_chidori6)
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=10
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call DestroyEffectBJ(udg_AasaaUnit5[GetForLoopIndexA()])
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
            call PauseUnitBJ(false, udg_AasaaUnit1)
            call SetUnitTimeScalePercent(udg_AasaaUnit1, 100)
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=8
