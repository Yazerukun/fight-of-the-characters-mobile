            call EnableTrigger(gg_trg_Rskillwoo4)
            call StartTimerBJ(udg_VerETimer2_2, false, 1.00)
        else
            if ( Trig_Rskillwoo2_Func003Func001Func001C() ) then
                call CreateNUnitsAtLoc(1, 'e01S', GetOwningPlayer(udg_Rskillwoo), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
                set udg_Rskillwoo2=GetLastCreatedUnit()
