    call RemoveLocation(udg_Bankai_2ul_cp2)
    set udg_Bankai_2u_cp2=GetTriggerUnit()
    set udg_Bankai_2ul_cp2=GetUnitLoc(GetTriggerUnit())
    call TriggerSleepAction(0.20)
    if ( Trig_DeiEDeadBug________2_______u_Func005C() ) then
        set udg_Bankai_2_cp2=true
        set udg_Bankai_2u_cp2=null
        call RemoveLocation(udg_Bankai_2ul_cp2)
    else
        set udg_Bankai_2_cp2=false
        call KillUnit(udg_Bankai_2u_cp2)
        call ReviveHeroLoc(udg_Bankai_2u_cp2, udg_Bankai_2ul_cp2, false)
        call SelectUnitForPlayerSingle(udg_Bankai_2u_cp2, GetOwningPlayer(udg_Bankai_2u_cp2))
        set udg_Bankai_2u_cp2=null
        call RemoveLocation(udg_Bankai_2ul_cp2)
