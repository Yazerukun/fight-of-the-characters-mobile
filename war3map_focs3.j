    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'n00J', GetOwningPlayer(udg_iceUnitC), udg_iceUnit2C, ( 30.00 * I2R(GetForLoopIndexA()) ))
        call SetUnitScalePercent(GetLastCreatedUnit(), ( 400.00 + ( I2R(GetForLoopIndexA()) * 50.00 ) ), ( 400.00 + ( I2R(GetForLoopIndexA()) * 50.00 ) ), ( 400.00 + ( I2R(GetForLoopIndexA()) * 50.00 ) ))
        call SetUnitAnimation(GetLastCreatedUnit(), "birth")
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call CreateNUnitsAtLoc(1, 'n00J', GetOwningPlayer(udg_iceUnitC), udg_iceUnit2C, GetRandomReal(0, 360.00))
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "thunderclap")
    call SetUnitAnimation(GetLastCreatedUnit(), "birth")
