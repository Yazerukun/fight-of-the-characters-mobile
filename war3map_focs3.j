    if ( ( GetUnitTypeId(GetDyingUnit()) == 'n010' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'n00Y' ) ) then
        return true
    endif
    return false
endfunction

