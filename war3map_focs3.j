    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call vibration(ConvertedPlayer(GetForLoopIndexA()) , 8.00 , 5.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call PlaySoundBJ(gg_snd_MadaraR)
    set udg_MadaraR[0]=GetTriggerUnit()
    set udg_MadaraRL[0]=GetSpellTargetLoc()
    set udg_MadaraRT=( GetUnitFacing(udg_MadaraR[0]) + 180.00 )
    if ( Trig_MadaraR_Func007C() ) then
        call CreateNUnitsAtLoc(1, 'e0AJ', GetOwningPlayer(udg_MadaraR[0]), udg_MadaraRL[0], udg_MadaraRT)
        set udg_MadaraR[6]=GetLastCreatedUnit()
