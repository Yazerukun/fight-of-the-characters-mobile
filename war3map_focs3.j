function Trig_gametimer_Actions takes nothing returns nothing
    set udg_GAMEREGEN=GetUnitLoc(gg_unit_n02N_0111)
    call StartTimerBJ(udg_gametimer, true, 0.33)
    call StartTimerBJ(udg_gametimer_c, true, 1.00)
    call CreateTimerDialogBJ(udg_gametimerChang, "TRIGSTR_404")
    set udg_gametimerChang2=GetLastCreatedTimerDialogBJ()
    call PauseTimerBJ(true, udg_gametimerChang)
    call TimerDialogDisplayForPlayerBJ(false, udg_gametimerChang2, Player(0))
    call TimerDialogDisplayForPlayerBJ(false, udg_gametimerChang2, Player(1))
    call TimerDialogDisplayForPlayerBJ(false, udg_gametimerChang2, Player(2))
    call TimerDialogDisplayForPlayerBJ(false, udg_gametimerChang2, Player(3))
    call TimerDialogDisplayForPlayerBJ(false, udg_gametimerChang2, Player(4))
    call TimerDialogDisplayForPlayerBJ(false, udg_gametimerChang2, Player(5))
    call TimerDialogDisplayForPlayerBJ(false, udg_gametimerChang2, Player(6))
    call TimerDialogDisplayForPlayerBJ(false, udg_gametimerChang2, Player(7))
endfunction

