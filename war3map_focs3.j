function Trig_Ao_2y_W_02_Func004Func006C takes nothing returns boolean
    if ( not ( udg_Ao_2y_I[2] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ao_2y_W_02_Func004Func007C takes nothing returns boolean
    if ( not ( udg_Ao_2y_I[2] == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ao_2y_W_02_Func004Func008Func001C takes nothing returns boolean
    if ( not ( udg_Ao_2y_I[1] == 0 ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_Ao_2y_L[3], udg_Ao_2y_L[4]) <= 60.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ao_2y_W_02_Func004Func008Func011C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(udg_Ao_2y_U, 'I06D') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ao_2y_W_02_Func004Func008Func013001003001 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) != true )
endfunction

function Trig_Ao_2y_W_02_Func004Func008Func013001003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Ao_2y_U)) == true )
endfunction

function Trig_Ao_2y_W_02_Func004Func008Func013001003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitDeadBJ(GetFilterUnit()) != true), (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Ao_2y_U)) == true)) // INLINED!!
endfunction

function Trig_Ao_2y_W_02_Func004Func008Func013A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Ao_2y_U, GetEnumUnit(), ( 100.00 * I2R(GetUnitAbilityLevelSwapped('A0UR', udg_Ao_2y_U)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_Ao_2y_W_02_Func004Func008C takes nothing returns boolean
    if ( not Trig_Ao_2y_W_02_Func004Func008Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Ao_2y_W_02_Func004C takes nothing returns boolean
    if ( not ( udg_Ao_2y_Real[0] >= 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ao_2y_W_02_Actions takes nothing returns nothing
    set udg_Ao_2y_Real[0]=( udg_Ao_2y_Real[0] + 0.02 )
    set udg_Ao_2y_I[2]=( udg_Ao_2y_I[2] + 1 )
    if ( Trig_Ao_2y_W_02_Func004C() ) then
        call RemoveLocation(udg_Ao_2y_L[2])
        call RemoveLocation(udg_Ao_2y_L[3])
    else
        set udg_Ao_2y_L[5]=GetUnitLoc(udg_Ao_2y_Dummy[0])
        set udg_Ao_2y_L[4]=PolarProjectionBJ(udg_Ao_2y_L[5], 28.00, AngleBetweenPoints(udg_Ao_2y_L[2], udg_Ao_2y_L[3]))
        call SetUnitPositionLoc(udg_Ao_2y_Dummy[0], udg_Ao_2y_L[4])
        if ( Trig_Ao_2y_W_02_Func004Func006C() ) then
            call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Ao_2y_U), udg_Ao_2y_L[4], GetRandomDirectionDeg())
            call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
            call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "az_firering1a.mdx")
            call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
        else
        endif
        if ( Trig_Ao_2y_W_02_Func004Func007C() ) then
            set udg_Ao_2y_I[2]=0
        else
        endif
        if ( Trig_Ao_2y_W_02_Func004Func008C() ) then
            call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Ao_2y_U), udg_Ao_2y_L[3], GetRandomDirectionDeg())
            call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
            call SetUnitScalePercent(GetLastCreatedUnit(), 160.00, 160.00, 160.00)
            call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Shard111.mdx")
            call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
            call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Ao_2y_U), udg_Ao_2y_L[3], GetRandomDirectionDeg())
            call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
            call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "war3mapImported\\IceNova.mdx")
            call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
            if ( Trig_Ao_2y_W_02_Func004Func008Func011C() ) then
                call UnitAddAbilityBJ('A0UZ', GetLastCreatedUnit())
                call SetUnitAbilityLevelSwapped('A0UC', GetLastCreatedUnit(), 2)
                call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
            else
            endif
            set bj_wantDestroyGroup=true
            call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_Ao_2y_L[3], Condition(function Trig_Ao_2y_W_02_Func004Func008Func013001003)), function Trig_Ao_2y_W_02_Func004Func008Func013A)
            set udg_Ao_2y_I[1]=1
        else
        endif
        call RemoveLocation(udg_Ao_2y_L[4])
        call RemoveLocation(udg_Ao_2y_L[5])
        call StartTimerBJ(udg_Ao_2y_Timer[1], false, 0.02)
    endif
endfunction

