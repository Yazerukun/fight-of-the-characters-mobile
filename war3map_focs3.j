    set gg_trg_rehit1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_rehit1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_rehit1, Condition(function Trig_rehit1_Conditions))
