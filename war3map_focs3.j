// Trigger: MJLuffyR
//===========================================================================
function Trig_MJLuffyR_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0SR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MJLuffyR_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_LuffyR)
    set udg_MJLuffyRu=GetTriggerUnit()
    set udg_MJLuffyRl=GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc(1, 'e05W', GetOwningPlayer(udg_MJLuffyRu), udg_MJLuffyRl, bj_UNIT_FACING)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'B025', 2)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "taunt")
    call CreateNUnitsAtLoc(1, 'e0BP', GetOwningPlayer(udg_MJLuffyRu), udg_MJLuffyRl, GetUnitFacing(udg_MJLuffyRu))
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "dreadlordinferno", udg_MJLuffyRl)
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 80.00)
    call ShowUnitHide(udg_MJLuffyRu)
    call TriggerSleepAction(0.10)
    call PauseUnitBJ(true, udg_MJLuffyRu)
    call TriggerSleepAction(0.90)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call vibration(ConvertedPlayer(GetForLoopIndexA()) , 12.00 , 0.80)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call CreateNUnitsAtLoc(1, 'e05Z', GetOwningPlayer(udg_MJLuffyRu), udg_MJLuffyRl, bj_UNIT_FACING)
    call SetUnitAnimation(GetLastCreatedUnit(), "birth")
    call CreateNUnitsAtLoc(1, 'e060', GetOwningPlayer(udg_MJLuffyRu), udg_MJLuffyRl, bj_UNIT_FACING)
    call SetUnitAnimation(GetLastCreatedUnit(), "birth")
    call CreateNUnitsAtLoc(1, 'e0BR', GetOwningPlayer(udg_MJLuffyRu), udg_MJLuffyRl, bj_UNIT_FACING)
    call SetUnitAnimation(GetLastCreatedUnit(), "birth")
    call TriggerSleepAction(0.50)
    call PauseUnitBJ(false, udg_MJLuffyRu)
    call SetUnitPositionLoc(udg_MJLuffyRu, udg_MJLuffyRl)
    call ShowUnitShow(udg_MJLuffyRu)
    call ClearSelectionForPlayer(GetOwningPlayer(udg_MJLuffyRu))
    call SelectUnitForPlayerSingle(udg_MJLuffyRu, GetOwningPlayer(udg_MJLuffyRu))
    call RemoveLocation(udg_MJLuffyRl)
endfunction

