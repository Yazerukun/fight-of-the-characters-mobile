        return false
    endif
    return true
endfunction

function Trig_chunneon14_Func003Func006A takes nothing returns nothing
    if ( Trig_chunneon14_Func003Func006Func001C() ) then
        call UnitDamageTargetBJ(udg_Chunneon0u, GetEnumUnit(), ( udg_Chunneon0uu * 4.50 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
        call UnitDamageTargetBJ(udg_Chunneon0u, GetEnumUnit(), ( udg_Chunneon0uu * 15.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
    else
        call UnitDamageTargetBJ(udg_Chunneon0u, GetEnumUnit(), ( udg_Chunneon0uu * 3.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
        call UnitDamageTargetBJ(udg_Chunneon0u, GetEnumUnit(), ( udg_Chunneon0uu * 15.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
    endif
endfunction

function Trig_chunneon14_Func003Func007A takes nothing returns nothing
    call GroupRemoveUnitSimple(GetEnumUnit(), udg_Chunneon6)
endfunction

function Trig_chunneon14_Func003C takes nothing returns boolean
    if ( not ( udg_Chunneon4 >= 75.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_chunneon14_Actions takes nothing returns nothing
    set udg_Chunneon5=( udg_Chunneon5 - 4.00 )
    set udg_Chunneon5copy=( udg_Chunneon5copy - 4.00 )
    if ( Trig_chunneon14_Func003C() ) then
        set udg_Chunneon5=( udg_Chunneon5 - 4.00 )
        set udg_Chunneon5copy=( udg_Chunneon5copy - 4.00 )
        set udg_Chunneon4=( udg_Chunneon4 - 4.00 )
        call SetUnitScalePercent(udg_Chunneon1, ( 0.00 + udg_Chunneon4 ), ( 0.00 + udg_Chunneon4 ), ( 0.00 + udg_Chunneon4 ))
    else
        call ForGroupBJ(udg_Chunneon6, function Trig_chunneon14_Func003Func001A)
        set udg_Chunneon1_c=GetUnitLoc(udg_Chunneon1)
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRangeOfLocAll(300.00, udg_Chunneon1_c), function Trig_chunneon14_Func003Func004A)
        call RemoveLocation(udg_Chunneon1_c)
        call ForGroupBJ(udg_Chunneon6, function Trig_chunneon14_Func003Func006A)
        call ForGroupBJ(udg_Chunneon6, function Trig_chunneon14_Func003Func007A)
        set udg_Chunneon1_c=GetUnitLoc(udg_Chunneon1)
        call CreateNUnitsAtLoc(1, 'e02K', GetOwningPlayer(udg_Chunneon1), udg_Chunneon1_c, 270.00)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call CreateNUnitsAtLocFacingLocBJ(1, 'e02J', GetOwningPlayer(udg_Chunneon1), PolarProjectionBJ(udg_Chunneon1_c, 150.00, ( 45.00 * I2R(GetForLoopIndexA()) )), udg_Chunneon1_c)
            call SetUnitPathing(GetLastCreatedUnit(), false)
            call SetUnitPositionLoc(GetLastCreatedUnit(), PolarProjectionBJ(udg_Chunneon1_c, 150.00, ( 45.00 * I2R(GetForLoopIndexA()) )))
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call RemoveLocation(udg_Chunneon1_c)
        call RemoveUnit(udg_Chunneon1)
        set udg_Chunneon1=null
        call DisableTrigger(gg_trg_chunneon14)
        call DisableTrigger(gg_trg_chunneon15)
        call GroupClear(udg_Chunneon6)
    endif
    call StartTimerBJ(udg_Aaa[28], false, 0.06)
endfunction

