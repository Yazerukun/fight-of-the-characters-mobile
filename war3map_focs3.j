//===========================================================================
// Trigger: Attack
//===========================================================================
function Trig_Attack_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEventDamageSource()) == 'H031' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEventDamageSource()) == 'H033' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Attack_Conditions takes nothing returns boolean
    if ( not Trig_Attack_Func001C() ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(FirstOfGroup(GetUnitsOfTypeIdAll('H031')))) == true ) ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetEventDamageSource()) != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B05Z') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Attack_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Hero=GetEventDamageSource()
    set udg_AttackTarget=GetTriggerUnit()
    set udg_Kaido_Real[0]=GetEventDamage()
    call ConditionalTriggerExecute(gg_trg_Damage)
endfunction

//===========================================================================
function InitTrig_Attack takes nothing returns nothing
    set gg_trg_Attack=CreateTrigger()
    call TriggerAddCondition(gg_trg_Attack, Condition(function Trig_Attack_Conditions))
    call TriggerAddAction(gg_trg_Attack, function Trig_Attack_Actions)
endfunction

//===========================================================================
// Trigger: Damage
//===========================================================================
function Trig_Damage_Func025Func002001003001 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) != true )
endfunction

function Trig_Damage_Func025Func002001003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Hero)) == true )
endfunction

function Trig_Damage_Func025Func002001003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitDeadBJ(GetFilterUnit()) != true), (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Hero)) == true)) // INLINED!!
endfunction

function Trig_Damage_Func025Func002A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Hero, GetEnumUnit(), ( ( udg_Kaido_Real[0] * 1.40 ) + ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_Kaido_U, true)) * 0.50 ) ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
endfunction

function Trig_Damage_Func025Func006001003001 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) != true )
endfunction

function Trig_Damage_Func025Func006001003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Hero)) == true )
endfunction

function Trig_Damage_Func025Func006001003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitDeadBJ(GetFilterUnit()) != true), (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Hero)) == true)) // INLINED!!
endfunction

function Trig_Damage_Func025Func006A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Hero, GetEnumUnit(), ( ( udg_Kaido_Real[0] * 0.70 ) + ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, udg_Kaido_U, true)) * 0.50 ) ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
endfunction

function Trig_Damage_Func025Func008Func001Func001Func002C takes nothing returns boolean
    if ( not ( GetHeroLevel(udg_Hero) >= 12 ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero) < 18 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Damage_Func025Func008Func001Func001C takes nothing returns boolean
    if ( not Trig_Damage_Func025Func008Func001Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Damage_Func025Func008Func001Func002C takes nothing returns boolean
    if ( not ( GetHeroLevel(udg_Hero) >= 6 ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(udg_Hero) < 12 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Damage_Func025Func008Func001C takes nothing returns boolean
    if ( not Trig_Damage_Func025Func008Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Damage_Func025Func008C takes nothing returns boolean
    if ( not ( GetHeroLevel(udg_Hero) < 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Damage_Func025C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_Hero) == 'H033' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Damage_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_Kaido_P)
    call UnitRemoveBuffBJ('B05Z', udg_AttackTarget)
    set udg_Location[0]=GetUnitLoc(udg_AttackTarget)
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Hero), udg_Location[0], GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "by_wood_thundergodwrath_1_1.mdx")
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    call SetUnitScalePercent(GetLastCreatedUnit(), 250.00, 250.00, 250.00)
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Hero), udg_Location[0], GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 20.00, 1000000000.00)
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "DingZhi_BY_Wood_Effect_KuoSanQiLiu.mdx")
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    call SetUnitScalePercent(GetLastCreatedUnit(), 100.00, 100.00, 100.00)
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Hero), udg_Location[0], GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Effect_Slam.mdx")
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    call SetUnitScalePercent(GetLastCreatedUnit(), 250.00, 250.00, 250.00)
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Hero), udg_Location[0], GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "misaka light a.mdx")
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    call SetUnitScalePercent(GetLastCreatedUnit(), 250.00, 250.00, 250.00)
    if ( Trig_Damage_Func025C() ) then
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_Location[0], Condition(function Trig_Damage_Func025Func002001003)), function Trig_Damage_Func025Func002A)
        call RemoveLocation(udg_Location[0])
        call StartTimerBJ(udg_Kaido_Timer[0], false, 4.00)
    else
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_Location[0], Condition(function Trig_Damage_Func025Func006001003)), function Trig_Damage_Func025Func006A)
        call RemoveLocation(udg_Location[0])
        if ( Trig_Damage_Func025Func008C() ) then
            call StartTimerBJ(udg_Kaido_Timer[0], false, 13.00)
        else
            if ( Trig_Damage_Func025Func008Func001C() ) then
                call StartTimerBJ(udg_Kaido_Timer[0], false, 10.00)
            else
                if ( Trig_Damage_Func025Func008Func001Func001C() ) then
                    call StartTimerBJ(udg_Kaido_Timer[0], false, 7.00)
                else
                    call StartTimerBJ(udg_Kaido_Timer[0], false, 4.00)
                endif
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Damage takes nothing returns nothing
    set gg_trg_Damage=CreateTrigger()
    call TriggerAddAction(gg_trg_Damage, function Trig_Damage_Actions)
endfunction

