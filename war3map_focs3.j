								call DestroyTrigger(udg_trigger07)
								call MultiboardSetItemValueBJ(bj_lastCreatedMultiboard, 1, 11, ( "|c00FFFFFF" + ( "목표킬수: ∞" ) ))
							endif
						endif
					endif
				endif
			endif
		endif
	endif
	if ( (udg_integer118 == 0) ) then // INLINED!!
		call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS, 5., ( "|cffffcc00목표킬수가|r '" + ( "∞' |cffffcc00으로 선택되었습니다.|r" ) ))
