    endif
    return true
endfunction

function Trig_ColdA_End_______u_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'e09S', GetOwningPlayer(udg_ColdU2c), udg_ColdLCc, 0.00)
    call CreateNUnitsAtLoc(1, 'e073', GetOwningPlayer(udg_ColdU2c), udg_ColdLCc, 0.00)
    call CreateNUnitsAtLoc(1, 'e09Q', GetOwningPlayer(udg_ColdU2c), udg_ColdLCc, 0.00)
    call CreateNUnitsAtLoc(1, 'e09R', GetOwningPlayer(udg_ColdU2c), udg_ColdLCc, 0.00)
    if ( Trig_ColdA_End_______u_Func005C() ) then
        call IssueImmediateOrderBJ(udg_ColdUc, "stomp")
    else
        if ( Trig_ColdA_End_______u_Func005Func001C() ) then
            call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
            call IssueImmediateOrderBJ(udg_ColdUc, "stomp")
        else
            if ( Trig_ColdA_End_______u_Func005Func001Func002C() ) then
                call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                call IssueImmediateOrderBJ(udg_ColdUc, "stomp")
            else
                if ( Trig_ColdA_End_______u_Func005Func001Func002Func004C() ) then
                    call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                    call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                    call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                    call IssueImmediateOrderBJ(udg_ColdUc, "stomp")
                else
                    call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                    call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                    call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                    call IncUnitAbilityLevelSwapped('A0Q5', udg_ColdUc)
                    call IssueImmediateOrderBJ(udg_ColdUc, "stomp")
                endif
            endif
        endif
    endif
    set udg_ColdU2c=null
    set udg_ColdUc=null
    call RemoveLocation(udg_ColdLCc)
endfunction

