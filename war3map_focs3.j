        return false
    endif
    return true
endfunction

function Trig_Kaido_R_02_Func002Func016A takes nothing returns nothing
    call GroupAddUnitSimple(GetEnumUnit(), udg_Kaido_G[1])
    if ( Trig_Kaido_R_02_Func002Func016Func002C() ) then
        call UnitDamageTargetBJ(udg_Kaido_U, GetEnumUnit(), 3000.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
    else
        if ( Trig_Kaido_R_02_Func002Func016Func002Func001C() ) then
            call UnitDamageTargetBJ(udg_Kaido_U, GetEnumUnit(), 5000.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        else
            call UnitDamageTargetBJ(udg_Kaido_U, GetEnumUnit(), 6000.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
        endif
    endif
endfunction

function Trig_Kaido_R_02_Func002C takes nothing returns boolean
    if ( not ( udg_Kaido_I[1] == 18 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kaido_R_02_Actions takes nothing returns nothing
    set udg_Kaido_I[1]=( udg_Kaido_I[1] + 1 )
    if ( Trig_Kaido_R_02_Func002C() ) then
        call CameraClearNoiseForPlayer(GetOwningPlayer(udg_Kaido_U))
        call PauseTimerBJ(true, udg_Kaido_Timer[2])
        call GroupClear(udg_Kaido_G[1])
        call RemoveLocation(udg_Kaido_L[4])
        call RemoveLocation(udg_Kaido_L[5])
        call RemoveLocation(udg_Kaido_L[9])
    else
        set udg_Kaido_Real[2]=GetRandomReal(150.00, 300.00)
        set udg_Kaido_L[6]=PolarProjectionBJ(udg_Kaido_L[4], ( 100.00 * I2R(udg_Kaido_I[1]) ), AngleBetweenPoints(udg_Kaido_L[4], udg_Kaido_L[5]))
        set udg_Kaido_L[7]=PolarProjectionBJ(udg_Kaido_L[6], 300.00, ( AngleBetweenPoints(udg_Kaido_L[4], udg_Kaido_L[5]) - 90.00 ))
        set udg_Kaido_L[8]=PolarProjectionBJ(udg_Kaido_L[6], 300.00, ( AngleBetweenPoints(udg_Kaido_L[4], udg_Kaido_L[5]) - 270.00 ))
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[7], ( AngleBetweenPoints(udg_Kaido_L[4], udg_Kaido_L[5]) - 270.00 ))
        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Effect BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_1_1.mdx")
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
        call SetUnitScalePercent(GetLastCreatedUnit(), udg_Kaido_Real[2], udg_Kaido_Real[2], udg_Kaido_Real[2])
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Kaido_U), udg_Kaido_L[8], ( AngleBetweenPoints(udg_Kaido_L[4], udg_Kaido_L[5]) - 90.00 ))
        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Effect BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_1_1.mdx")
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
        call SetUnitScalePercent(GetLastCreatedUnit(), udg_Kaido_Real[2], udg_Kaido_Real[2], udg_Kaido_Real[2])
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(400.00, udg_Kaido_L[6], Condition(function Trig_Kaido_R_02_Func002Func016001003)), function Trig_Kaido_R_02_Func002Func016A)
        call RemoveLocation(udg_Kaido_L[6])
        call RemoveLocation(udg_Kaido_L[7])
    endif
endfunction

