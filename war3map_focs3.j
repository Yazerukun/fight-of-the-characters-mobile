endfunction

function Trig_yongsangaLoop_Func003Func001Func016Func002A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_aTosiroA, GetEnumUnit(), ( 0.70 * I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_aTosiroA, true)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_yongsangaLoop_Func003Func001Func016C takes nothing returns boolean
