// Trigger: hinataR1
//===========================================================================
function Trig_hinataR1_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0R4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_hinataR1_Func039Func001C takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetEnumUnit()), GetOwningPlayer(udg_NarutoC_cp)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_hinataR1_Func039A takes nothing returns nothing
    if ( Trig_hinataR1_Func039Func001C() ) then
        call UnitDamageTargetBJ(udg_NarutoC_cp, GetEnumUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_NarutoC_cp, true)) / 2.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
    else
    endif
endfunction

function Trig_hinataR1_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_NarutoC_cp=GetTriggerUnit()
    set udg_NarutoC2_cp=GetUnitLoc(udg_NarutoC_cp)
    set udg_NarutoLcation_cp=GetSpellTargetLoc()
    set udg_NarutoAngle2_cp=AngleBetweenPoints(GetUnitLoc(udg_NarutoC_cp), udg_NarutoLcation_cp)
    set udg_NarutoReal_cp=750.00
    call SetUnitInvulnerable(udg_NarutoC_cp, true)
    call ShowUnitHide(udg_NarutoC_cp)
    call PlaySoundBJ(gg_snd_HinataR)
    call CreateNUnitsAtLoc(1, 'e0AR', GetOwningPlayer(udg_NarutoC_cp), PolarProjectionBJ(udg_NarutoC2_cp, - 75.00, udg_NarutoAngle2_cp), udg_NarutoAngle2_cp)
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 30.00)
    call SetUnitAnimation(GetLastCreatedUnit(), "Spell")
    call CreateNUnitsAtLoc(1, 'e0AQ', GetOwningPlayer(udg_NarutoC_cp), PolarProjectionBJ(udg_NarutoC2_cp, 0.00, udg_NarutoAngle2_cp), udg_NarutoAngle2_cp)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "clusterrockets", udg_NarutoLcation_cp)
    call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100, 100, 100, 100.00)
    call CreateNUnitsAtLoc(1, 'e0AQ', GetOwningPlayer(udg_NarutoC_cp), PolarProjectionBJ(udg_NarutoC2_cp, 0.00, udg_NarutoAngle2_cp), udg_NarutoAngle2_cp)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "clusterrockets", udg_NarutoLcation_cp)
    call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100, 100, 100, 100.00)
    call CreateNUnitsAtLoc(1, 'e0AQ', GetOwningPlayer(udg_NarutoC_cp), PolarProjectionBJ(udg_NarutoC2_cp, 0.00, udg_NarutoAngle2_cp), udg_NarutoAngle2_cp)
    call IssuePointOrderLocBJ(GetLastCreatedUnit(), "clusterrockets", udg_NarutoLcation_cp)
    call SetUnitVertexColorBJ(GetLastCreatedUnit(), 100, 100, 100, 100.00)
    call CreateNUnitsAtLoc(1, 'e0AS', GetOwningPlayer(udg_NarutoC_cp), PolarProjectionBJ(udg_NarutoC2_cp, 0.00, udg_NarutoAngle2_cp), udg_NarutoAngle2_cp)
    call SetUnitAnimation(GetLastCreatedUnit(), "Attack")
    call CreateNUnitsAtLoc(1, 'e0AO', GetOwningPlayer(udg_NarutoC_cp), PolarProjectionBJ(udg_NarutoC2_cp, - 375.00, udg_NarutoAngle2_cp), udg_NarutoAngle2_cp)
    call SetUnitTimeScalePercent(GetLastCreatedUnit(), 50.00)
    call SetUnitAnimation(GetLastCreatedUnit(), "Spell")
    call CreateNUnitsAtLoc(1, 'e0AN', GetOwningPlayer(udg_NarutoC_cp), udg_NarutoC2_cp, udg_NarutoAngle2_cp)
    set udg_NarutoCc_cp=GetLastCreatedUnit()
    call TriggerSleepAction(1.35)
    call PlaySoundBJ(gg_snd_NarutoT)
    call KnockBack(udg_NarutoCc_cp , udg_NarutoLcation_cp , 0.15 , 0.02)
    call TriggerSleepAction(0.10)
    call RemoveUnit(udg_NarutoCc_cp)
    call ShowUnitShow(udg_NarutoC_cp)
    call SetUnitInvulnerable(udg_NarutoC_cp, false)
    call SetUnitPositionLocFacingBJ(udg_NarutoC_cp, udg_NarutoC2_cp, udg_NarutoAngle2_cp)
    call SelectUnitForPlayerSingle(udg_NarutoC_cp, GetOwningPlayer(udg_NarutoC_cp))
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocAll(350.00, udg_NarutoLcation_cp), function Trig_hinataR1_Func039A)
    call CreateNUnitsAtLoc(1, 'e07A', GetOwningPlayer(udg_NarutoC_cp), udg_NarutoLcation_cp, bj_UNIT_FACING)
    call CreateNUnitsAtLoc(1, 'e0AP', GetOwningPlayer(udg_NarutoC_cp), udg_NarutoLcation_cp, bj_UNIT_FACING)
    call SetUnitAnimation(GetLastCreatedUnit(), "birth")
    set udg_NarutoC_cp=null
    call RemoveLocation(udg_NarutoLcation_cp)
    call RemoveLocation(udg_NarutoC2_cp)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call vibration(ConvertedPlayer(GetForLoopIndexA()) , 5.00 , 3.00)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call EnableTrigger(GetTriggeringTrigger())
endfunction

