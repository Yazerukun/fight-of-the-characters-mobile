//===========================================================================
// Trigger: Revive
//===========================================================================
function Trig_Revive_Func001Func012C takes nothing returns boolean
    if ( not ( udg_Acrevive2 == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Revive_Func001C takes nothing returns boolean
    if ( not ( udg_GameDuelOn == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Revive_Actions takes nothing returns nothing
    if ( Trig_Revive_Func001C() ) then
        call PauseTimerBJ(true, udg_Acrevive5)
        set udg_Acrevive4=( udg_Acrevive4 + 1 )
        set udg_Acrevive2=true
        set udg_ZoroV_5=GetUnitLoc(udg_Acrevive)
        call DisplayTextToPlayer(GetOwningPlayer(udg_Acrevive), 0, 0, ( "|c00ff0000즉시 부활하려면 '부활'스킬을 사용하십시오.(자동 부활시간 4초)" ))
        call CreateNUnitsAtLoc(1, 'n01V', GetOwningPlayer(udg_Acrevive), udg_ZoroV_5, 192.50)
        set udg_Acrevive3=GetLastCreatedUnit()
        call UnitAddAbilityBJ('A0KE', udg_Acrevive3)
        call SelectUnitForPlayerSingle(udg_Acrevive3, GetOwningPlayer(udg_Acrevive))
        call TriggerSleepAction(3.90)
        if ( Trig_Revive_Func001Func012C() ) then
            set udg_Acrevive2=false
            call ExplodeUnitBJ(udg_Acrevive3)
            call RemoveUnit(udg_Acrevive3)
            set udg_integer39=( udg_integer39 - 1 )
            call DisplayTextToPlayer(GetOwningPlayer(udg_Acrevive), 0, 0, ( "|c00ff0000남은 생명: " + I2S(udg_integer39) ))
            call AddSpecialEffectLocBJ(udg_ZoroV_5, "Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl")
            call ReviveHeroLoc(udg_Acrevive, udg_ZoroV_5, false)
            call SelectUnitForPlayerSingle(udg_Acrevive, GetOwningPlayer(udg_Acrevive))
            call SetUnitInvulnerable(udg_Acrevive, true)
            call TriggerSleepAction(1.00)
            call SetUnitInvulnerable(udg_Acrevive, false)
            call RemoveLocation(udg_ZoroV_5)
            call StartTimerBJ(udg_Acrevive5, false, 0.75)
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Revive takes nothing returns nothing
    set gg_trg_Revive=CreateTrigger()
    call TriggerAddAction(gg_trg_Revive, function Trig_Revive_Actions)
endfunction

