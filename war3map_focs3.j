//===========================================================================
function Trig_OnePM_MOVE_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O011' ) ) then
        return false
    endif
    if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return false
    endif
    return true
endfunction

function Trig_OnePM_MOVE_Actions takes nothing returns nothing
    call RemoveLocation(udg_OnePunManEL)
    call RemoveLocation(udg_OnePunManELChar)
    set udg_OnePunManE=GetOrderedUnit()
    set udg_OnePunManEL=GetOrderPointLoc()
    set udg_OnePunManELChar=GetUnitLoc(udg_OnePunManE)
    set udg_OnePunManAngle=AngleBetweenPoints(udg_OnePunManEL, udg_OnePunManELChar)
    call SetUnitPathing(udg_OnePunManE, false)
    call EnableTrigger(gg_trg_OnePM_LOOP)
    call StartTimerBJ(udg_OnePunManTimer, false, 0.01)
    call EnableTrigger(gg_trg_OnePM_LOOP2)
    call StartTimerBJ(udg_OnePunManTimer2, false, 0.01)
endfunction

