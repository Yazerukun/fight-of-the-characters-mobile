    call TriggerRegisterAnyUnitEventBJ(gg_trg_Sassuke_It_01, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Sassuke_It_01, Condition(function Trig_Sassuke_It_01_Conditions))
