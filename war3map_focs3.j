//===========================================================================
// Trigger: color1
//===========================================================================
function Trig_color1_Func005C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A04Y' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A04G' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A01Z' ) ) then
        return true
    endif
    return false
endfunction

function Trig_color1_Conditions takes nothing returns boolean
    if ( not Trig_color1_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_color1_Func002Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellAbilityUnit()) == 'H01P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_color1_Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04Y' ) ) then
        return false
    endif
    return true
endfunction

function Trig_color1_Func003Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellAbilityUnit()) == 'H01G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_color1_Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A04G' ) ) then
        return false
    endif
    return true
endfunction

function Trig_color1_Func004Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellAbilityUnit()) == 'O008' ) ) then
        return false
    endif
    return true
endfunction

function Trig_color1_Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A01Z' ) ) then
        return false
    endif
    return true
endfunction

function Trig_color1_Actions takes nothing returns nothing
    call TriggerSleepAction(0.10)
    if ( Trig_color1_Func002C() ) then
        if ( Trig_color1_Func002Func001C() ) then
            call SetUnitVertexColorBJ(GetSpellAbilityUnit(), 100, 50.00, 50.00, 0)
        else
            call SetUnitVertexColorBJ(GetSpellAbilityUnit(), 100, 100, 100, 0)
        endif
    else
    endif
    if ( Trig_color1_Func003C() ) then
        if ( Trig_color1_Func003Func001C() ) then
            call SetUnitVertexColorBJ(GetSpellAbilityUnit(), 100, 50.00, 50.00, 0)
        else
            call SetUnitVertexColorBJ(GetSpellAbilityUnit(), 100, 100, 100, 0)
        endif
    else
    endif
    if ( Trig_color1_Func004C() ) then
        if ( Trig_color1_Func004Func001C() ) then
            call SetUnitVertexColorBJ(GetSpellAbilityUnit(), 40.00, 40.00, 40.00, 0)
        else
            call SetUnitVertexColorBJ(GetSpellAbilityUnit(), 100, 100, 100, 0)
        endif
    else
    endif
endfunction

