    if ( not ( GetSpellAbilityId() == 'A0UW' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ao_2y_V_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_Ao_2y_V)
    set udg_Ao_2y_U=GetTriggerUnit()
    set udg_Ao_2y_L[13]=GetSpellTargetLoc()
    call SetUnitX(udg_Ao_2y_U, GetLocationX(udg_Ao_2y_L[13]))
    call SetUnitY(udg_Ao_2y_U, GetLocationY(udg_Ao_2y_L[13]))
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Ao_2y_U), udg_Ao_2y_L[13], GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "az_firering1a.mdx")
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    call SetUnitScalePercent(GetLastCreatedUnit(), 200.00, 200.00, 200.00)
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Ao_2y_U), udg_Ao_2y_L[13], GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "war3mapImported\\IceNova.mdx")
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    call SetUnitScalePercent(GetLastCreatedUnit(), 200.00, 200.00, 200.00)
    call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Ao_2y_U), udg_Ao_2y_L[13], GetRandomDirectionDeg())
    call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
    call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "war3mapImported\\ES69.mdx")
    call SetUnitAnimationByIndex(GetLastCreatedUnit(), 90)
    call SetUnitScalePercent(GetLastCreatedUnit(), 150.00, 150.00, 150.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'h032', GetOwningPlayer(udg_Ao_2y_U), udg_Ao_2y_L[13], ( 90.00 * I2R(GetForLoopIndexA()) ))
        call UnitApplyTimedLifeBJ(1.00, 'BHwe', GetLastCreatedUnit())
        call AddSpecialEffectTargetUnitBJ("origin", GetLastCreatedUnit(), "Shard111.mdx")
        call SetUnitScalePercent(GetLastCreatedUnit(), 150.00, 150.00, 150.00)
        call SetUnitAnimationByIndex(GetLastCreatedUnit(), 1)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveLocation(udg_Ao_2y_L[13])
endfunction

