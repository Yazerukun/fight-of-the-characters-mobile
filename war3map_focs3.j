//===========================================================================
// Trigger: Loopc2 복사 복사
//===========================================================================
function Trig_Loopc2______________u_Func002C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_VeQskillu1c, udg_VeQskill2u1) >= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Loopc2______________u_Actions takes nothing returns nothing
    set udg_VeQskillu1c=GetUnitLoc(udg_VeQskillu1)
    if ( Trig_Loopc2______________u_Func002C() ) then
        call SetUnitPathing(udg_VeQskillu1, false)
        call AddSpecialEffectLocBJ(udg_VeQskillu1c, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call SetUnitPositionLocFacingBJ(udg_VeQskillu1, PolarProjectionBJ(udg_VeQskillu1c, 40.00, ( udg_Angle7 + 180.00 )), ( udg_Angle7 + 180.00 ))
    else
        call DisableTrigger(GetTriggeringTrigger())
        call CreateNUnitsAtLoc(1, 'e051', GetOwningPlayer(udg_VeQskillu1), udg_VeQskill2u1, bj_UNIT_FACING)
        call SetUnitVertexColorBJ(udg_VeQskillu1, 100, 100, 100, 100.00)
        call IssuePointOrderLocBJ(udg_VeQskillu1, "dreadlordinferno", udg_VeQskill2u1)
        call PlaySoundBJ(gg_snd_UlquiRF)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call CameraSetEQNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()), 6.00)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call TriggerSleepAction(2)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=8
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call CameraClearNoiseForPlayer(ConvertedPlayer(GetForLoopIndexA()))
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call RemoveUnit(udg_VeQskillu1)
        set udg_VeQskillu1=null
        call RemoveLocation(udg_VeQskill2u1)
    endif
    call RemoveLocation(udg_VeQskillu1c)
    call StartTimerBJ(udg_Aaa[35], false, 0.02)
endfunction

