    call AddSpecialEffectTargetUnitBJ("overhead", udg_WichiUnit[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], "Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
