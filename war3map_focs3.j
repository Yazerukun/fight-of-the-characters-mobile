    if ( not ( GetSpellAbilityId() == 'A0J4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_nidoru3_Actions takes nothing returns nothing
    call StopSoundBJ(gg_snd_zorov1, false)
endfunction

//===========================================================================
function InitTrig_nidoru3 takes nothing returns nothing
