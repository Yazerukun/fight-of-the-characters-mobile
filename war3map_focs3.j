    set gg_trg_MSDteachE3=CreateTrigger()
    call DisableTrigger(gg_trg_MSDteachE3)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_MSDteachE3, udg_MSDteachEt2)
    call TriggerAddAction(gg_trg_MSDteachE3, function Trig_MSDteachE3_Actions)
