function Trig_boowoo_______u_Conditions takes nothing returns boolean
    if ( not ( GetDyingUnit() == udg_boowooU ) ) then
        return false
    endif
    return true
endfunction

function Trig_boowoo_______u_Func003001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_boowoo_______u_Func003A takes nothing returns nothing
    set udg_KillName=GetEnumUnit()
endfunction

function Trig_boowoo_______u_Actions takes nothing returns nothing
    call DestroyTrigger(udg_trigger07)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsOfPlayerMatching(GetOwningPlayer(GetKillingUnitBJ()), Condition(function Trig_boowoo_______u_Func003001002)), function Trig_boowoo_______u_Func003A)
    call DestroyTrigger(gg_trg_gob2)
    call DisableTrigger(gg_trg_gob2)
    call TriggerSleepAction(7.00)
    call DisplayTextToForce(GetPlayersAll(), ( "|cFF404040게임의|r |c0000ff00MVP|r|cFF404040는!!|r |c0000ff00" + ( GetUnitName(udg_KillName) + ( "|r |cFF404040을(를) 조종하신!|r |c0000ff00" + ( GetPlayerName(GetOwningPlayer(udg_KillName)) + "|r |cFF404040입니다!!!|r" ) ) ) ))
    call TriggerSleepAction(7.00)
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_10218")
endfunction

