//===========================================================================
// Trigger: yunsungC 복사 3
//===========================================================================
function Trig_yunsungC________3_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0HX' ) ) then
        return false
    endif
    return true
endfunction

function Trig_yunsungC________3_Actions takes nothing returns nothing
    set udg_CannonIN=AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())
    set udg_AasasU4zz=0.00
    call EnableTrigger(gg_trg_sas3______________u)
    call CreateNUnitsAtLoc(1, 'e05B', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), udg_CannonIN)
    call CreateNUnitsAtLoc(1, 'e05A', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), udg_CannonIN)
    set udg_YunSungJinBig=GetLastCreatedUnit()
    call IssuePointOrderLocBJ(udg_YunSungJinBig, "breathoffire", PolarProjectionBJ(GetUnitLoc(udg_YunSungJinBig), 20.00, udg_CannonIN))
    call TriggerSleepAction(2.00)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerAbilityAvailableBJ(false, 'A0HX', ConvertedPlayer(GetForLoopIndexA()))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

