    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillDei, 'B01A') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillDei, 'BSTN') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillDei, 'BPSE') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'B02O') != true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_RSkillClare, 'Bmlt') != true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_RSkillDei2_c, udg_RSkillDei2) >= 20.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Loop_______u_Actions takes nothing returns nothing
    set udg_RSkillDei2_c=GetUnitLoc(udg_RSkillDei)
    if ( Trig_Loop_______u_Func002C() ) then
        call AddSpecialEffectLocBJ(udg_RSkillDei2_c, "Abilities\\Spells\\Orc\\Devour\\DevourEffectArt.mdl")
        call DestroyEffectBJ(GetLastCreatedEffectBJ())
        call SetUnitPositionLocFacingBJ(udg_RSkillDei, PolarProjectionBJ(udg_RSkillDei2_c, 22.50, ( udg_Angle3 + 180.00 )), ( udg_Angle3 + 180.00 ))
        call SetUnitVertexColorBJ(udg_RSkillDei, 100, 100, 100, 75.00)
        if ( Trig_Loop_______u_Func002Func022C() ) then
            set udg_RSkillDei_______u=0
            call SetUnitAnimationByIndex(udg_RSkillDei, 5)
            call SetUnitTimeScale(udg_RSkillDei, 1.5)
        else
            set udg_RSkillDei_______u=( udg_RSkillDei_______u + 1 )
        endif
        call StartTimerBJ(udg_Aaa[43], false, 0.03)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call SetUnitPathing(udg_RSkillDei, true)
        call DisableTrigger(gg_trg_Loop1_______u)
        call ResetUnitAnimation(udg_RSkillDei)
        call SetUnitVertexColorBJ(udg_RSkillDei, 100, 100, 100, 0.00)
        call RemoveLocation(udg_RSkillDei2)
    endif
    call RemoveLocation(udg_RSkillDei2_c)
endfunction

