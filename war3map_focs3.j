    call IssueImmediateOrderBJ(udg_MadaraR[5], "stomp")
    call TriggerSleepAction(0.50)
    call IssueImmediateOrderBJ(udg_MadaraR[6], "stomp")
    call RemoveLocation(udg_MadaraRL[0])
    call RemoveLocation(udg_MadaraRL[1])
    call RemoveLocation(udg_MadaraRL[2])
    call RemoveLocation(udg_MadaraRL[3])
    call RemoveLocation(udg_MadaraRL[4])
    call RemoveLocation(udg_MadaraRL[5])
    call EnableTrigger(GetTriggeringTrigger())
endfunction

