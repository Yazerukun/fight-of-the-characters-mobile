//===========================================================================
// Trigger: baQ
//===========================================================================
function Trig_baQ_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I00V' ) ) then
        return false
    endif
    return true
endfunction

function Trig_baQ_Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B00V') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_baQ_Func007001003 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'n00P' )
endfunction

function Trig_baQ_Func007Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(GetLastCreatedUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_baQ_Func007A takes nothing returns nothing
    if ( Trig_baQ_Func007Func001C() ) then
        call ShowUnitHide(GetEnumUnit())
        call KillUnit(GetEnumUnit())
    else
    endif
endfunction

function Trig_baQ_Actions takes nothing returns nothing
    set udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]=GetTriggerUnit()
    if ( Trig_baQ_Func002C() ) then
        call PauseUnitBJ(true, GetTriggerUnit())
    else
    endif
    call ShowUnitHide(GetTriggerUnit())
    call CreateNUnitsAtLoc(1, 'n00P', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
    call UnitApplyTimedLife(GetLastCreatedUnit(), 'BOmi', 3)
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRangeOfLocMatching(250.00, GetUnitLoc(GetLastCreatedUnit()), Condition(function Trig_baQ_Func007001003)), function Trig_baQ_Func007A)
    call AddSpecialEffectLocBJ(GetUnitLoc(GetLastCreatedUnit()), "Abilities\\Spells\\Human\\Polymorph\\PolyMorphTarget.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
endfunction

//===========================================================================
function InitTrig_baQ takes nothing returns nothing
    set gg_trg_baQ=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_baQ, EVENT_PLAYER_UNIT_USE_ITEM)
    call TriggerAddCondition(gg_trg_baQ, Condition(function Trig_baQ_Conditions))
    call TriggerAddAction(gg_trg_baQ, function Trig_baQ_Actions)
endfunction

//===========================================================================
// Trigger: baQ 복사
//===========================================================================
function Trig_baQ_______u_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) == 'n00P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_baQ_______u_Actions takes nothing returns nothing
    call ShowUnitShow(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetAttackedUnitBJ()))])
    call PauseUnitBJ(false, udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetAttackedUnitBJ()))])
    call SetUnitPositionLoc(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetAttackedUnitBJ()))], GetUnitLoc(GetAttacker()))
    call CreateNUnitsAtLoc(1, 'h00Y', GetOwningPlayer(GetAttackedUnitBJ()), GetUnitLoc(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetAttackedUnitBJ()))]), bj_UNIT_FACING)
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "stomp")
    call AddSpecialEffectLocBJ(GetUnitLoc(udg_units01copy[GetConvertedPlayerId(GetOwningPlayer(GetAttackedUnitBJ()))]), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveUnit(GetAttackedUnitBJ())
endfunction

//===========================================================================
function InitTrig_baQ_______u takes nothing returns nothing
    set gg_trg_baQ_______u=CreateTrigger()
    call DisableTrigger(gg_trg_baQ_______u)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_baQ_______u, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_baQ_______u, Condition(function Trig_baQ_______u_Conditions))
    call TriggerAddAction(gg_trg_baQ_______u, function Trig_baQ_______u_Actions)
