function Trig_MadaraW_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call vibration(ConvertedPlayer(GetForLoopIndexA()) , 3.00 , 0.40)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call PlaySoundBJ(gg_snd_MadaraW)
    set udg_MadaraC=GetTriggerUnit()
    set udg_MadaraWL1=GetUnitLoc(udg_MadaraC)
    set udg_MadaraWL2=GetUnitLoc(GetSpellTargetUnit())
    set udg_MadaraWR=AngleBetweenPoints(udg_MadaraWL1, udg_MadaraWL2)
    call CreateNUnitsAtLoc(1, 'e0AH', GetOwningPlayer(udg_MadaraC), udg_MadaraWL1, udg_MadaraWR)
    set udg_MadaraW=GetLastCreatedUnit()
    call SetUnitVertexColorBJ(udg_MadaraW, 100, 100, 100, 50.00)
    if ( Trig_MadaraW_Func010C() ) then
        call IssuePointOrderLocBJ(udg_MadaraW, "breathoffire", PolarProjectionBJ(udg_MadaraWL1, 5.00, udg_MadaraWR))
        call RemoveLocation(udg_MadaraWL1)
        call RemoveLocation(udg_MadaraWL2)
    else
        if ( Trig_MadaraW_Func010Func001C() ) then
            call IncUnitAbilityLevelSwapped('A0QL', udg_MadaraW)
            call IssuePointOrderLocBJ(udg_MadaraW, "breathoffire", PolarProjectionBJ(udg_MadaraWL1, 5.00, udg_MadaraWR))
            call RemoveLocation(udg_MadaraWL1)
            call RemoveLocation(udg_MadaraWL2)
        else
            if ( Trig_MadaraW_Func010Func001Func001C() ) then
