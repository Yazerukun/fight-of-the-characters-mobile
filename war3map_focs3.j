        return false
    endif
    return true
endfunction

function Trig_saiq2_Func008Func001C takes nothing returns boolean
    if ( not ( udg_SaiQ == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_saiq2_Func008C takes nothing returns boolean
    if ( not ( udg_SaiQ == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_saiq2_Actions takes nothing returns nothing
    set udg_SaiQL=GetUnitLoc(GetSpellAbilityUnit())
    call AddSpecialEffectLocBJ(udg_SaiQL, "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_SaiQL)
    call AddSpecialEffectTargetUnitBJ("origin", GetSpellTargetUnit(), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    set udg_SaiQ=GetRandomInt(1, 4)
    if ( Trig_saiq2_Func008C() ) then
        call SetUnitX(GetSpellAbilityUnit(), ( GetUnitX(GetSpellTargetUnit()) + 80.00 ))
        call SetUnitY(GetSpellAbilityUnit(), ( GetUnitY(GetSpellTargetUnit()) + 80.00 ))
    else
        if ( Trig_saiq2_Func008Func001C() ) then
            call SetUnitX(GetSpellAbilityUnit(), ( GetUnitX(GetSpellTargetUnit()) - 80.00 ))
            call SetUnitY(GetSpellAbilityUnit(), ( GetUnitY(GetSpellTargetUnit()) + 80.00 ))
        else
            if ( Trig_saiq2_Func008Func001Func001C() ) then
                call SetUnitX(GetSpellAbilityUnit(), ( GetUnitX(GetSpellTargetUnit()) - 80.00 ))
                call SetUnitY(GetSpellAbilityUnit(), ( GetUnitY(GetSpellTargetUnit()) - 80.00 ))
            else
                call SetUnitX(GetSpellAbilityUnit(), ( GetUnitX(GetSpellTargetUnit()) + 80.00 ))
                call SetUnitY(GetSpellAbilityUnit(), ( GetUnitY(GetSpellTargetUnit()) - 80.00 ))
            endif
        endif
    endif
    call IssueTargetOrderBJ(GetTriggerUnit(), "attack", GetSpellTargetUnit())
    call TriggerSleepAction(0.10)
    call IssueTargetOrderBJ(GetTriggerUnit(), "attack", GetSpellTargetUnit())
endfunction

