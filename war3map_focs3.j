function jJ takes nothing returns nothing
 local integer pickedItemId
 local itemtype JJ
 local integer kJ=0
 local integer KJ=0
 local integer HJ
	set HJ=1
	loop
		if ( bj_stockAllowedPermanent[HJ] ) then
			set KJ=KJ + 1
			if ( GetRandomInt(1, KJ) == 1 ) then
				set JJ=ITEM_TYPE_PERMANENT
				set kJ=HJ
			endif
		endif
		if ( bj_stockAllowedCharged[HJ] ) then
			set KJ=KJ + 1
			if ( GetRandomInt(1, KJ) == 1 ) then
				set JJ=ITEM_TYPE_CHARGED
				set kJ=HJ
			endif
		endif
		if ( bj_stockAllowedArtifact[HJ] ) then
			set KJ=KJ + 1
			if ( GetRandomInt(1, KJ) == 1 ) then
				set JJ=ITEM_TYPE_ARTIFACT
				set kJ=HJ
			endif
		endif
		set HJ=HJ + 1
		exitwhen HJ > 10
	endloop
	if ( KJ == 0 ) then
		set JJ=null
		return
	endif
	call GJ(JJ , kJ)
	set JJ=null
endfunction

