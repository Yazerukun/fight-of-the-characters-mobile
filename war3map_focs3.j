        call SetUnitScalePercent(udg_brouto[90], udg_broutoreal[3], udg_broutoreal[3], udg_broutoreal[3])
    else
    endif
    if ( Trig_brouto_R_1_Func010C() ) then
        call StartTimerBJ(udg_broutotimer[2], false, 0.02)
    else
    endif
    if ( Trig_brouto_R_1_Func011C() ) then
        call EnableTrigger(gg_trg_brouto_R2)
    else
    endif
    if ( Trig_brouto_R_1_Func012C() ) then
        set udg_broutoloc[97]=GetUnitLoc(udg_brouto[90])
        call CreateNUnitsAtLoc(1, 'h02V', GetOwningPlayer(udg_brouto[4]), udg_broutoloc[97], bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(2.00, 'BHwe', GetLastCreatedUnit())
        call RemoveLocation(udg_broutoloc[97])
        call ForGroupBJ(GetUnitsInRangeOfLocMatching(500.00, udg_broutoloc[97], Condition(function Trig_brouto_R_1_Func012Func005001003)), function Trig_brouto_R_1_Func012Func005A)
        call RemoveUnit(udg_brouto[90])
        call DisableTrigger(gg_trg_brouto_R2)
    else
    endif
endfunction

