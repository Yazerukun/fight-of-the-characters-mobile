//===========================================================================
// Trigger: pungdun1
//===========================================================================
function Trig_pungdun1_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_pungdun1_Func009C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O00F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_pungdun1_Actions takes nothing returns nothing
    call PlaySoundBJ(gg_snd_NarutoR)
    set udg_NarutoC=GetTriggerUnit()
    set udg_NarutoC2=GetUnitLoc(udg_NarutoC)
    set udg_NarutoLcation=GetSpellTargetLoc()
    set udg_NarutoAngle2=AngleBetweenPoints(GetUnitLoc(udg_NarutoC), GetSpellTargetLoc())
    set udg_NarutoReal=750.00
    call SetUnitInvulnerable(udg_NarutoC, true)
    call ShowUnitHide(udg_NarutoC)
    if ( Trig_pungdun1_Func009C() ) then
        call CreateNUnitsAtLoc(1, 'o00H', GetOwningPlayer(udg_NarutoC), udg_NarutoLcation, udg_NarutoAngle2)
        set udg_NarutoCc=GetLastCreatedUnit()
        call AddSpecialEffectTargetUnitBJ("hand right", udg_NarutoCc, "fdlxw jhxcom_2001.mdx")
        set udg_NarutoEffect2=GetLastCreatedEffectBJ()
        call SetUnitAnimation(udg_NarutoCc, "Spell one")
        call SetUnitTimeScalePercent(udg_NarutoCc, 60.00)
    else
        call CreateNUnitsAtLoc(1, 'o00G', GetOwningPlayer(udg_NarutoC), udg_NarutoLcation, udg_NarutoAngle2)
        set udg_NarutoCc=GetLastCreatedUnit()
        call AddSpecialEffectTargetUnitBJ("hand right", udg_NarutoCc, "fdlxw jhxcom_2001.mdx")
        set udg_NarutoEffect2=GetLastCreatedEffectBJ()
        call SetUnitAnimation(udg_NarutoCc, "Spell two")
        call SetUnitTimeScalePercent(udg_NarutoCc, 60.00)
    endif
    call EnableTrigger(gg_trg_pungdun2)
    call StartTimerBJ(udg_Aaa[9], false, 0.02)
endfunction

//===========================================================================
function InitTrig_pungdun1 takes nothing returns nothing
    set gg_trg_pungdun1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_pungdun1, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_pungdun1, Condition(function Trig_pungdun1_Conditions))
    call TriggerAddAction(gg_trg_pungdun1, function Trig_pungdun1_Actions)
endfunction

//===========================================================================
// Trigger: pungdun2
//===========================================================================
function Trig_pungdun2_Func002Func009Func001C takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetEnumUnit()), GetOwningPlayer(udg_NarutoC)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_pungdun2_Func002Func009A takes nothing returns nothing
    if ( Trig_pungdun2_Func002Func009Func001C() ) then
        call UnitDamageTargetBJ(udg_NarutoC, GetEnumUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_NarutoC, true)) / 2.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_FIRE)
    else
    endif
endfunction

function Trig_pungdun2_Func002C takes nothing returns boolean
    if ( not ( udg_NarutoReal > 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_pungdun2_Actions takes nothing returns nothing
    if ( Trig_pungdun2_Func002C() ) then
        set udg_NarutoReal=( udg_NarutoReal - 13.00 )
        call SetUnitFlyHeightBJ(udg_NarutoCc, udg_NarutoReal, 0.00)
        call StartTimerBJ(udg_Aaa[9], false, 0.02)
    else
        call DisableTrigger(GetTriggeringTrigger())
        call DestroyEffectBJ(udg_NarutoEffect2)
        call RemoveUnit(udg_NarutoCc)
        call ShowUnitShow(udg_NarutoC)
        call SetUnitInvulnerable(udg_NarutoC, false)
        call SetUnitPositionLoc(udg_NarutoC, udg_NarutoLcation)
        call SelectUnitForPlayerSingle(udg_NarutoC, GetOwningPlayer(udg_NarutoC))
        set bj_wantDestroyGroup=true
        call ForGroupBJ(GetUnitsInRangeOfLocAll(350.00, udg_NarutoLcation), function Trig_pungdun2_Func002Func009A)
        call CreateNUnitsAtLoc(1, 'e062', GetOwningPlayer(udg_NarutoC), udg_NarutoLcation, bj_UNIT_FACING)
        call SetUnitAnimation(GetLastCreatedUnit(), "death")
        call SetUnitTimeScalePercent(GetLastCreatedUnit(), 50.00)
        call CreateNUnitsAtLoc(1, 'e062', GetOwningPlayer(udg_NarutoC), udg_NarutoLcation, bj_UNIT_FACING)
        call SetUnitAnimation(GetLastCreatedUnit(), "death")
        call SetUnitTimeScalePercent(GetLastCreatedUnit(), 62.50)
        call CreateNUnitsAtLoc(1, 'e062', GetOwningPlayer(udg_NarutoC), udg_NarutoLcation, bj_UNIT_FACING)
        call SetUnitAnimation(GetLastCreatedUnit(), "death")
        call SetUnitTimeScalePercent(GetLastCreatedUnit(), 75.00)
        set udg_NarutoC=null
        call RemoveLocation(udg_NarutoLcation)
        call RemoveLocation(udg_NarutoC2)
    endif
endfunction

