function Trig_ice________2_Actions takes nothing returns nothing
    call PlaySoundBJ(udg_sound54)
    call SetUnitPositionLoc(udg_iceUnitC, udg_iceUnit2C)
    if ( Trig_ice________2_Func003C() ) then
        call CreateNUnitsAtLoc(1, 'n00J', GetOwningPlayer(udg_iceUnitC), udg_iceUnit2C, GetRandomReal(0, 360.00))
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "dreadlordinferno", udg_iceUnit2C)
        call SetUnitAnimation(GetLastCreatedUnit(), "birth")
    else
        if ( Trig_ice________2_Func003Func004C() ) then
            call CreateNUnitsAtLoc(1, 'n00J', GetOwningPlayer(udg_iceUnitC), udg_iceUnit2C, GetRandomReal(0, 360.00))
            call IncUnitAbilityLevelSwapped('A0GB', GetLastCreatedUnit())
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "dreadlordinferno", udg_iceUnit2C)
            call SetUnitAnimation(GetLastCreatedUnit(), "birth")
        else
            if ( Trig_ice________2_Func003Func004Func006C() ) then
                call CreateNUnitsAtLoc(1, 'n00J', GetOwningPlayer(udg_iceUnitC), udg_iceUnit2C, GetRandomReal(0, 360.00))
                call IncUnitAbilityLevelSwapped('A0GB', GetLastCreatedUnit())
