    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call MultiboardSetItemIconBJ(GetLastCreatedMultiboard(), 4, GetForLoopIndexA(), "ReplaceableTextures\\CommandButtons\\BTNSpy.blp")
